Subject: [PATCH] hw/usb: preserve chipidea packet boundaries

diff --git a/hw/usb/cihdrc-udc.c b/hw/usb/cihdrc-udc.c
--- a/hw/usb/cihdrc-udc.c
+++ b/hw/usb/cihdrc-udc.c
@@ -277,8 +277,9 @@
             REG(s, EPSTAT) &= ~bit;
             break;
         }
-        /* IOC delimits a request; a short packet must not eat the next one. */
-        if ((draining || in) && (token & TD_IOC)) {
+        /* no_interrupt requests still terminate with a short IN packet. */
+        if ((in && (!count || (maxpacket && count % maxpacket))) ||
+            ((draining || in) && (token & TD_IOC))) {
             break;
         }
         if (!draining && done == length) {
@@ -384,6 +385,10 @@
         token = ci_dma_read32((s->td[slot] & TD_ADDR) + 4);
         if ((token & (TD_ACTIVE | TD_HALTED)) == TD_ACTIVE &&
             (length || !(token & TD_BYTES))) {
+            unsigned maxpacket =
+                (ci_dma_read32(ci_qh(s, slot)) >> 16) & 0x7ff;
+
+            length = MIN(length, maxpacket ? maxpacket : 64);
             done = ci_transfer(s, ep, in, data, length);
             token = ci_dma_read32(ci_qh(s, slot) + 12);
             status = (token & TD_HALTED) ? "ERROR" : "ACK";

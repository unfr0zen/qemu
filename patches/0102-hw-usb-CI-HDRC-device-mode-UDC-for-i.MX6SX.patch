+#define TYPE_FLINTSTONE_MACHINE MACHINE_TYPE_NAME("flintstone")
+OBJECT_DECLARE_SIMPLE_TYPE(FlintstoneMachineState, FLINTSTONE_MACHINE)
+
+struct FlintstoneMachineState {
+    MachineState parent_obj;
+    char *usb0_hostchar;
+};
+
+static char *flintstone_get_usb0_hostchar(Object *obj, Error **errp)
+{
+    return g_strdup(FLINTSTONE_MACHINE(obj)->usb0_hostchar);

+
+#define TYPE_FSL_IMX6SX "fsl-imx6sx"
+typedef struct FslIMX6SXState FslIMX6SXState;
+DECLARE_INSTANCE_CHECKER(FslIMX6SXState, FSL_IMX6SX, TYPE_FSL_IMX6SX)
+
+#define FSL_IMX6SX_NUM_CPUS     1
+#define FSL_IMX6SX_NUM_UARTS    6
+#define FSL_IMX6SX_NUM_EPITS    2
+#define FSL_IMX6SX_NUM_I2CS     4
+#define FSL_IMX6SX_NUM_ECSPIS   4
+#define FSL_IMX6SX_NUM_GPIOS    7
+#define FSL_IMX6SX_NUM_USDHCS   4
+#define FSL_IMX6SX_NUM_USBS     3
+#define FSL_IMX6SX_NUM_USB_PHYS 2
+#define FSL_IMX6SX_NUM_ETHS     2
+#define FSL_IMX6SX_NUM_WDTS     3
+/* Highest GIC SPI used on the 6SX (FEC1 1588 = 119); keep room to spare. */
+#define FSL_IMX6SX_MAX_IRQ      128
+
+/* Cortex A9 MPCore (identical to i.MX6Q) */
+#define FSL_IMX6SX_A9MPCORE_ADDR    0x00A00000
+#define FSL_IMX6SX_A9MPCORE_SIZE    0x2000
+#define FSL_IMX6SX_PL310_ADDR       0x00A02000
+#define FSL_IMX6SX_PL310_SIZE       0x1000
+
+/* Internal memories */
+#define FSL_IMX6SX_ROM_ADDR         0x00000000
+#define FSL_IMX6SX_ROM_SIZE         0x18000
+#define FSL_IMX6SX_CAAM_MEM_ADDR    0x00100000
+#define FSL_IMX6SX_CAAM_MEM_SIZE    0x8000
+#define FSL_IMX6SX_LPM_SRAM_ADDR    0x008F8000
+#define FSL_IMX6SX_LPM_SRAM_SIZE    0x4000
+#define FSL_IMX6SX_OCRAM_ADDR       0x00900000
+#define FSL_IMX6SX_OCRAM_SIZE       0x20000    /* 128 KiB mega-fast SRAM */
+
+/* Vivante GC400T GPU3D */
+#define FSL_IMX6SX_GPU_ADDR         0x01800000
+#define FSL_IMX6SX_GPU_IRQ          10
+
+/* GPMI NAND subsystem on its own bus segment (modeled in a later phase) */
+#define FSL_IMX6SX_APBH_ADDR        0x01804000
+#define FSL_IMX6SX_APBH_SIZE        0x2000
+#define FSL_IMX6SX_GPMI_ADDR        0x01806000
+#define FSL_IMX6SX_GPMI_SIZE        0x2000
+#define FSL_IMX6SX_BCH_ADDR         0x01808000
+#define FSL_IMX6SX_BCH_SIZE         0x4000
+#define FSL_IMX6SX_APBH_IRQ         13
+#define FSL_IMX6SX_BCH_IRQ          15
+
+/* AIPS1 / SPBA1 */
+#define FSL_IMX6SX_UART1_ADDR       0x02020000

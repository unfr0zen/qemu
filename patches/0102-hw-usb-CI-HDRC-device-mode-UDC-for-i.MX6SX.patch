+#define FSL_IMX6SX_PWM1_ADDR        0x02080000
+#define FSL_IMX6SX_PWM2_ADDR        0x02084000
+#define FSL_IMX6SX_PWM3_ADDR        0x02088000
+#define FSL_IMX6SX_PWM4_ADDR        0x0208C000
+#define FSL_IMX6SX_NUM_PWMS         4           /* PWM1-4; 5-8 unmodelled */

+/*
+ * Boot ROM stub: on the real board the i.MX6SX boot ROM loads the NAND
+ * firmware image into DRAM per its IVT and jumps to the entry point. The
+ * image sits at NAND mtd0 fw1 with its IVT 0x400 in; the IVT's boot data
+ * gives the load address and size (the stock image: 0x877ff000, 0x61000,
+ * entry 0x87800000 — see qemu/SPEC.md; a system update writes its own).
+ */
+#define FLINTSTONE_FW_NAND_OFF  0x100000
+#define FLINTSTONE_FW_IVT_OFF   0x400
+#define FLINTSTONE_IVT_TAG      0xd1
+#define FLINTSTONE_FW_ENTRY     0x87800000   /* where -bios images start */
+
+struct FlintstoneRomBoot {
+    BlockBackend *blk;
+    const char *bios;   /* -bios: a RAM U-Boot to start instead of fw1 */
+};
+
+/* DCD: a header (tag, big-endian length, version), then commands, each
+ * tag, length, parameter: WRITE's parameter is the access width (1, 2, 4)
+ * plus flags - mask: clear the value's bits, mask|set: set them, neither:
+ * write it; its body is address/value pairs. CHECK polls until an address
+ * has a mask's bits clear or set (flags as WRITE), NOP does nothing. */
+#define DCD_TAG                 0xd2
+#define DCD_CMD_WRITE           0xcc
+#define DCD_CMD_CHECK           0xcf
+#define DCD_CMD_NOP             0xc0
+#define DCD_FLAG_MASK           0x08
+#define DCD_FLAG_SET            0x10
+#define DCD_MAX_LEN             1768    /* the i.MX6 ROM's limit */
+
+static uint32_t flintstone_dcd_load(hwaddr addr, unsigned width)
+{
+    AddressSpace *as = &address_space_memory;
+
+    switch (width) {
+    case 1:
+        return address_space_ldub(as, addr, MEMTXATTRS_UNSPECIFIED, NULL);
+    case 2:
+        return address_space_lduw_le(as, addr, MEMTXATTRS_UNSPECIFIED, NULL);
+    default:
+        return address_space_ldl_le(as, addr, MEMTXATTRS_UNSPECIFIED, NULL);
+    }
+}
+
+static void flintstone_dcd_store(hwaddr addr, unsigned width, uint32_t val)
+{
+    AddressSpace *as = &address_space_memory;
+
+    switch (width) {
+    case 1:
+        address_space_stb(as, addr, val, MEMTXATTRS_UNSPECIFIED, NULL);
+        break;
+    case 2:
+        address_space_stw_le(as, addr, val, MEMTXATTRS_UNSPECIFIED, NULL);
+        break;
+    default:
+        address_space_stl_le(as, addr, val, MEMTXATTRS_UNSPECIFIED, NULL);
+    }
+}
+
+static void flintstone_apply_dcd(const uint8_t *dcd, uint32_t len)
+{
+    uint32_t p = 4;
+
+    while (p + 4 <= len) {
+        uint8_t tag = dcd[p], par = dcd[p + 3];
+        uint32_t clen = lduw_be_p(dcd + p + 1), q;
+        unsigned width = par & 7;
+        bool mask = par & DCD_FLAG_MASK, set = par & DCD_FLAG_SET;
+
+        if (clen < 4 || clen > len - p) {
+            error_report("flintstone: DCD command at +%u is cut short", p);
+            return;
+        }
+        switch (tag) {
+        case DCD_CMD_WRITE:
+            for (q = p + 4; q + 8 <= p + clen; q += 8) {
+                hwaddr addr = ldl_be_p(dcd + q);
+                uint32_t val = ldl_be_p(dcd + q + 4);
+
+                if (mask) {
+                    uint32_t cur = flintstone_dcd_load(addr, width);
+                    val = set ? cur | val : cur & ~val;
+                }
+                flintstone_dcd_store(addr, width, val);
+            }
+            break;
+        case DCD_CMD_CHECK:
+            /* The ROM polls; the models settle at once, so one look. */
+            if (clen >= 12) {
+                hwaddr addr = ldl_be_p(dcd + p + 4);
+                uint32_t m = ldl_be_p(dcd + p + 8);
+                uint32_t cur = flintstone_dcd_load(addr, width) & m;
+
+                if (set ? cur != m : cur != 0) {
+                    qemu_log_mask(LOG_UNIMP, "flintstone: DCD check of "
+                                  "0x%" HWADDR_PRIx " not met\n", addr);
+                }
+            }
+            break;
+        case DCD_CMD_NOP:
+            break;
+        default:
+            qemu_log_mask(LOG_UNIMP, "flintstone: DCD command 0x%02x "
+                          "ignored, the rest skipped\n", tag);
+            return;
+        }
+        p += clen;
+    }
+}
+
+/*
+ * fw1's IVT (entry, dcd, boot_data, self, as addresses in the image) and
+ * boot data (start: the image's load address, size); false if there is
+ * none.
+ */
+static bool flintstone_read_ivt(BlockBackend *blk, uint32_t ivt[8],
+                                uint32_t boot_data[2])
+{
+    int i;
+
+    if (blk_pread(blk, FLINTSTONE_FW_NAND_OFF + FLINTSTONE_FW_IVT_OFF,
+                  8 * sizeof(uint32_t), ivt, 0) < 0) {
+        return false;
+    }
+    for (i = 0; i < 8; i++) {
+        ivt[i] = le32_to_cpu(ivt[i]);
+    }
+    if ((ivt[0] & 0xff) != FLINTSTONE_IVT_TAG ||
+        blk_pread(blk, FLINTSTONE_FW_NAND_OFF + FLINTSTONE_FW_IVT_OFF +
+                  (ivt[4] - ivt[5]), 2 * sizeof(uint32_t), boot_data, 0) < 0) {
+        return false;
+    }
+    boot_data[0] = le32_to_cpu(boot_data[0]);
+    boot_data[1] = le32_to_cpu(boot_data[1]);
+    return true;
+}
+
+/* Apply fw1's DCD, as the ROM does before it loads the image into DDR. */
+static void flintstone_fw_dcd(BlockBackend *blk, const uint32_t ivt[8])
+{
+    uint64_t off = FLINTSTONE_FW_NAND_OFF + FLINTSTONE_FW_IVT_OFF +
+                   (ivt[3] - ivt[5]);
+    g_autofree uint8_t *dcd = NULL;
+    uint8_t hdr[4];
+    uint32_t len;
+
+    if (!ivt[3]) {
+        return;                         /* no DCD */
+    }
+    if (blk_pread(blk, off, sizeof(hdr), hdr, 0) < 0 || hdr[0] != DCD_TAG) {
+        error_report("flintstone: the NAND firmware's DCD is missing");
+        return;
+    }
+    len = lduw_be_p(hdr + 1);
+    if (len < sizeof(hdr) || len > DCD_MAX_LEN) {
+        error_report("flintstone: the NAND firmware's DCD is %u bytes", len);
+        return;
+    }
+    dcd = g_malloc(len);
+    if (blk_pread(blk, off, len, dcd, 0) < 0) {
+        error_report("flintstone: ROM could not read the DCD");
+        return;
+    }
+    flintstone_apply_dcd(dcd, len);
+}
+
+static void flintstone_rom_boot(void *opaque)
+{
+    struct FlintstoneRomBoot *rom = opaque;
+    g_autofree uint8_t *buf = NULL;
+    uint32_t ivt[8], boot_data[2], start, size;
+    bool have_ivt = flintstone_read_ivt(rom->blk, ivt, boot_data);
+
+    /* Nothing else resets the CPU (no arm_load_kernel), so a watchdog
+     * reboot would otherwise resume with the MMU and caches still on. */
+    cpu_reset(first_cpu);
+
+    if (rom->bios) {
+        /* A raw U-Boot image linked at the entry point (the repo's
+         * build/u-boot-recovery.bin), as SPL would leave it in DDR, with
+         * the clocks, pads and DDR set up the way SPL does it: by
+         * replaying the unit's own DCD. Read at every reset, so a rebuilt
+         * file boots on the next reboot. */
+        g_autofree char *img = NULL;
+        gsize len;
+
+        if (!g_file_get_contents(rom->bios, &img, &len, NULL) ||
+            len > FLINTSTONE_RAM_ADDR + FLINTSTONE_RAM_SIZE - FLINTSTONE_FW_ENTRY) {
+            error_report("flintstone: cannot load -bios %s", rom->bios);
+            exit(1);
+        }
+        if (have_ivt) {
+            flintstone_fw_dcd(rom->blk, ivt);
+        }
+        cpu_physical_memory_write(FLINTSTONE_FW_ENTRY, img, len);
+        cpu_set_pc(first_cpu, FLINTSTONE_FW_ENTRY);
+        return;
+    }
+
+    if (!have_ivt) {
+        error_report("flintstone: ROM found no IVT in the NAND firmware");
+        exit(1);
+    }
+    start = boot_data[0];
+    size = boot_data[1];
+    if (start < FLINTSTONE_RAM_ADDR ||
+        size > FLINTSTONE_RAM_ADDR + FLINTSTONE_RAM_SIZE - start) {
+        error_report("flintstone: NAND firmware loads outside DRAM "
+                     "(0x%" PRIx32 " + 0x%" PRIx32 ")", start, size);
+        exit(1);
+    }
+    flintstone_fw_dcd(rom->blk, ivt);
+    buf = g_malloc(size);
+    if (blk_pread(rom->blk, FLINTSTONE_FW_NAND_OFF, size, buf, 0) < 0) {
+        error_report("flintstone: ROM could not read NAND firmware");
+        exit(1);
+    }
+    cpu_physical_memory_write(start, buf, size);
+    cpu_set_pc(first_cpu, ivt[1]);
+}
+
+/* /machine/wheel-position: the adc's signed detent count, either way round. */
+static void flintstone_get_wheel(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    visit_type_int64(v, name, opaque, errp);
+}
+
+static void flintstone_set_wheel(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    visit_type_int64(v, name, opaque, errp);
+}
+
+/*
+ * The wifi module on usdhc2: a BCM43341 behind an SDIO card. WL_REG_ON is
+ * GPIO1_IO04, which powers both and is reported to the board; the chip's
+ * out-of-band interrupt is GPIO5_IO15, level high (the DT's brcm-wlan).
+ * -nic user,model=bcm43341 is the network behind the access point.
+ */
+static void flintstone_init_wifi(DeviceState *soc, DeviceState *board)
+{
+    DeviceState *usdhc2 = DEVICE(object_resolve_path_component(OBJECT(soc),
+                                                                "sdhc2"));
+    DeviceState *gpio1 = DEVICE(object_resolve_path_component(OBJECT(soc),
+                                                               "gpio1"));
+    DeviceState *gpio5 = DEVICE(object_resolve_path_component(OBJECT(soc),
+                                                               "gpio5"));
+    DeviceState *card = qdev_new(TYPE_SDIO_CARD);
+    DeviceState *chip = qdev_new(TYPE_BCM43341);
+    DeviceState *reg_on = qdev_new(TYPE_SPLIT_IRQ);
+
+    qemu_configure_nic_device(chip, true, NULL);
+    qdev_realize_and_unref(chip, NULL, &error_fatal);
+
+    /* Broadcom's IDs, and no standard class: the driver matches either. */
+    qdev_prop_set_uint8(card, "class", 0);
+    qdev_prop_set_uint16(card, "vendor-id", 0x02d0);
+    qdev_prop_set_uint16(card, "device-id", 0xa94d);
+    qdev_prop_set_uint16(card, "device-id-f2", 0xa94d);
+    object_property_set_link(OBJECT(card), "function-device", OBJECT(chip),
+                             &error_fatal);
+    qdev_realize_and_unref(card, qdev_get_child_bus(usdhc2, "sd-bus"),
+                           &error_fatal);
+
+    qdev_prop_set_uint32(reg_on, "num-lines", 3);
+    qdev_realize_and_unref(reg_on, NULL, &error_fatal);
+    qdev_connect_gpio_out(gpio1, 4, qdev_get_gpio_in(reg_on, 0));
+    qdev_connect_gpio_out(reg_on, 0,
+                          qdev_get_gpio_in(board,
+                                           FLINTSTONE_BOARD_IN_WIFI_RESET));
+    qdev_connect_gpio_out(reg_on, 1,
+                          qdev_get_gpio_in_named(card, "power", 0));
+    qdev_connect_gpio_out(reg_on, 2,
+                          qdev_get_gpio_in_named(chip, "power", 0));
+
+    qdev_connect_gpio_out_named(chip, "card-int", 0,
+                                qdev_get_gpio_in_named(card, "card-int", 0));
+    qdev_connect_gpio_out_named(chip, "host-wake", 0,
+                                qdev_get_gpio_in(gpio5, 15));
+}
+
+/*
+ * The EM357 radio (fdt@4 "spidev_em35x" and "em35x-gpios"): on ECSPI3 with
+ * its chip select on GPIO4_IO30, nRESET on GPIO2_IO00, nWAKE on
+ * GPIO2_IO05, and nHOST_INT into GPIO2_IO04.
+ */
+static void flintstone_init_ncp(DeviceState *soc)
+{
+    DeviceState *spi3 = DEVICE(object_resolve_path_component(OBJECT(soc),
+                                                              "spi3"));
+    DeviceState *gpio2 = DEVICE(object_resolve_path_component(OBJECT(soc),
+                                                               "gpio2"));
+    DeviceState *gpio4 = DEVICE(object_resolve_path_component(OBJECT(soc),
+                                                               "gpio4"));
+    DeviceState *ncp = qdev_new(TYPE_EM35X_NCP);
+
+    qdev_realize_and_unref(ncp, qdev_get_child_bus(spi3, "spi"), &error_fatal);
+    qdev_connect_gpio_out(gpio4, 30,
+                          qdev_get_gpio_in_named(ncp, EM35X_NCP_NSSEL, 0));
+    qdev_connect_gpio_out(gpio2, 0,
+                          qdev_get_gpio_in_named(ncp, EM35X_NCP_NRESET, 0));
+    qdev_connect_gpio_out(gpio2, 5,
+                          qdev_get_gpio_in_named(ncp, EM35X_NCP_NWAKE, 0));
+    qdev_connect_gpio_out_named(ncp, EM35X_NCP_NHOST_INT, 0,
+                                qdev_get_gpio_in(gpio2, 4));
+}
+
+static void flintstone_init(MachineState *machine)
+{
+    DeviceState *soc;
+    DeviceState *gpmi;
+    DeviceState *board;
+    DeviceState *gpio6, *gpio7, *adc1, *adc2;
+    BlockBackend *nand;
+
+    if (machine->ram_size != FLINTSTONE_RAM_SIZE) {
+        error_report("flintstone: this board has %lu MiB of DDR3",
+                     (unsigned long)(FLINTSTONE_RAM_SIZE / MiB));
+        exit(1);
+    }
+
+    soc = qdev_new(TYPE_FSL_IMX6SX);
+    if (FLINTSTONE_MACHINE(machine)->usb0_hostchar) {
+        qdev_prop_set_string(soc, "usb0-hostchar",
+                             FLINTSTONE_MACHINE(machine)->usb0_hostchar);
+    }
+    gpmi = DEVICE(object_resolve_path_component(OBJECT(soc), "gpmi"));
+    nand = blk_by_name("nand");
+    if (nand) {
+        struct FlintstoneRomBoot *rom = g_new(struct FlintstoneRomBoot, 1);
+
+        qdev_prop_set_drive_err(gpmi, "drive", nand, &error_fatal);
+        /* The boot ROM runs after CPU reset, so hook it as a reset
+         * handler: it loads the NAND firmware and starts the CPU. */
+        rom->blk = nand;
+        rom->bios = machine->firmware;
+        qemu_register_reset(flintstone_rom_boot, rom);
+    }
+    qdev_realize_and_unref(soc, NULL, &error_fatal);
+
+    memory_region_add_subregion(get_system_memory(), FLINTSTONE_RAM_ADDR,
+                                machine->ram);
+
+    /*
+     * The board around the SoC: the front button drives GPIO2_IO18 (the
+     * gpio-keys "HU Button"), the backplate detect line GPIO5_IO13, and
+     * the firmware's own driven lines are
+     * reported back — poweroff on GPIO1_IO11, the wifi module reset on
+     * GPIO1_IO04, the wheel's Hall power on GPIO7_IO02 and the battery
+     * divider enable on GPIO6_IO16. The chardev is attached with
+     * -global flintstone.board.chardev=... (run.sh --ui); without it the
+     * board is just there, unobserved.
+     */
+    board = qdev_new(TYPE_FLINTSTONE_BOARD);
+    qdev_realize_and_unref(board, NULL, &error_fatal);
+
+    gpio6 = DEVICE(object_resolve_path_component(OBJECT(soc), "gpio6"));
+    gpio7 = DEVICE(object_resolve_path_component(OBJECT(soc), "gpio7"));
+    adc1 = DEVICE(object_resolve_path_component(OBJECT(soc), "adc1"));
+    adc2 = DEVICE(object_resolve_path_component(OBJECT(soc), "adc2"));
+
+    /*
+     * GPIO7_IO02 (the wheel's hall-enable) and GPIO6_IO16 (the battery
+     * divider enable) each feed two listeners: the matching ADC's gate
+     * line, and the board report over the chardev.
+     */
+    DeviceState *hall_split = qdev_new(TYPE_SPLIT_IRQ);
+    DeviceState *vbatt_split = qdev_new(TYPE_SPLIT_IRQ);
+    DeviceState *gpio1;
+
+    qdev_prop_set_uint32(hall_split, "num-lines", 2);
+    qdev_prop_set_uint32(vbatt_split, "num-lines", 2);
+    qdev_realize_and_unref(hall_split, NULL, &error_fatal);
+    qdev_realize_and_unref(vbatt_split, NULL, &error_fatal);
+
+    gpio1 = DEVICE(object_resolve_path_component(OBJECT(soc), "gpio1"));
+
+    qdev_connect_gpio_out(board, 0,
+                          qdev_get_gpio_in(DEVICE(object_resolve_path_component(
+                              OBJECT(soc), "gpio2")), 18));
+    qdev_connect_gpio_out_named(board, FLINTSTONE_BOARD_DETECT, 0,
+                                qdev_get_gpio_in(DEVICE(
+                                    object_resolve_path_component(
+                                        OBJECT(soc), "gpio5")), 13));
+    qdev_connect_gpio_out(gpio1, 11,
+                          qdev_get_gpio_in(board,
+                                           FLINTSTONE_BOARD_IN_POWEROFF));
+    flintstone_init_wifi(soc, board);
+    flintstone_init_ncp(soc);
+    /* The piezo: pwm-beeper on PWM1, its enable on GPIO1_IO05. */
+    qdev_connect_gpio_out_named(DEVICE(&FSL_IMX6SX(soc)->pwm[0]), "tone", 0,
+                                qdev_get_gpio_in_named(board,
+                                                       FLINTSTONE_BOARD_BEEPER,
+                                                       0));
+    qdev_connect_gpio_out(gpio1, 5,
+                          qdev_get_gpio_in(board,
+                                           FLINTSTONE_BOARD_IN_BEEPER_ENABLE));
+    /* The panel backlight driver, i2c2 0x63 (the DT's lm3695@63). */
+    i2c_slave_create_simple(FSL_IMX6SX(soc)->i2c[1].bus, "lm3695", 0x63);
+    qdev_connect_gpio_out(gpio7, 2, qdev_get_gpio_in(hall_split, 0));
+    qdev_connect_gpio_out(hall_split, 0, qdev_get_gpio_in(adc1, 0));
+    qdev_connect_gpio_out(hall_split, 1,
+                          qdev_get_gpio_in(board,
+                                           FLINTSTONE_BOARD_IN_HALL_ENABLE));
+    qdev_connect_gpio_out(gpio6, 16, qdev_get_gpio_in(vbatt_split, 0));
+    qdev_connect_gpio_out(vbatt_split, 0, qdev_get_gpio_in(adc2, 0));
+    qdev_connect_gpio_out(vbatt_split, 1,
+                          qdev_get_gpio_in(board,
+                                           FLINTSTONE_BOARD_IN_VBATT_ENABLE));
+
+    /*
+     * The wheel, as the UI turns it: /machine/wheel-position counts
+     * detents. The property lives on the machine so its QOM path is
+     * stable; the storage is the adc's own, sampled per conversion.
+     */
+    object_property_add(OBJECT(machine), "wheel-position", "int",
+                        flintstone_get_wheel, flintstone_set_wheel, NULL,
+                        &IMX6_ADC(adc1)->wheel_position);
+}
+
+static void flintstone_machine_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    object_class_property_add_str(oc, "usb0-hostchar",
+                                  flintstone_get_usb0_hostchar,
+                                  flintstone_set_usb0_hostchar);
+    mc->desc = "Nest Display-3.4 (i.MX6SX, 'Flintstone')";
+    mc->init = flintstone_init;
+    /* The vendor boot software pokes registers we do not model yet; treat
+     * those accesses as reads-0/writes-ignored instead of data aborts. */
+    mc->ignore_memory_transaction_failures = true;
+    mc->min_cpus = FSL_IMX6SX_NUM_CPUS;
+    mc->max_cpus = FSL_IMX6SX_NUM_CPUS;
+    mc->default_cpus = FSL_IMX6SX_NUM_CPUS;
+    mc->default_ram_size = FLINTSTONE_RAM_SIZE;
+    mc->default_ram_id = "flintstone.ram";
+}
+
+static const TypeInfo flintstone_machine_type = {
+    .name = TYPE_FLINTSTONE_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(FlintstoneMachineState),
+    .instance_finalize = flintstone_machine_finalize,
+    .class_init = flintstone_machine_class_init,
+    .interfaces = arm_machine_interfaces,
+};
+
+static void flintstone_machine_register_types(void)
+{
+    type_register_static(&flintstone_machine_type);
+}
+
+type_init(flintstone_machine_register_types)

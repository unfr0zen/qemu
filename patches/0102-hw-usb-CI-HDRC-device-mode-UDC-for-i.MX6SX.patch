+    { FSL_IMX6SX_QSPI1_ADDR, 0x8000,                "qspi1-2" },
+    { FSL_IMX6SX_QSPI1_MEM_ADDR, FSL_IMX6SX_QSPI1_MEM_SIZE, "qspi1-mem" },
+    { FSL_IMX6SX_QSPI2_MEM_ADDR, FSL_IMX6SX_QSPI2_MEM_SIZE, "qspi2-mem" },
+    { FSL_IMX6SX_QOSC_ADDR,  0x4000,                "qosc" },
+    /* AIPS3 */
+    { FSL_IMX6SX_ECSPI4_ADDR, 0x4000,               "ecspi4" },
+    { FSL_IMX6SX_SEMA4_ADDR, 0x4000,                "sema4" },
+    { FSL_IMX6SX_MU_ADDR,    0x4000,                "mu" },
+    { FSL_IMX6SX_UART6_ADDR + 0x4000, 0x10000,      "pwm5-8" },
+};
+
+static void fsl_imx6sx_init(Object *obj)
+{
+    FslIMX6SXState *s = FSL_IMX6SX(obj);
+    char name[NAME_SIZE];
+    int i;
+
+    object_initialize_child(obj, "a9mpcore", &s->a9mpcore, TYPE_A9MPCORE_PRIV);
+
+    object_initialize_child(obj, "ccm", &s->ccm, TYPE_IMX6_CCM);
+
+    object_initialize_child(obj, "src", &s->src, TYPE_IMX6_SRC);
+
+    object_initialize_child(obj, "snvs", &s->snvs, TYPE_IMX7_SNVS);
+
+    object_initialize_child(obj, "gpmi", &s->gpmi, TYPE_IMX_GPMI_NAND);
+
+    object_initialize_child(obj, "sdma", &s->sdma, TYPE_IMX6_SDMA);
+    for (i = 0; i < FSL_IMX6SX_NUM_PWMS; i++) {
+        snprintf(name, NAME_SIZE, "pwm%d", i + 1);
+        object_initialize_child(obj, name, &s->pwm[i], TYPE_IMX_PWM);
+    }
+    object_initialize_child(obj, "mmdc", &s->mmdc, TYPE_IMX6_MMDC);
+    object_initialize_child(obj, "lcdif", &s->lcdif, TYPE_IMX_LCDIF);
+    for (i = 0; i < FSL_IMX6SX_NUM_ADCS; i++) {
+        snprintf(name, NAME_SIZE, "adc%d", i + 1);
+        object_initialize_child(obj, name, &s->adc[i], TYPE_IMX6_ADC);
+    }
+
+    for (i = 0; i < FSL_IMX6SX_NUM_UARTS; i++) {
+        snprintf(name, NAME_SIZE, "uart%d", i + 1);
+        object_initialize_child(obj, name, &s->uart[i], TYPE_IMX_SERIAL);
+    }
+
+    object_initialize_child(obj, "gpt", &s->gpt, TYPE_IMX6_GPT);
+
+    for (i = 0; i < FSL_IMX6SX_NUM_EPITS; i++) {
+        snprintf(name, NAME_SIZE, "epit%d", i + 1);
+        object_initialize_child(obj, name, &s->epit[i], TYPE_IMX_EPIT);
+    }
+
+    for (i = 0; i < FSL_IMX6SX_NUM_I2CS; i++) {
+        snprintf(name, NAME_SIZE, "i2c%d", i + 1);
+        object_initialize_child(obj, name, &s->i2c[i], TYPE_IMX_I2C);
+    }
+
+    for (i = 0; i < FSL_IMX6SX_NUM_ECSPIS; i++) {
+        snprintf(name, NAME_SIZE, "spi%d", i + 1);
+        object_initialize_child(obj, name, &s->spi[i], TYPE_IMX_SPI);
+    }
+
+    for (i = 0; i < FSL_IMX6SX_NUM_GPIOS; i++) {
+        snprintf(name, NAME_SIZE, "gpio%d", i + 1);
+        object_initialize_child(obj, name, &s->gpio[i], TYPE_IMX_GPIO);
+    }
+
+    for (i = 0; i < FSL_IMX6SX_NUM_USDHCS; i++) {
+        snprintf(name, NAME_SIZE, "sdhc%d", i + 1);
+        object_initialize_child(obj, name, &s->usdhc[i], TYPE_IMX_USDHC);
+    }
+
+    for (i = 0; i < FSL_IMX6SX_NUM_USB_PHYS; i++) {
+        snprintf(name, NAME_SIZE, "usbphy%d", i);
+        object_initialize_child(obj, name, &s->usbphy[i], TYPE_IMX_USBPHY);
+    }
+    object_initialize_child(obj, "usb0", &s->usb0, TYPE_CIHDRC_UDC);
+    object_initialize_child(obj, "usbmisc", &s->usbmisc, TYPE_IMX_USBMISC);
+    for (i = 1; i < FSL_IMX6SX_NUM_USBS; i++) {
+        snprintf(name, NAME_SIZE, "usb%d", i);
+        object_initialize_child(obj, name, &s->usb[i - 1], TYPE_CHIPIDEA);
+    }
+
+    for (i = 0; i < FSL_IMX6SX_NUM_ETHS; i++) {
+        snprintf(name, NAME_SIZE, "eth%d", i + 1);
+        object_initialize_child(obj, name, &s->eth[i], TYPE_IMX_ENET);
+    }
+
+    for (i = 0; i < FSL_IMX6SX_NUM_WDTS; i++) {
+        snprintf(name, NAME_SIZE, "wdt%d", i);
+        object_initialize_child(obj, name, &s->wdt[i], TYPE_IMX2_WDT);
+    }
+}
+
+/*
+ * The CCM is QEMU's i.MX6Q model; its CSCMR2 reset value 0x02B92F06 has
+ * VID_CLK_SEL (bits 23:21) = 5, which is out of range for the 6SX vid_sel
+ * mux (5 parents) and makes the 4.1.15 imx6sx clock init oops in
+ * clk_register. Apply the 6SX-family reset value (the i.MX6UL CCM model,
+ * a 6SX derivative, uses the same 0x03192F06) after the CCM's own reset.
+ */
+#define FSL_IMX6SX_CCM_CSCMR2       (FSL_IMX6SX_CCM_ADDR + 0x20)
+
+static void fsl_imx6sx_ccm_reset(void *opaque)
+{
+    address_space_stl_le(&address_space_memory, FSL_IMX6SX_CCM_CSCMR2,
+                         0x03192F06, MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+/*
+ * The sysbus (and with it the CCM) joins the reset chain only once machine
+ * init is done; registering the fixup from here orders it after the CCM's
+ * own reset.
+ */
+static void fsl_imx6sx_ccm_init_done(Notifier *n, void *data)
+{
+    qemu_register_reset(fsl_imx6sx_ccm_reset, NULL);
+}
+
+static Notifier fsl_imx6sx_ccm_notifier = {
+    .notify = fsl_imx6sx_ccm_init_done,
+};
+
+static void fsl_imx6sx_realize(DeviceState *dev, Error **errp)
+{
+    MachineState *ms = MACHINE(qdev_get_machine());
+    FslIMX6SXState *s = FSL_IMX6SX(dev);
+    uint16_t i;
+    DeviceState *mpcore;
+    DeviceState *gic;
+    char name[NAME_SIZE];
+
+    if (ms->smp.cpus > FSL_IMX6SX_NUM_CPUS) {
+        error_setg(errp, "%s: Only %d CPU is supported (%d requested)",
+                   TYPE_FSL_IMX6SX, FSL_IMX6SX_NUM_CPUS, ms->smp.cpus);
+        return;
+    }
+
+    snprintf(name, NAME_SIZE, "cpu%d", 0);
+    object_initialize_child(OBJECT(dev), name, &s->cpu,
+                            ARM_CPU_TYPE_NAME("cortex-a9"));
+    if (!qdev_realize(DEVICE(&s->cpu), NULL, errp)) {
+        return;
+    }
+
+    mpcore = DEVICE(&s->a9mpcore);
+    object_property_set_int(OBJECT(mpcore), "num-cpu", ms->smp.cpus,
+                            &error_abort);
+    object_property_set_int(OBJECT(mpcore), "num-irq",
+                            FSL_IMX6SX_MAX_IRQ + GIC_INTERNAL, &error_abort);
+    if (!sysbus_realize(SYS_BUS_DEVICE(mpcore), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(mpcore), 0, FSL_IMX6SX_A9MPCORE_ADDR);
+
+    gic = mpcore;
+    sysbus_connect_irq(SYS_BUS_DEVICE(gic), 0,
+                       qdev_get_gpio_in(DEVICE(&s->cpu), ARM_CPU_IRQ));
+    sysbus_connect_irq(SYS_BUS_DEVICE(gic), ms->smp.cpus,
+                       qdev_get_gpio_in(DEVICE(&s->cpu), ARM_CPU_FIQ));
+
+    /* L2 cache controller */
+    sysbus_create_simple("l2x0", FSL_IMX6SX_PL310_ADDR, NULL);
+
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->ccm), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->ccm), 0, FSL_IMX6SX_CCM_ADDR);
+    qemu_add_machine_init_done_notifier(&fsl_imx6sx_ccm_notifier);
+
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->src), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->src), 0, FSL_IMX6SX_SRC_ADDR);
+
+    /* GPMI NAND subsystem (APBH DMA at 0x01804000, GPMI 0x01806000, BCH
+     * 0x01808000) — one device, one MMIO block, two interrupt outputs.
+     * The machine attaches the NAND backend directly to the child. */
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->gpmi), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->gpmi), 0, FSL_IMX6SX_APBH_ADDR);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->gpmi), 0,
+                       qdev_get_gpio_in(gic, FSL_IMX6SX_BCH_IRQ));
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->gpmi), 1,
+                       qdev_get_gpio_in(gic, FSL_IMX6SX_APBH_IRQ));
+
+    /* SDMA and MMDC: probe-answer stubs (see imx6_sdma.c / imx6_mmdc.c). */
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->sdma), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->sdma), 0, FSL_IMX6SX_SDMA_ADDR);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->sdma), 0,
+                       qdev_get_gpio_in(gic, FSL_IMX6SX_SDMA_IRQ));
+
+    sysbus_realize(SYS_BUS_DEVICE(&s->mmdc), &error_abort);
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->mmdc), 0, FSL_IMX6SX_MMDC_ADDR);
+
+    /* PWM1-4: each reports its output's frequency on its "tone" line. */
+    for (i = 0; i < FSL_IMX6SX_NUM_PWMS; i++) {
+        if (!sysbus_realize(SYS_BUS_DEVICE(&s->pwm[i]), errp)) {
+            return;
+        }
+        sysbus_mmio_map(SYS_BUS_DEVICE(&s->pwm[i]), 0,
+                        FSL_IMX6SX_PWM1_ADDR + i * 0x4000);
+    }
+
+    /* Initialize all UARTs */
+    {
+        static const struct {
+            hwaddr addr;
+            unsigned int irq;
+        } serial_table[FSL_IMX6SX_NUM_UARTS] = {
+            { FSL_IMX6SX_UART1_ADDR, FSL_IMX6SX_UART1_IRQ },
+            { FSL_IMX6SX_UART2_ADDR, FSL_IMX6SX_UART2_IRQ },
+            { FSL_IMX6SX_UART3_ADDR, FSL_IMX6SX_UART3_IRQ },
+            { FSL_IMX6SX_UART4_ADDR, FSL_IMX6SX_UART4_IRQ },
+            { FSL_IMX6SX_UART5_ADDR, FSL_IMX6SX_UART5_IRQ },
+            { FSL_IMX6SX_UART6_ADDR, FSL_IMX6SX_UART6_IRQ },
+        };
+
+        for (i = 0; i < FSL_IMX6SX_NUM_UARTS; i++) {
+            qdev_prop_set_chr(DEVICE(&s->uart[i]), "chardev", serial_hd(i));
+            if (!sysbus_realize(SYS_BUS_DEVICE(&s->uart[i]), errp)) {
+                return;
+            }
+            sysbus_mmio_map(SYS_BUS_DEVICE(&s->uart[i]), 0,
+                            serial_table[i].addr);
+            sysbus_connect_irq(SYS_BUS_DEVICE(&s->uart[i]), 0,
+                               qdev_get_gpio_in(gic, serial_table[i].irq));
+        }
+    }
+
+    s->gpt.ccm = IMX_CCM(&s->ccm);
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->gpt), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->gpt), 0, FSL_IMX6SX_GPT_ADDR);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->gpt), 0,
+                       qdev_get_gpio_in(gic, FSL_IMX6SX_GPT_IRQ));
+
+    /* Initialize all EPIT timers */
+    {
+        static const struct {
+            hwaddr addr;
+            unsigned int irq;
+        } epit_table[FSL_IMX6SX_NUM_EPITS] = {
+            { FSL_IMX6SX_EPIT1_ADDR, FSL_IMX6SX_EPIT1_IRQ },
+            { FSL_IMX6SX_EPIT2_ADDR, FSL_IMX6SX_EPIT2_IRQ },
+        };
+
+        for (i = 0; i < FSL_IMX6SX_NUM_EPITS; i++) {
+            s->epit[i].ccm = IMX_CCM(&s->ccm);
+            if (!sysbus_realize(SYS_BUS_DEVICE(&s->epit[i]), errp)) {
+                return;
+            }
+            sysbus_mmio_map(SYS_BUS_DEVICE(&s->epit[i]), 0, epit_table[i].addr);
+            sysbus_connect_irq(SYS_BUS_DEVICE(&s->epit[i]), 0,
+                               qdev_get_gpio_in(gic, epit_table[i].irq));
+        }
+    }
+
+    /* Initialize all I2C */
+    {
+        static const struct {
+            hwaddr addr;
+            unsigned int irq;
+        } i2c_table[FSL_IMX6SX_NUM_I2CS] = {
+            { FSL_IMX6SX_I2C1_ADDR, FSL_IMX6SX_I2C1_IRQ },
+            { FSL_IMX6SX_I2C2_ADDR, FSL_IMX6SX_I2C2_IRQ },
+            { FSL_IMX6SX_I2C3_ADDR, FSL_IMX6SX_I2C3_IRQ },
+            { FSL_IMX6SX_I2C4_ADDR, FSL_IMX6SX_I2C4_IRQ },
+        };
+
+        for (i = 0; i < FSL_IMX6SX_NUM_I2CS; i++) {
+            if (!sysbus_realize(SYS_BUS_DEVICE(&s->i2c[i]), errp)) {
+                return;
+            }
+            sysbus_mmio_map(SYS_BUS_DEVICE(&s->i2c[i]), 0, i2c_table[i].addr);
+            sysbus_connect_irq(SYS_BUS_DEVICE(&s->i2c[i]), 0,
+                               qdev_get_gpio_in(gic, i2c_table[i].irq));
+        }
+
+        /* The PFUZE200 PMIC, i2c4 address 0x08 (see hw/i2c/pfuze200.c). */
+        i2c_slave_create_simple(s->i2c[3].bus, TYPE_PFUZE200, 0x08);
+    }
+
+    /* Initialize ECSPI1-4: contiguous 16 KiB blocks, consecutive IRQs */
+    for (i = 0; i < FSL_IMX6SX_NUM_ECSPIS; i++) {
+        if (!sysbus_realize(SYS_BUS_DEVICE(&s->spi[i]), errp)) {
+            return;
+        }
+        sysbus_mmio_map(SYS_BUS_DEVICE(&s->spi[i]), 0,
+                        FSL_IMX6SX_ECSPI1_ADDR + i * 0x4000);
+        sysbus_connect_irq(SYS_BUS_DEVICE(&s->spi[i]), 0,
+                           qdev_get_gpio_in(gic, FSL_IMX6SX_ECSPI1_IRQ + i));
+    }
+
+    /* Initialize all GPIOs */
+    {
+        static const struct {
+            hwaddr addr;
+            unsigned int irq_low;
+            unsigned int irq_high;
+        } gpio_table[FSL_IMX6SX_NUM_GPIOS] = {
+            { FSL_IMX6SX_GPIO1_ADDR, FSL_IMX6SX_GPIO1_LOW_IRQ,
+              FSL_IMX6SX_GPIO1_HIGH_IRQ },
+            { FSL_IMX6SX_GPIO2_ADDR, FSL_IMX6SX_GPIO2_LOW_IRQ,
+              FSL_IMX6SX_GPIO2_HIGH_IRQ },
+            { FSL_IMX6SX_GPIO3_ADDR, FSL_IMX6SX_GPIO3_LOW_IRQ,
+              FSL_IMX6SX_GPIO3_HIGH_IRQ },
+            { FSL_IMX6SX_GPIO4_ADDR, FSL_IMX6SX_GPIO4_LOW_IRQ,
+              FSL_IMX6SX_GPIO4_HIGH_IRQ },
+            { FSL_IMX6SX_GPIO5_ADDR, FSL_IMX6SX_GPIO5_LOW_IRQ,
+              FSL_IMX6SX_GPIO5_HIGH_IRQ },
+            { FSL_IMX6SX_GPIO6_ADDR, FSL_IMX6SX_GPIO6_LOW_IRQ,
+              FSL_IMX6SX_GPIO6_HIGH_IRQ },
+            { FSL_IMX6SX_GPIO7_ADDR, FSL_IMX6SX_GPIO7_LOW_IRQ,
+              FSL_IMX6SX_GPIO7_HIGH_IRQ },
+        };
+
+        for (i = 0; i < FSL_IMX6SX_NUM_GPIOS; i++) {
+            object_property_set_bool(OBJECT(&s->gpio[i]), "has-edge-sel",
+                                     true, &error_abort);
+            object_property_set_bool(OBJECT(&s->gpio[i]), "has-upper-pin-irq",
+                                     true, &error_abort);
+            if (!sysbus_realize(SYS_BUS_DEVICE(&s->gpio[i]), errp)) {
+                return;
+            }
+            sysbus_mmio_map(SYS_BUS_DEVICE(&s->gpio[i]), 0, gpio_table[i].addr);
+            sysbus_connect_irq(SYS_BUS_DEVICE(&s->gpio[i]), 0,
+                               qdev_get_gpio_in(gic, gpio_table[i].irq_low));
+            sysbus_connect_irq(SYS_BUS_DEVICE(&s->gpio[i]), 1,
+                               qdev_get_gpio_in(gic, gpio_table[i].irq_high));
+        }
+    }
+
+    /*
+     * The board's ADC front ends: adc1 is the magwheel (two Hall channels
+     * in quadrature, gated by the hall-enable line GPIO7_IO02, active
+     * low); adc2 reads the battery divider, gated by GPIO6_IO16 (active
+     * high). The wheel sees the UI through its wheel-position property
+     * (the machine aliases it as /machine/wheel-position).
+     */
+    object_property_set_bool(OBJECT(&s->adc[0]), "gate-active-low", true,
+                             &error_abort);
+    for (i = 0; i < FSL_IMX6SX_NUM_ADCS; i++) {
+        static const struct {
+            hwaddr addr;
+            unsigned int irq;
+        } adc_table[FSL_IMX6SX_NUM_ADCS] = {
+            { FSL_IMX6SX_ADC1_ADDR, FSL_IMX6SX_ADC1_IRQ },
+            { FSL_IMX6SX_ADC2_ADDR, FSL_IMX6SX_ADC2_IRQ },
+        };
+
+        if (!sysbus_realize(SYS_BUS_DEVICE(&s->adc[i]), errp)) {
+            return;
+        }
+        sysbus_mmio_map(SYS_BUS_DEVICE(&s->adc[i]), 0, adc_table[i].addr);
+        sysbus_connect_irq(SYS_BUS_DEVICE(&s->adc[i]), 0,
+                           qdev_get_gpio_in(gic, adc_table[i].irq));
+    }
+    /* The gate lines come from the board wiring in flintstone_init. */
+
+    /* LCDIF: scanout for the hx8357 panel (480x640@32bpp over the CMA fb). */
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->lcdif), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->lcdif), 0, FSL_IMX6SX_LCDIF_ADDR);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->lcdif), 0,
+                       qdev_get_gpio_in(gic, FSL_IMX6SX_LCDIF_IRQ));
+
+    /* Initialize all SDHC */
+    {
+        static const struct {
+            hwaddr addr;
+            unsigned int irq;
+        } esdhc_table[FSL_IMX6SX_NUM_USDHCS] = {
+            { FSL_IMX6SX_uSDHC1_ADDR, FSL_IMX6SX_uSDHC1_IRQ },
+            { FSL_IMX6SX_uSDHC2_ADDR, FSL_IMX6SX_uSDHC2_IRQ },
+            { FSL_IMX6SX_uSDHC3_ADDR, FSL_IMX6SX_uSDHC3_IRQ },
+            { FSL_IMX6SX_uSDHC4_ADDR, FSL_IMX6SX_uSDHC4_IRQ },
+        };
+
+        for (i = 0; i < FSL_IMX6SX_NUM_USDHCS; i++) {
+            /* UHS-I SDIO3.0 SDR104 1.8V ADMA */
+            object_property_set_uint(OBJECT(&s->usdhc[i]), "capareg",
+                                     IMX6SX_ESDHC_CAPABILITIES, &error_abort);
+            if (!sysbus_realize(SYS_BUS_DEVICE(&s->usdhc[i]), errp)) {
+                return;
+            }
+            sysbus_mmio_map(SYS_BUS_DEVICE(&s->usdhc[i]), 0,
+                            esdhc_table[i].addr);
+            sysbus_connect_irq(SYS_BUS_DEVICE(&s->usdhc[i]), 0,
+                               qdev_get_gpio_in(gic, esdhc_table[i].irq));
+        }
+    }
+
+    /* USB */
+    for (i = 0; i < FSL_IMX6SX_NUM_USB_PHYS; i++) {
+        static const hwaddr usbphy_addr[FSL_IMX6SX_NUM_USB_PHYS] = {
+            FSL_IMX6SX_USBPHY1_ADDR,
+            FSL_IMX6SX_USBPHY2_ADDR,
+        };
+
+        sysbus_realize(SYS_BUS_DEVICE(&s->usbphy[i]), &error_abort);
+        sysbus_mmio_map(SYS_BUS_DEVICE(&s->usbphy[i]), 0, usbphy_addr[i]);
+    }
+    {
+        static const struct {
+            hwaddr addr;
+            unsigned int irq;
+        } usb_table[FSL_IMX6SX_NUM_USBS] = {
+            { FSL_IMX6SX_USBOH3_USB_ADDR + 0 * 0x200, FSL_IMX6SX_USB_OTG_IRQ },
+            { FSL_IMX6SX_USBOH3_USB_ADDR + 1 * 0x200, FSL_IMX6SX_USB_HOST1_IRQ },
+            { FSL_IMX6SX_USBOH3_USB_ADDR + 2 * 0x200, FSL_IMX6SX_USB_HOST2_IRQ },
+        };
+
+        for (i = 0; i < FSL_IMX6SX_NUM_USBS; i++) {
+            SysBusDevice *usb = i ? SYS_BUS_DEVICE(&s->usb[i - 1]) :
+                                   SYS_BUS_DEVICE(&s->usb0);
+
+            if (!i && s->usb0_hostchar) {
+                qdev_prop_set_string(DEVICE(usb), "hostchar", s->usb0_hostchar);
+            }
+            if (!sysbus_realize(usb, errp)) {
+                return;
+            }
+            sysbus_mmio_map(usb, 0, usb_table[i].addr);
+            sysbus_connect_irq(usb, 0,
+                               qdev_get_gpio_in(gic, usb_table[i].irq));
+        }
+    }
+
+    sysbus_realize(SYS_BUS_DEVICE(&s->usbmisc), &error_abort);
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->usbmisc), 0, 0x02184800);
+
+    /* Initialize both FECs */
+    {
+        static const struct {
+            hwaddr addr;
+            unsigned int irq;
+            unsigned int irq_1588;
+        } eth_table[FSL_IMX6SX_NUM_ETHS] = {
+            { FSL_IMX6SX_ENET1_ADDR, FSL_IMX6SX_ENET1_IRQ,
+              FSL_IMX6SX_ENET1_1588_IRQ },
+            { FSL_IMX6SX_ENET2_ADDR, FSL_IMX6SX_ENET2_IRQ,
+              FSL_IMX6SX_ENET2_1588_IRQ },
+        };
+
+        for (i = 0; i < FSL_IMX6SX_NUM_ETHS; i++) {
+            if (i == 0) {
+                object_property_set_uint(OBJECT(&s->eth[i]), "phy-num",
+                                         s->phy_num, &error_abort);
+            }
+            qemu_configure_nic_device(DEVICE(&s->eth[i]), true, NULL);
+            if (!sysbus_realize(SYS_BUS_DEVICE(&s->eth[i]), errp)) {
+                return;
+            }
+            sysbus_mmio_map(SYS_BUS_DEVICE(&s->eth[i]), 0, eth_table[i].addr);
+            sysbus_connect_irq(SYS_BUS_DEVICE(&s->eth[i]), 0,
+                               qdev_get_gpio_in(gic, eth_table[i].irq));
+            sysbus_connect_irq(SYS_BUS_DEVICE(&s->eth[i]), 1,
+                               qdev_get_gpio_in(gic, eth_table[i].irq_1588));
+        }
+    }
+
+    /* SNVS */
+    sysbus_realize(SYS_BUS_DEVICE(&s->snvs), &error_abort);
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->snvs), 0, FSL_IMX6SX_SNVSHP_ADDR);
+
+    /* Watchdogs */
+    {
+        static const hwaddr wdt_addr[FSL_IMX6SX_NUM_WDTS] = {
+            FSL_IMX6SX_WDOG1_ADDR,
+            FSL_IMX6SX_WDOG2_ADDR,
+            FSL_IMX6SX_WDOG3_ADDR,
+        };
+        static const int wdt_irq[FSL_IMX6SX_NUM_WDTS] = {
+            FSL_IMX6SX_WDOG1_IRQ,
+            FSL_IMX6SX_WDOG2_IRQ,
+            FSL_IMX6SX_WDOG3_IRQ,
+        };
+
+        for (i = 0; i < FSL_IMX6SX_NUM_WDTS; i++) {
+            object_property_set_bool(OBJECT(&s->wdt[i]), "pretimeout-support",
+                                     true, &error_abort);
+            sysbus_realize(SYS_BUS_DEVICE(&s->wdt[i]), &error_abort);
+            sysbus_mmio_map(SYS_BUS_DEVICE(&s->wdt[i]), 0, wdt_addr[i]);
+            sysbus_connect_irq(SYS_BUS_DEVICE(&s->wdt[i]), 0,
+                               qdev_get_gpio_in(gic, wdt_irq[i]));
+        }
+    }
+
+    /* Memory regions */
+    memory_region_init_rom(&s->rom, OBJECT(dev), "imx6sx.rom",
+                           FSL_IMX6SX_ROM_SIZE, &error_fatal);
+    memory_region_add_subregion(get_system_memory(), FSL_IMX6SX_ROM_ADDR,
+                                &s->rom);
+
+    memory_region_init_ram(&s->ocram, NULL, "imx6sx.ocram",
+                           FSL_IMX6SX_OCRAM_SIZE, &error_fatal);
+    memory_region_add_subregion(get_system_memory(), FSL_IMX6SX_OCRAM_ADDR,
+                                &s->ocram);
+
+    /* OCRAM_S: the kernel runs its suspend code from here */
+    memory_region_init_ram(&s->lpm_sram, NULL, "imx6sx.lpm-sram",
+                           FSL_IMX6SX_LPM_SRAM_SIZE, &error_fatal);
+    memory_region_add_subregion(get_system_memory(), FSL_IMX6SX_LPM_SRAM_ADDR,
+                                &s->lpm_sram);
+
+    memory_region_init_ram(&s->caam, NULL, "imx6sx.caam",
+                           FSL_IMX6SX_CAAM_MEM_SIZE, &error_fatal);
+    memory_region_add_subregion(get_system_memory(), FSL_IMX6SX_CAAM_MEM_ADDR,
+                                &s->caam);
+
+    /* The GC400T GPU3D (see hw/display/vivante_gc.c). */
+    {
+        DeviceState *gpu = qdev_new(TYPE_VIVANTE_GC);
+
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(gpu), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(gpu), 0, FSL_IMX6SX_GPU_ADDR);
+        sysbus_connect_irq(SYS_BUS_DEVICE(gpu), 0,
+                           qdev_get_gpio_in(gic, FSL_IMX6SX_GPU_IRQ));
+    }
+
+    /* Regions the boot software touches but we do not (yet) model */
+    for (i = 0; i < ARRAY_SIZE(fsl_imx6sx_unimplemented); i++) {
+        const char *nm = fsl_imx6sx_unimplemented[i].name;
+        if (!nm) {
+            continue;
+        }
+        create_unimplemented_device(nm, fsl_imx6sx_unimplemented[i].addr,
+                                    fsl_imx6sx_unimplemented[i].size);
+    }
+}
+
+static const Property fsl_imx6sx_properties[] = {
+    DEFINE_PROP_STRING("usb0-hostchar", FslIMX6SXState, usb0_hostchar),
+    DEFINE_PROP_UINT32("fec-phy-num", FslIMX6SXState, phy_num, 0),
+};
+
+static void fsl_imx6sx_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    device_class_set_props(dc, fsl_imx6sx_properties);
+    dc->realize = fsl_imx6sx_realize;
+    dc->desc = "i.MX6SX SoC";
+    /* Reason: Uses serial_hd() in the realize() function */
+    dc->user_creatable = false;
+}
+
+static const TypeInfo fsl_imx6sx_type_info = {
+    .name = TYPE_FSL_IMX6SX,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(FslIMX6SXState),
+    .instance_init = fsl_imx6sx_init,
+    .class_init = fsl_imx6sx_class_init,
+};
+
+static void fsl_imx6sx_register_types(void)
+{
+    type_register_static(&fsl_imx6sx_type_info);
+}
+
+type_init(fsl_imx6sx_register_types)
diff --git a/hw/usb/cihdrc-udc.c b/hw/usb/cihdrc-udc.c
new file mode 100644
index 0000000..3bd866a
--- /dev/null
+++ b/hw/usb/cihdrc-udc.c
@@ -0,0 +1,542 @@
+/*
+ * ChipIdea CI HDRC peripheral controller with a line-based host bridge.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/usb/cihdrc-udc.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/cutils.h"
+#include "qemu/module.h"
+#include "exec/cpu-common.h"
+
+#define USBCMD          0x140
+#define USBSTS          0x144
+#define USBINTR         0x148
+#define DEVICEADDR      0x154
+#define ENDPTLISTADDR   0x158
+#define PORTSC          0x184
+#define OTGSC           0x1a4
+#define USBMODE         0x1a8
+#define SETUPSTAT       0x1ac
+#define PRIME           0x1b0
+#define FLUSH           0x1b4
+#define EPSTAT          0x1b8
+#define COMPLETE        0x1bc
+#define EPCTRL          0x1c0
+#define REG(s, r)       ((s)->regs[(r) / 4])
+#define CMD_RS          BIT(0)
+#define CMD_RST         BIT(1)
+#define CMD_SUTW        BIT(13)
+#define CMD_ATDTW       BIT(14)
+#define STS_UI          BIT(0)
+#define STS_UEI         BIT(1)
+#define STS_PCI         BIT(2)
+#define STS_URI         BIT(6)
+#define STS_MASK        0x147
+#define EP_MASK         0x000f000f
+#define PORT_W1C        (BIT(1) | BIT(3) | BIT(5))
+#define PORT_HSP        BIT(9)
+#define PORT_SPEED      (3U << 26)
+#define TD_ACTIVE       BIT(7)
+#define TD_HALTED       BIT(6)
+#define TD_BUFFER_ERR   BIT(5)
+#define TD_IOC          BIT(15)
+#define TD_BYTES        0x7fff0000
+#define TD_ADDR         0xffffffe0
+#define TD_TERMINATE    BIT(0)
+#define MAX_CHAIN       1024
+
+static void ci_irq(CIHDRCUDCState *s)
+{
+    qemu_set_irq(s->irq, !!(REG(s, USBSTS) & REG(s, USBINTR) & STS_MASK));
+}
+
+static void ci_send(CIHDRCUDCState *s, const char *text)
+{
+    if (qemu_chr_fe_backend_connected(&s->chr)) {
+        qemu_chr_fe_write_all(&s->chr, (const uint8_t *)text, strlen(text));
+    }
+}
+
+static void ci_connect(CIHDRCUDCState *s)
+{
+    bool connected = (REG(s, USBCMD) & CMD_RS) &&
+                     (REG(s, USBMODE) & 3) == 2;
+
+    if (s->connected != connected) {
+        s->connected = connected;
+        ci_send(s, connected ? "CONNECT\n" : "DISCONNECT\n");
+    }
+}
+
+static hwaddr ci_qh(CIHDRCUDCState *s, unsigned slot)
+{
+    return (hwaddr)REG(s, ENDPTLISTADDR) + 64 * slot;
+}
+
+static uint32_t ci_dma_read32(hwaddr addr)
+{
+    uint8_t buf[4];
+
+    cpu_physical_memory_read(addr, buf, sizeof(buf));
+    return ldl_le_p(buf);
+}
+
+static void ci_dma_write32(hwaddr addr, uint32_t value)
+{
+    uint8_t buf[4];
+
+    stl_le_p(buf, value);
+    cpu_physical_memory_write(addr, buf, sizeof(buf));
+}
+
+static uint32_t ci_ep_bit(unsigned slot)
+{
+    return BIT(slot / 2 + (slot % 2) * 16);
+}
+
+static void ci_flush(CIHDRCUDCState *s, uint32_t bits)
+{
+    unsigned slot;
+
+    REG(s, EPSTAT) &= ~bits;
+    REG(s, COMPLETE) &= ~bits;
+    for (slot = 0; slot < CIHDRC_EP_COUNT * 2; slot++) {
+        if (bits & ci_ep_bit(slot)) {
+            s->td[slot] = TD_TERMINATE;
+            s->offset[slot] = 0;
+        }
+    }
+}
+
+static void ci_reset(DeviceState *dev)
+{
+    CIHDRCUDCState *s = CIHDRC_UDC(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    REG(s, PORTSC) = BIT(12) | BIT(0);
+    REG(s, OTGSC) = BIT(8) | BIT(11);
+    REG(s, EPCTRL) = BIT(7) | BIT(23);
+    s->setup_pending = false;
+    ci_flush(s, EP_MASK);
+    ci_connect(s);
+    ci_irq(s);
+}
+
+static void ci_speed(CIHDRCUDCState *s)
+{
+    REG(s, PORTSC) &= ~(PORT_HSP | PORT_SPEED);
+    if (s->high_speed && !(REG(s, PORTSC) & BIT(24))) {
+        REG(s, PORTSC) |= PORT_HSP | (2U << 26);
+    }
+}
+
+static void ci_setup(CIHDRCUDCState *s)
+{
+    if (!s->setup_pending || (REG(s, USBCMD) & CMD_SUTW)) {
+        return;
+    }
+    s->setup_pending = false;
+    cpu_physical_memory_write(ci_qh(s, 0) + 0x28, s->setup, 8);
+    REG(s, EPCTRL) &= ~(BIT(0) | BIT(16));
+    REG(s, SETUPSTAT) |= 1;
+    REG(s, USBSTS) |= STS_UI;
+    ci_irq(s);
+}
+
+/* Page zero carries the initial byte offset; later pages are aligned. */
+static bool ci_copy(uint32_t td, unsigned offset, uint8_t *data,
+                    unsigned length, bool in)
+{
+    uint32_t first = ci_dma_read32((hwaddr)td + 8);
+    unsigned position = (first & 0xfff) + offset;
+
+    if (position + length > 5 * 4096) {
+        return false;
+    }
+    while (length) {
+        unsigned page = position / 4096;
+        unsigned off = position % 4096;
+        unsigned count = MIN(length, 4096 - off);
+        hwaddr addr = ci_dma_read32((hwaddr)td + 8 + page * 4);
+
+        addr = (addr & ~0xfffULL) + off;
+        if (in) {
+            cpu_physical_memory_read(addr, data, count);
+        } else {
+            cpu_physical_memory_write(addr, data, count);
+        }
+        position += count;
+        data += count;
+        length -= count;
+    }
+    return true;
+}
+
+/* A host command can span packets; only a short OUT ends a request early. */
+static unsigned ci_transfer(CIHDRCUDCState *s, unsigned ep, bool in,
+                             uint8_t *data, unsigned length)
+{
+    unsigned slot = ep * 2 + in;
+    uint32_t bit = ci_ep_bit(slot);
+    uint32_t ctrl = REG(s, EPCTRL + ep * 4) >> (in ? 16 : 0);
+    unsigned maxpacket = (ci_dma_read32(ci_qh(s, slot)) >> 16) & 0x7ff;
+    unsigned done = 0, visits;
+    bool short_out = !in && (!length || (maxpacket && length % maxpacket));
+    bool draining = false;
+
+    if (!s->connected || !(REG(s, EPSTAT) & bit) ||
+        (ctrl & 1) || (ep && !(ctrl & BIT(7)))) {
+        return 0;
+    }
+    for (visits = 0; visits < MAX_CHAIN; visits++) {
+        uint32_t td = s->td[slot] & TD_ADDR;
+        uint32_t token = ci_dma_read32((hwaddr)td + 4);
+        uint32_t next = ci_dma_read32(td);
+        unsigned residual = (token & TD_BYTES) >> 16;
+        unsigned count = draining ? 0 : MIN(residual, length - done);
+        bool error = false;
+
+        if (!(token & TD_ACTIVE) || (token & TD_HALTED)) {
+            REG(s, EPSTAT) &= ~bit;
+            break;
+        }
+        if (!ci_copy(td, s->offset[slot], data + done, count, in)) {
+            token |= TD_BUFFER_ERR | TD_HALTED;
+            count = 0;
+            error = true;
+        }
+        done += count;
+        residual -= count;
+        s->offset[slot] += count;
+        draining |= short_out && done == length;
+        token = (token & ~TD_BYTES) | (residual << 16);
+        if (residual && !draining && !error) {
+            ci_dma_write32((hwaddr)td + 4, token);
+            ci_dma_write32(ci_qh(s, slot) + 12, token);
+            break;
+        }
+        token &= ~TD_ACTIVE;
+        ci_dma_write32((hwaddr)td + 4, token);
+        ci_dma_write32(ci_qh(s, slot) + 4, td);
+        ci_dma_write32(ci_qh(s, slot) + 8, next);
+        ci_dma_write32(ci_qh(s, slot) + 12, token);
+        REG(s, COMPLETE) |= bit;
+        if (token & TD_IOC) {
+            REG(s, USBSTS) |= STS_UI;
+        }
+        if (error) {
+            REG(s, USBSTS) |= STS_UEI;
+        }
+        s->td[slot] = next;
+        s->offset[slot] = 0;
+        if ((next & TD_TERMINATE) || error) {
+            REG(s, EPSTAT) &= ~bit;
+            break;
+        }
+        /* IOC delimits a request; a short packet must not eat the next one. */
+        if (draining && (token & TD_IOC)) {
+            break;
+        }
+        if (!draining && done == length) {
+            break;
+        }
+    }
+    if (visits == MAX_CHAIN) {
+        REG(s, EPSTAT) &= ~bit;
+        REG(s, USBSTS) |= STS_UEI;
+    }
+    ci_irq(s);
+    return done;
+}
+
+static bool ci_unhex(const char *hex, uint8_t *data, unsigned *length)
+{
+    size_t len = strlen(hex);
+    unsigned i;
+
+    if ((len & 1) || len > CIHDRC_MAX_DATA * 2) {
+        return false;
+    }
+    for (i = 0; i < len / 2; i++) {
+        int hi = g_ascii_xdigit_value(hex[2 * i]);
+        int lo = g_ascii_xdigit_value(hex[2 * i + 1]);
+
+        if (hi < 0 || lo < 0) {
+            return false;
+        }
+        data[i] = (hi << 4) | lo;
+    }
+    *length = len / 2;
+    return true;
+}
+
+static void ci_command(CIHDRCUDCState *s, char *line)
+{
+    g_auto(GStrv) args = g_strsplit(line, " ", 3);
+    unsigned argc = g_strv_length(args);
+    unsigned ep, length;
+    g_autofree uint8_t *data = NULL;
+
+    if (argc == 1 && !strcmp(args[0], "RESET")) {
+        ci_flush(s, EP_MASK);
+        REG(s, DEVICEADDR) = 0;
+        REG(s, SETUPSTAT) = 0;
+        s->setup_pending = false;
+        ci_speed(s);
+        REG(s, USBSTS) |= STS_URI | STS_PCI;
+        ci_irq(s);
+        ci_send(s, "RESETDONE\n");
+    } else if (argc == 2 && !strcmp(args[0], "SPEED")) {
+        if (!strcmp(args[1], "hs") || !strcmp(args[1], "fs")) {
+            s->high_speed = !strcmp(args[1], "hs");
+            ci_speed(s);
+        }
+    } else if (argc == 2 && !strcmp(args[0], "SETUP")) {
+        uint8_t setup[8];
+
+        if (s->connected && strlen(args[1]) == 16 &&
+            ci_unhex(args[1], setup, &length)) {
+            memcpy(s->setup, setup, sizeof(setup));
+            s->setup_pending = true;
+            ci_setup(s);
+        }
+    } else if (argc == 3 &&
+               !qemu_strtoui(args[1], NULL, 10, &ep) && ep < CIHDRC_EP_COUNT) {
+        data = g_malloc(CIHDRC_MAX_DATA);
+        if (!strcmp(args[0], "INEP") &&
+            !qemu_strtoui(args[2], NULL, 10, &length) &&
+            length <= CIHDRC_MAX_DATA) {
+            g_autoptr(GString) reply = g_string_new(NULL);
+            unsigned i;
+
+            length = ci_transfer(s, ep, true, data, length);
+            g_string_append_printf(reply, "INDATA %u ", ep);
+            for (i = 0; i < length; i++) {
+                g_string_append_printf(reply, "%02x", data[i]);
+            }
+            g_string_append_c(reply, '\n');
+            ci_send(s, reply->str);
+        } else if (!strcmp(args[0], "OUTEP") &&
+                   ci_unhex(args[2], data, &length)) {
+            ci_transfer(s, ep, false, data, length);
+        }
+    }
+}
+
+static int ci_can_read(void *opaque)
+{
+    return 4096;
+}
+
+static void ci_receive(void *opaque, const uint8_t *buf, int size)
+{
+    CIHDRCUDCState *s = opaque;
+    int i;
+
+    for (i = 0; i < size; i++) {
+        if (buf[i] == '\n') {
+            if (!s->discard_line) {
+                s->line[s->line_len] = 0;
+                ci_command(s, s->line);
+            }
+            s->line_len = 0;
+            s->discard_line = false;
+        } else if (buf[i] == 0 || s->line_len == sizeof(s->line) - 1) {
+            s->discard_line = true;
+        } else if (!s->discard_line && buf[i] != '\r') {
+            s->line[s->line_len++] = buf[i];
+        }
+    }
+}
+
+static void ci_event(void *opaque, QEMUChrEvent event)
+{
+    CIHDRCUDCState *s = opaque;
+
+    if (event == CHR_EVENT_OPENED && s->connected) {
+        ci_send(s, "CONNECT\n");
+    }
+    if (event == CHR_EVENT_CLOSED) {
+        s->line_len = 0;
+        s->discard_line = false;
+    }
+}
+
+static uint64_t ci_read(void *opaque, hwaddr addr, unsigned size)
+{
+    CIHDRCUDCState *s = opaque;
+
+    switch (addr) {
+    case 0x000:
+        return 0x04a0000a; /* CI revision 2.5 */
+    case 0x100:
+        return 0x01000040; /* HCIVERSION 1.0, CAPLENGTH 0x40 */
+    case 0x104:
+        return 1;
+    case 0x120:
+        return 1;
+    case 0x124:
+        return 0x180 | CIHDRC_EP_COUNT;
+    default:
+        return REG(s, addr);
+    }
+}
+
+static void ci_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    CIHDRCUDCState *s = opaque;
+    unsigned slot;
+
+    switch (addr) {
+    case USBCMD:
+        if (value & CMD_RST) {
+            ci_reset(DEVICE(s));
+        } else {
+            REG(s, USBCMD) = value & (CMD_RS | CMD_SUTW | CMD_ATDTW);
+            ci_setup(s);
+            ci_connect(s);
+        }
+        break;
+    case USBSTS:
+    case COMPLETE:
+        REG(s, addr) &= ~value;
+        break;
+    case SETUPSTAT:
+        if (REG(s, SETUPSTAT) & value & 1) {
+            ci_send(s, "SETUPACK\n");
+        }
+        REG(s, SETUPSTAT) &= ~value;
+        break;
+    case USBINTR:
+        REG(s, addr) = value & STS_MASK;
+        break;
+    case DEVICEADDR:
+        REG(s, addr) = value & 0xfe000000;
+        break;
+    case ENDPTLISTADDR:
+        REG(s, addr) = value & 0xffffffc0;
+        break;
+    case PORTSC:
+        REG(s, addr) = (REG(s, addr) & (BIT(0) | BIT(7) | PORT_HSP |
+                                      BIT(12) | PORT_SPEED | PORT_W1C)) &
+                      ~(value & PORT_W1C);
+        REG(s, addr) |= value & (0xf0000 | BIT(24) | BIT(28) | (3U << 30));
+        break;
+    case OTGSC:
+        REG(s, addr) = (REG(s, addr) & 0x007f1f00) & ~(value & 0x007f0000);
+        REG(s, addr) |= value & 0x7f0000ff;
+        break;
+    case USBMODE:
+        REG(s, addr) = value & 0x1b;
+        ci_connect(s);
+        break;
+    case PRIME:
+        for (slot = 0; slot < CIHDRC_EP_COUNT * 2; slot++) {
+            uint32_t bit = ci_ep_bit(slot);
+
+            if ((value & bit) && !(REG(s, EPSTAT) & bit)) {
+                s->td[slot] = ci_dma_read32(ci_qh(s, slot) + 8);
+                s->offset[slot] = 0;
+                if (!(s->td[slot] & TD_TERMINATE)) {
+                    REG(s, EPSTAT) |= bit;
+                }
+            }
+        }
+        break;
+    case FLUSH:
+        ci_flush(s, value & EP_MASK);
+        break;
+    default:
+        if (addr >= EPCTRL && addr < EPCTRL + 4 * CIHDRC_EP_COUNT) {
+            REG(s, addr) = value & 0x008d008d;
+            if (addr == EPCTRL) {
+                REG(s, addr) = (REG(s, addr) & 0x00010001) | 0x00800080;
+            }
+        }
+        break;
+    }
+    ci_irq(s);
+}
+
+static const MemoryRegionOps ci_ops = {
+    .read = ci_read,
+    .write = ci_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void ci_realize(DeviceState *dev, Error **errp)
+{
+    CIHDRCUDCState *s = CIHDRC_UDC(dev);
+
+    if (s->hostchar && *s->hostchar) {
+        Chardev *chr = qemu_chr_find(s->hostchar);
+
+        if (!chr) {
+            error_setg(errp, "cihdrc-udc: chardev '%s' not found", s->hostchar);
+            return;
+        }
+        if (!qemu_chr_fe_init(&s->chr, chr, errp)) {
+            return;
+        }
+        qemu_chr_fe_set_handlers(&s->chr, ci_can_read, ci_receive, ci_event,
+                                 NULL, s, NULL, true);
+    }
+}
+
+static void ci_unrealize(DeviceState *dev)
+{
+    qemu_chr_fe_deinit(&CIHDRC_UDC(dev)->chr, false);
+}
+
+static void ci_init(Object *obj)
+{
+    CIHDRCUDCState *s = CIHDRC_UDC(obj);
+
+    s->high_speed = true;
+    memory_region_init_io(&s->iomem, obj, &ci_ops, s, TYPE_CIHDRC_UDC, 0x200);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq);
+}
+
+static const Property ci_properties[] = {
+    DEFINE_PROP_STRING("hostchar", CIHDRCUDCState, hostchar),
+};
+
+static const VMStateDescription ci_vmstate = {
+    .name = TYPE_CIHDRC_UDC,
+    .unmigratable = 1,
+};
+
+static void ci_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ci_realize;
+    dc->unrealize = ci_unrealize;
+    device_class_set_legacy_reset(dc, ci_reset);
+    device_class_set_props(dc, ci_properties);
+    dc->vmsd = &ci_vmstate;
+    dc->desc = "ChipIdea CI HDRC USB peripheral controller";
+    set_bit(DEVICE_CATEGORY_USB, dc->categories);
+}
+
+static const TypeInfo ci_info = {
+    .name = TYPE_CIHDRC_UDC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(CIHDRCUDCState),
+    .instance_init = ci_init,
+    .class_init = ci_class_init,
+};
+
+static void ci_register_types(void)
+{
+    type_register_static(&ci_info);
+}
+
+type_init(ci_register_types)
diff --git a/hw/usb/imx-usbmisc.c b/hw/usb/imx-usbmisc.c
new file mode 100644
index 0000000..183b614
--- /dev/null
+++ b/hw/usb/imx-usbmisc.c
@@ -0,0 +1,80 @@
+/*
+ * i.MX USB non-core control registers.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/usb/imx-usbmisc.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+
+static uint64_t imx_usbmisc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    IMXUSBMiscState *s = opaque;
+
+    return s->regs[addr / 4];
+}
+
+static void imx_usbmisc_write(void *opaque, hwaddr addr, uint64_t value,
+                              unsigned size)
+{
+    IMXUSBMiscState *s = opaque;
+
+    s->regs[addr / 4] = value;
+}
+
+static const MemoryRegionOps imx_usbmisc_ops = {
+    .read = imx_usbmisc_read,
+    .write = imx_usbmisc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void imx_usbmisc_reset(DeviceState *dev)
+{
+    IMXUSBMiscState *s = IMX_USBMISC(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+}
+
+static void imx_usbmisc_init(Object *obj)
+{
+    IMXUSBMiscState *s = IMX_USBMISC(obj);
+
+    memory_region_init_io(&s->iomem, obj, &imx_usbmisc_ops, s,
+                          TYPE_IMX_USBMISC, 0x200);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+}
+
+static const VMStateDescription imx_usbmisc_vmstate = {
+    .name = TYPE_IMX_USBMISC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, IMXUSBMiscState, 0x200 / 4),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx_usbmisc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, imx_usbmisc_reset);
+    dc->vmsd = &imx_usbmisc_vmstate;
+    dc->desc = "i.MX USB non-core registers";
+}
+
+static const TypeInfo imx_usbmisc_info = {
+    .name = TYPE_IMX_USBMISC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMXUSBMiscState),
+    .instance_init = imx_usbmisc_init,
+    .class_init = imx_usbmisc_class_init,
+};
+
+static void imx_usbmisc_register_types(void)
+{
+    type_register_static(&imx_usbmisc_info);
+}
+
+type_init(imx_usbmisc_register_types)

diff --git a/include/hw/usb/cihdrc-udc.h b/include/hw/usb/cihdrc-udc.h
new file mode 100644
index 0000000..96b5d5c
--- /dev/null
+++ b/include/hw/usb/cihdrc-udc.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef CIHDRC_UDC_H
+#define CIHDRC_UDC_H
+
+#include "hw/core/sysbus.h"
+#include "chardev/char-fe.h"
+
+#define TYPE_CIHDRC_UDC "cihdrc-udc"
+OBJECT_DECLARE_SIMPLE_TYPE(CIHDRCUDCState, CIHDRC_UDC)
+
+#define CIHDRC_EP_COUNT 4
+#define CIHDRC_MAX_DATA 65536
+
+struct CIHDRCUDCState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    CharFrontend chr;
+    char *hostchar;
+    uint32_t regs[0x200 / 4];
+    uint32_t td[CIHDRC_EP_COUNT * 2];
+    uint32_t offset[CIHDRC_EP_COUNT * 2];
+    bool connected;
+    bool high_speed;
+    bool setup_pending;
+    uint8_t setup[8];
+    char line[2 * CIHDRC_MAX_DATA + 32];
+    unsigned line_len;
+    bool discard_line;
+};
+
+#endif

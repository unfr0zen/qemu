 hw/misc/meson.build          |   1 +
 hw/misc/spinel_ncp.c         | 409 +++++++++++++++++++++++++++++++++++
 include/hw/misc/spinel_ncp.h |  18 ++
 4 files changed, 432 insertions(+)
 create mode 100644 hw/misc/spinel_ncp.c
 create mode 100644 include/hw/misc/spinel_ncp.h


From 95a54781ebb9eb1923eaaaba0935ce9b2d77faf3 Mon Sep 17 00:00:00 2001
From: will <will-tm@users.noreply.github.com>
Date: Sun, 27 Sep 2026 15:06:50 -0400
Subject: [PATCH 26/36] hw/display: an LM3695 backlight driver for the
 flintstone's panel

The board's backlight driver sits on i2c2 at 0x63 (the DT's lm3695@63).
The vendor lm3695_bl driver reprograms it on every brightness change,
which nlclient makes whenever the ambient light sensor reports; with no
device there each change failed. A register file that ACKs and stores
everything is all the driver needs.
---
 hw/arm/Kconfig         |  1 +
 hw/arm/flintstone.c    |  3 ++
 hw/display/Kconfig     |  4 ++
 hw/display/lm3695.c    | 92 ++++++++++++++++++++++++++++++++++++++++++
 hw/display/meson.build |  1 +
 5 files changed, 101 insertions(+)
 create mode 100644 hw/display/lm3695.c

diff --git a/hw/arm/Kconfig b/hw/arm/Kconfig
index 8128417..2246ce6 100644
--- a/hw/arm/Kconfig
+++ b/hw/arm/Kconfig
@@ -204,6 +204,7 @@ config FLINTSTONE
     depends on TCG && ARM
     select FSL_IMX6SX
     select BCM43341
+    select LM3695
 
 config STELLARIS
     bool

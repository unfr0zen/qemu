+/*
+ * The open AP from "ssid" and "channel" first, then "aps":
+ * "SSID:channel:rssi:passphrase;..." where an empty passphrase is an open
+ * network, "*" a WPA2 one that takes none, and anything else (8 to 63
+ * characters, may hold ':') a WPA2-PSK one. BSSIDs count up from the
+ * open AP's, which is locally administered and stable across boots.
+ */
+static bool bcm_add_ap(BCM43341State *s, const char *ssid, unsigned channel,
+                       int rssi, const char *pass, Error **errp)
+{
+    BCMAp *ap = &s->aps[s->num_aps];
+    size_t plen = pass ? strlen(pass) : 0;
+
+    if (s->num_aps == BCM_MAX_APS) {
+        error_setg(errp, "bcm43341: at most %d access points", BCM_MAX_APS);
+        return false;
+    }
+    if (!*ssid || strlen(ssid) > 32 || channel < 1 || channel > 13 ||
+        rssi < -100 || rssi > -20 ||
+        (plen && strcmp(pass, "*") && (plen < 8 || plen > 63))) {
+        error_setg(errp, "bcm43341: bad access point \"%s\" (an SSID of 1-32 "
+                   "bytes, channel 1-13, RSSI -100..-20, a passphrase of "
+                   "8-63 characters, empty or *)", ssid);
+        return false;
+    }
+    memset(ap, 0, sizeof(*ap));
+    pstrcpy(ap->ssid, sizeof(ap->ssid), ssid);
+    memcpy(ap->bssid, "\x02\x43\x34\x10\x00\x01", 6);
+    ap->bssid[5] += s->num_aps;
+    ap->channel = channel;
+    ap->rssi = rssi;
+    ap->psk = plen;
+    ap->reject = plen && !strcmp(pass, "*");
+    if (ap->psk && !ap->reject) {
+        bcm_psk_to_pmk(pass, ssid, ap->pmk);
+    }
+    s->num_aps++;
+    return true;
+}
+
+static bool bcm_parse_aps(BCM43341State *s, Error **errp)
+{
+    g_auto(GStrv) aps = g_strsplit(s->aps_prop ? s->aps_prop : "", ";", -1);
+
+    s->num_aps = 0;
+    if (!bcm_add_ap(s, s->ssid, s->channel, -40, NULL, errp)) {
+        return false;
+    }
+    for (char **a = aps; *a; a++) {
+        g_auto(GStrv) f = g_strsplit(*a, ":", 4);
+        int64_t ch, rssi;
+
+        if (!**a) {
+            continue;
+        }
+        if (g_strv_length(f) < 3 || qemu_strtoi64(f[1], NULL, 10, &ch) ||
+            qemu_strtoi64(f[2], NULL, 10, &rssi)) {
+            error_setg(errp, "bcm43341: aps entry \"%s\" is not "
+                       "SSID:channel:rssi[:passphrase]", *a);
+            return false;
+        }
+        if (!bcm_add_ap(s, f[0], MIN(ch, 255), MAX(MIN(rssi, 0), -128),
+                        f[3], errp)) {
+            return false;
+        }
+    }
+    return true;
+}

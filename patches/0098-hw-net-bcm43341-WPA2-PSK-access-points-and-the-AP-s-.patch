+/* -- WPA2: the AP's side of the 4-way handshake --------------------------- */
+
+static void bcm_hmac_sha1(const uint8_t *key, size_t klen,
+                          const struct iovec *iov, size_t niov,
+                          uint8_t out[20])
+{
+    g_autoptr(QCryptoHmac) h = qcrypto_hmac_new(QCRYPTO_HASH_ALGO_SHA1, key,
+                                                klen, &error_abort);
+    size_t olen = 20;
+
+    qcrypto_hmac_bytesv(h, iov, niov, &out, &olen, &error_abort);
+}
+
+/*
+ * PMK = PBKDF2-HMAC-SHA1(passphrase, ssid, 4096, 32). Built on qcrypto's
+ * HMAC, which every crypto backend has, unlike qcrypto_pbkdf2.
+ */
+static void bcm_psk_to_pmk(const char *pass, const char *ssid,
+                           uint8_t pmk[32])
+{
+    for (uint32_t blk = 1; blk <= 2; blk++) {
+        uint8_t cnt[4], u[20], t[20];
+        struct iovec iov[2] = {
+            { (void *)ssid, strlen(ssid) }, { cnt, 4 },
+        };
+
+        stl_be_p(cnt, blk);
+        bcm_hmac_sha1((const uint8_t *)pass, strlen(pass), iov, 2, u);
+        memcpy(t, u, 20);
+        for (int i = 1; i < 4096; i++) {
+            struct iovec ui = { u, 20 };
+
+            bcm_hmac_sha1((const uint8_t *)pass, strlen(pass), &ui, 1, u);
+            for (int j = 0; j < 20; j++) {
+                t[j] ^= u[j];
+            }
+        }
+        memcpy(pmk + 20 * (blk - 1), t, blk == 1 ? 20 : 12);
+    }
+}
+
+/* PTK = PRF-384(PMK, "Pairwise key expansion", AA/SPA, ANonce/SNonce) */
+static void bcm_derive_ptk(BCM43341State *s, const uint8_t *snonce)
+{
+    static const char label[] = "Pairwise key expansion";
+    const uint8_t *aa = s->aps[s->cur].bssid, *spa = s->mac;
+    bool alo = memcmp(aa, spa, 6) < 0;
+    bool nlo = memcmp(s->anonce, snonce, 32) < 0;
+    uint8_t data[76], out[60], i;
+    struct iovec iov[3] = {
+        { (void *)label, sizeof(label) }, { data, sizeof(data) }, { &i, 1 },
+    };
+
+    memcpy(data, alo ? aa : spa, 6);
+    memcpy(data + 6, alo ? spa : aa, 6);
+    memcpy(data + 12, nlo ? s->anonce : snonce, 32);
+    memcpy(data + 44, nlo ? snonce : s->anonce, 32);
+    for (i = 0; i < 3; i++) {
+        bcm_hmac_sha1(s->aps[s->cur].pmk, 32, iov, 3, out + 20 * i);
+    }
+    memcpy(s->ptk, out, sizeof(s->ptk));
+}
+
+/* The MIC of an EAPOL frame (EAPOL header on), with its MIC field zero. */
+static void bcm_eapol_mic(BCM43341State *s, const uint8_t *f, size_t len,
+                          uint8_t mic[16])
+{
+    g_autofree uint8_t *c = g_memdup2(f, len);
+    uint8_t out[20];
+    struct iovec iov = { c, len };
+
+    memset(c + EAPOL_KEY_MIC, 0, 16);
+    bcm_hmac_sha1(s->ptk, 16, &iov, 1, out);
+    memcpy(mic, out, 16);
+}
+
+/* AES Key Wrap (RFC 3394) with the KEK; len a multiple of 8, out len + 8. */
+static void bcm_aes_wrap(BCM43341State *s, const uint8_t *in, size_t len,
+                         uint8_t *out)
+{
+    g_autoptr(QCryptoCipher) c =
+        qcrypto_cipher_new(QCRYPTO_CIPHER_ALGO_AES_128,
+                           QCRYPTO_CIPHER_MODE_ECB, s->ptk + 16, 16,
+                           &error_abort);
+    size_t n = len / 8;
+    uint8_t b[16];
+
+    memset(out, 0xa6, 8);
+    memcpy(out + 8, in, len);
+    for (unsigned j = 0; j < 6; j++) {
+        for (size_t i = 1; i <= n; i++) {
+            memcpy(b, out, 8);
+            memcpy(b + 8, out + 8 * i, 8);
+            qcrypto_cipher_encrypt(c, b, b, 16, &error_abort);
+            stq_be_p(out, ldq_be_p(b) ^ (n * j + i));
+            memcpy(out + 8 * i, b + 8, 8);
+        }
+    }
+}
+
+/* An EAPOL-Key frame from the AP to the host, MIC'd with the KCK if asked. */
+static void bcm_eapol_send(BCM43341State *s, uint16_t info,
+                           const uint8_t *data, size_t dlen)
+{
+    size_t len = 14 + EAPOL_KEY_LEN + dlen;
+    g_autofree uint8_t *f = g_malloc0(len);
+    uint8_t *e = f + 14;
+
+    memcpy(f, s->mac, 6);
+    memcpy(f + 6, s->aps[s->cur].bssid, 6);
+    stw_be_p(f + 12, ETHER_TYPE_EAPOL);
+    e[0] = 2;                                   /* 802.1X-2004 */
+    e[1] = 3;                                   /* EAPOL-Key */
+    stw_be_p(e + 2, EAPOL_KEY_LEN - 4 + dlen);
+    e[4] = 2;                                   /* RSN key descriptor */
+    stw_be_p(e + 5, info);
+    stw_be_p(e + 7, 16);                        /* CCMP key length */
+    stq_be_p(e + EAPOL_KEY_REPLAY, s->replay);
+    memcpy(e + EAPOL_KEY_NONCE, s->anonce, 32);
+    stw_be_p(e + EAPOL_KEY_DATA_LEN, dlen);
+    memcpy(e + EAPOL_KEY_LEN, data, dlen);
+    if (info & WPA_KEY_INFO_MIC) {
+        bcm_eapol_mic(s, e, EAPOL_KEY_LEN + dlen, e + EAPOL_KEY_MIC);
+    }
+    bcm_queue_bdc(s, SDPCM_DATA_CHANNEL, f, len);
+}
+
+static void bcm_send_msg1(BCM43341State *s)
+{
+    s->replay++;
+    bcm_eapol_send(s, WPA_KEY_INFO_HMAC_SHA1_AES | WPA_KEY_INFO_PAIRWISE |
+                   WPA_KEY_INFO_ACK, NULL, 0);
+}
+
+/* msg3: the RSN IE and, AES-wrapped with the KEK, a GTK KDE. */
+static void bcm_send_msg3(BCM43341State *s)
+{
+    uint8_t kd[48], wrapped[56];
+    size_t n = 0;
+
+    memcpy(kd, bcm_rsn_ie, sizeof(bcm_rsn_ie));
+    n += sizeof(bcm_rsn_ie);
+    kd[n++] = 0xdd;                             /* GTK KDE */
+    kd[n++] = 6 + sizeof(s->gtk);
+    memcpy(kd + n, "\x00\x0f\xac\x01", 4);
+    n += 4;
+    kd[n++] = 1;                                /* key id 1 */
+    kd[n++] = 0;
+    memcpy(kd + n, s->gtk, sizeof(s->gtk));
+    n += sizeof(s->gtk);
+    kd[n++] = 0xdd;                             /* padding to 8 bytes */
+    kd[n++] = 0;
+    assert(n == sizeof(kd));
+    bcm_aes_wrap(s, kd, n, wrapped);
+
+    s->replay++;
+    bcm_eapol_send(s, WPA_KEY_INFO_HMAC_SHA1_AES | WPA_KEY_INFO_PAIRWISE |
+                   WPA_KEY_INFO_INSTALL | WPA_KEY_INFO_ACK |
+                   WPA_KEY_INFO_MIC | WPA_KEY_INFO_SECURE |
+                   WPA_KEY_INFO_ENC_DATA, wrapped, sizeof(wrapped));
+}
+
+static void bcm_hs_reset(BCM43341State *s)
+{
+    timer_del(s->hs_timer);
+    s->hs_state = 0;
+    s->authorized = false;
+}
+
+/* Resend msg1 or msg3, or give up and deauth the station. */
+static void bcm_hs_timeout(void *opaque)
+{
+    BCM43341State *s = opaque;
+    const uint8_t *bssid = s->aps[s->cur].bssid;
+
+    if (!s->fw_running || !s->associated || !s->hs_state) {
+        return;
+    }
+    if (s->hs_tries >= BCM_HS_TRIES) {
+        BCM_TRACE(s, "4-way handshake timed out");
+        bcm_hs_reset(s);
+        s->associated = false;
+        bcm_send_event(s, WLC_E_DEAUTH_IND, WLC_E_STATUS_SUCCESS,
+                       DOT11_RC_4WAY_HANDSHAKE_TIMEOUT, 0, bssid, NULL, 0);
+        bcm_send_event(s, WLC_E_LINK, WLC_E_STATUS_SUCCESS,
+                       DOT11_RC_4WAY_HANDSHAKE_TIMEOUT, 0, bssid, NULL, 0);
+        return;
+    }
+    s->hs_tries++;
+    if (s->hs_state == 1) {
+        bcm_send_msg1(s);
+    } else {
+        bcm_send_msg3(s);
+    }
+    timer_mod(s->hs_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1000);
+}
+
+static void bcm_hs_start(BCM43341State *s)
+{
+    qemu_guest_getrandom_nofail(s->anonce, sizeof(s->anonce));
+    qemu_guest_getrandom_nofail(s->gtk, sizeof(s->gtk));
+    s->authorized = false;
+    s->hs_state = 1;
+    s->hs_tries = 0;
+    /* msg1 once the host has seen the link come up */
+    timer_mod(s->hs_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 100);
+}
+
+/* An EAPOL frame from the host (EAPOL header on): msg2 or msg4. */
+static void bcm_eapol_rx(BCM43341State *s, const uint8_t *e, size_t len)
+{
+    uint8_t mic[16];
+    uint16_t info;
+
+    if (len < EAPOL_KEY_LEN || e[1] != 3 || e[4] != 2 || !s->hs_state) {
+        return;
+    }
+    len = MIN(len, 4 + (size_t)lduw_be_p(e + 2));
+    if (len < EAPOL_KEY_LEN || ldq_be_p(e + EAPOL_KEY_REPLAY) != s->replay) {
+        BCM_TRACE(s, "EAPOL-Key with a stale replay counter dropped");
+        return;
+    }
+    info = lduw_be_p(e + 5);
+    if (!(info & WPA_KEY_INFO_MIC)) {
+        return;
+    }
+    if (s->hs_state == 1 && !(info & WPA_KEY_INFO_SECURE)) {
+        bcm_derive_ptk(s, e + EAPOL_KEY_NONCE);
+    } else if (s->hs_state != 2 || !(info & WPA_KEY_INFO_SECURE)) {
+        return;
+    }
+    bcm_eapol_mic(s, e, len, mic);
+    if (s->aps[s->cur].reject ||
+        memcmp(mic, e + EAPOL_KEY_MIC, sizeof(mic))) {
+        BCM_TRACE(s, "msg%u MIC mismatch: wrong passphrase",

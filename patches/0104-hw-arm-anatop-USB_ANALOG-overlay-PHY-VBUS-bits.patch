diff --git a/hw/display/imx_lcdif.c b/hw/display/imx_lcdif.c
new file mode 100644
index 0000000..f9c7253
--- /dev/null
+++ b/hw/display/imx_lcdif.c
@@ -0,0 +1,314 @@
+/*
+ * i.MX6SX LCDIF (eLCDIF / i.MX28-style display controller) emulation.
+ *
+ * lcdif@02220000 drives the board's HX8357 panel — 480x640, RGB888 over a
+ * 24 bit bus, panel init commands going over ECSPI1 (modeled elsewhere).
+ * Only the scanout side lives here: once the driver sets CTRL.RUN, the
+ * hardware DMAs the frame from CUR_BUF every dotclock period, so the model
+ * tracks the register state the 4.1.15 mxsfb driver programs and copies the
+ * current frame into a QEMU graphic console on every update. The panel
+ * timing is not simulated; a screendump (or any repaint) just reads the
+ * freshest frame.
+ *
+ * What the driver touches, from drivers/video/fbdev/mxsfb.c v4.1:
+ *   - CTRL (+0x00, set/clear aliases at +4/+8): SFTRST, CLKGATE,
+ *     WORD_LENGTH, BUS_WIDTH, DOTCLK_MODE, RUN.
+ *   - CTRL1 (+0x10): BYTE_PACKAGING, FIFO_CLEAR, and the IRQ enable/status
+ *     pairs: pan waits (500 ms) for CUR_FRAME_DONE, FBIO_WAITFORVSYNC (1 s)
+ *     for VSYNC_EDGE, and the handler clears status and enable (SET/CLR).
+ *   - TRANSFER_COUNT (+0x30): VCOUNT << 16 | HCOUNT — the frame geometry.
+ *   - CUR_BUF (+0x40) / NEXT_BUF (+0x50): the DMA addresses; the driver
+ *     only ever writes NEXT_BUF (pan), the hardware flips it at frame end.
+ *   - TIMING, VDCTRL0..4, DVICTRL*, DEBUG0: stored, nothing reads them.
+ * While RUN is set a frame ends every 1/60 s of virtual time: NEXT_BUF
+ * moves to CUR_BUF and CUR_FRAME_DONE + VSYNC_EDGE latch in CTRL1; the IRQ
+ * is the OR of the enabled status bits.
+ *
+ * Pixel formats: WORD_LENGTH 3 = 32 bpp RGB888 unpacked (one u32 per
+ * pixel, B in byte 0, G in 1, R in 2 — QEMU's x8r8g8b8), WORD_LENGTH 0 =
+ * 16 bpp RGB565 (QEMU's r5g6b5). Both copy straight from guest memory.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "ui/console.h"
+#include "ui/surface.h"
+#include "hw/display/imx_lcdif.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "system/address-spaces.h"
+
+/* Register offsets (mxsfb.c v4.1, LCDC_*) */
+#define LCDC_CTRL           0x00
+#define LCDC_CTRL_SET       0x04
+#define LCDC_CTRL_CLR       0x08
+#define LCDC_CTRL1          0x10
+#define LCDC_CTRL1_SET      0x14
+#define LCDC_CTRL1_CLR      0x18
+#define LCDC_CTRL2          0x20
+#define LCDC_CTRL2_SET      0x24
+#define LCDC_CTRL2_CLR      0x28
+#define LCDC_TRANSFER_COUNT 0x30
+#define LCDC_CUR_BUF        0x40
+#define LCDC_NEXT_BUF       0x50
+#define LCDC_TIMING         0x60
+#define LCDC_VDCTRL0        0x70
+#define LCDC_VDCTRL1        0x80
+#define LCDC_VDCTRL2        0x90
+#define LCDC_VDCTRL3        0xa0
+#define LCDC_VDCTRL4        0xb0
+#define LCDC_DVICTRL0       0xc0    /* ..0xf0 */
+
+/* CTRL bits (mxsfb.h) */
+#define CTRL_SFTRST         (1u << 31)
+#define CTRL_CLKGATE        (1u << 30)
+#define CTRL_GET_WORD_LENGTH(x) (((x) >> 8) & 0x3)
+#define CTRL_DOTCLK_MODE    (1u << 17)
+#define CTRL_RUN            (1u << 0)
+
+/* CTRL1 IRQ bits: status at 11..8, the matching enables at 15..12 */
+#define CTRL1_CUR_FRAME_DONE_IRQ    (1u << 9)
+#define CTRL1_VSYNC_EDGE_IRQ        (1u << 8)
+#define CTRL1_IRQ_STATUS_SHIFT      8
+#define CTRL1_IRQ_ENABLE_SHIFT      12
+
+#define LCDIF_FRAME_NS  (NANOSECONDS_PER_SECOND / 60)
+
+#define VDCTRL4_SYNC_SIGNALS_ON (1u << 18)
+
+/* Bounds sanity: the panel is 480x640, anything past 2048 is a lost guest. */
+#define LCDIF_MAX_DIM   2048
+
+static bool lcdif_running(ImxLcdifState *s)
+{
+    uint32_t ctrl = s->regs[LCDC_CTRL / 4];
+
+    return (ctrl & CTRL_RUN) && (ctrl & CTRL_DOTCLK_MODE) &&
+           !(ctrl & (CTRL_SFTRST | CTRL_CLKGATE));
+}
+
+static void lcdif_update_irq(ImxLcdifState *s)
+{
+    uint32_t ctrl1 = s->regs[LCDC_CTRL1 / 4];
+
+    qemu_set_irq(s->irq, (ctrl1 >> CTRL1_IRQ_STATUS_SHIFT) &
+                         (ctrl1 >> CTRL1_IRQ_ENABLE_SHIFT) & 0xf);
+}
+
+/* Frame end: flip to the buffer the driver queued, latch the status bits. */
+static void lcdif_frame_end(void *opaque)
+{
+    ImxLcdifState *s = opaque;
+
+    if (!lcdif_running(s)) {
+        return;
+    }
+    if (s->regs[LCDC_NEXT_BUF / 4]) {
+        s->regs[LCDC_CUR_BUF / 4] = s->regs[LCDC_NEXT_BUF / 4];
+    }
+    s->regs[LCDC_CTRL1 / 4] |= CTRL1_CUR_FRAME_DONE_IRQ | CTRL1_VSYNC_EDGE_IRQ;
+    lcdif_update_irq(s);
+    timer_mod(s->frame_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + LCDIF_FRAME_NS);
+}
+
+static void lcdif_invalidate(void *opaque)
+{
+    ImxLcdifState *s = opaque;
+
+    s->invalidate = true;
+}
+
+/*
+ * Copy the current frame into the console surface. The geometry and format
+ * come from the registers the driver programmed; the frame is read from the
+ * guest in one go (its byte layout matches the surface's for both formats
+ * we support, so the copy is direct).
+ */
+static void lcdif_update_display(void *opaque)
+{
+    ImxLcdifState *s = opaque;
+    DisplaySurface *surface;
+    uint32_t tc = s->regs[LCDC_TRANSFER_COUNT / 4];
+    int width = tc & 0xffff;
+    int height = tc >> 16;
+    int bpp;
+    hwaddr frame;
+
+    if (!lcdif_running(s)) {
+        return;
+    }
+
+    switch (CTRL_GET_WORD_LENGTH(s->regs[LCDC_CTRL / 4])) {
+    case 3:
+        bpp = 4;                    /* RGB888 unpacked -> x8r8g8b8 */
+        break;
+    case 0:
+        bpp = 2;                    /* RGB565 -> r5g6b5 */
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "imx.lcdif: unsupported word length %u\n",
+                      CTRL_GET_WORD_LENGTH(s->regs[LCDC_CTRL / 4]));
+        return;
+    }
+
+    if (width == 0 || height == 0 ||
+        width > LCDIF_MAX_DIM || height > LCDIF_MAX_DIM) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "imx.lcdif: bogus transfer count 0x%08x\n", tc);
+        return;
+    }
+
+    frame = s->regs[LCDC_CUR_BUF / 4];
+    if (!frame) {
+        return;
+    }
+
+    qemu_console_resize(s->con, width, height);
+    surface = qemu_console_surface(s->con);
+    if (!surface || surface_bits_per_pixel(surface) != bpp * 8) {
+        return;
+    }
+
+    address_space_read(&address_space_memory, frame,
+                       MEMTXATTRS_UNSPECIFIED, surface_data(surface),
+                       (size_t)width * height * bpp);
+    dpy_gfx_update(s->con, 0, 0, width, height);
+}
+
+static const GraphicHwOps imx_lcdif_gfx_ops = {
+    .invalidate = lcdif_invalidate,
+    .gfx_update = lcdif_update_display,
+};
+
+static uint64_t imx_lcdif_read(void *opaque, hwaddr off, unsigned size)
+{
+    ImxLcdifState *s = IMX_LCDIF(opaque);
+    uint32_t val = 0;
+
+    if (off < sizeof(s->regs)) {
+        /* The set/clear aliases read back the same register. */
+        val = s->regs[(off & ~0xc) / 4];
+    }
+    return val;
+}
+
+static void imx_lcdif_write(void *opaque, hwaddr off, uint64_t val,
+                            unsigned size)
+{
+    ImxLcdifState *s = IMX_LCDIF(opaque);
+    bool was_running = lcdif_running(s);
+
+    if (off >= sizeof(s->regs)) {
+        return;
+    }
+    switch (off) {
+    case LCDC_CTRL_SET:
+    case LCDC_CTRL1_SET:
+    case LCDC_CTRL2_SET:
+        s->regs[(off - 4) / 4] |= val;
+        break;
+
+    case LCDC_CTRL_CLR:
+    case LCDC_CTRL1_CLR:
+    case LCDC_CTRL2_CLR:
+        s->regs[(off - 8) / 4] &= ~val;
+        break;
+
+    default:
+        s->regs[off / 4] = val;
+        break;
+    }
+
+    if (off == LCDC_CTRL_SET && (val & CTRL_RUN)) {
+        /* Starting from reset, the frame comes out of NEXT_BUF. */
+        if (!s->regs[LCDC_CUR_BUF / 4]) {
+            s->regs[LCDC_CUR_BUF / 4] = s->regs[LCDC_NEXT_BUF / 4];
+        }
+    }
+    if (was_running != lcdif_running(s)) {
+        s->invalidate = true;
+        if (lcdif_running(s)) {
+            timer_mod(s->frame_timer,
+                      qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + LCDIF_FRAME_NS);
+        } else {
+            timer_del(s->frame_timer);
+        }
+    }
+    if ((off & ~0xc) == LCDC_CTRL1) {
+        lcdif_update_irq(s);
+    }
+}
+
+static const MemoryRegionOps imx_lcdif_ops = {
+    .read = imx_lcdif_read,
+    .write = imx_lcdif_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static const VMStateDescription vmstate_imx_lcdif = {
+    .name = TYPE_IMX_LCDIF,
+    .version_id = 2,
+    .minimum_version_id = 2,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, ImxLcdifState, IMX_LCDIF_REG_SIZE / 4),
+        VMSTATE_BOOL(invalidate, ImxLcdifState),
+        VMSTATE_TIMER_PTR(frame_timer, ImxLcdifState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx_lcdif_reset(DeviceState *dev)
+{
+    ImxLcdifState *s = IMX_LCDIF(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->invalidate = true;
+    timer_del(s->frame_timer);
+    qemu_irq_lower(s->irq);
+}
+
+static void imx_lcdif_realize(DeviceState *dev, Error **errp)
+{
+    ImxLcdifState *s = IMX_LCDIF(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(dev), &imx_lcdif_ops, s,
+                          TYPE_IMX_LCDIF, IMX_LCDIF_REG_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+
+    s->con = graphic_console_init(dev, 0, &imx_lcdif_gfx_ops, s);
+    s->frame_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, lcdif_frame_end, s);
+}
+
+static void imx_lcdif_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = imx_lcdif_realize;
+    device_class_set_legacy_reset(dc, imx_lcdif_reset);
+    dc->vmsd = &vmstate_imx_lcdif;
+    dc->desc = "i.MX LCDIF display controller";
+}
+
+static const TypeInfo imx_lcdif_info = {
+    .name = TYPE_IMX_LCDIF,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ImxLcdifState),
+    .class_init = imx_lcdif_class_init,
+};
+
+static void imx_lcdif_register_types(void)
+{
+    type_register_static(&imx_lcdif_info);
+}
+
+type_init(imx_lcdif_register_types)
diff --git a/hw/display/lm3530.c b/hw/display/lm3530.c
new file mode 100644
index 0000000..366bb3e
--- /dev/null
+++ b/hw/display/lm3530.c
@@ -0,0 +1,110 @@
+/*
+ * TI LM3530 backlight driver (i2c) - a register file
+ *
+ * The j49's panel backlight sits on i2c3 at 0x36 (board-diamond.c's
+ * "lm3530-backlight", manual mode). The vendor kernel's lm3530_bl driver
+ * writes its configuration at probe and the brightness register on every
+ * change, and reads nothing back in manual mode, so an 8-bit register
+ * file with auto-increment that ACKs everything is all it needs; nothing
+ * is drawn from the brightness.
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/i2c.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define TYPE_LM3530 "lm3530"
+OBJECT_DECLARE_SIMPLE_TYPE(LM3530State, LM3530)
+
+struct LM3530State {
+    I2CSlave i2c;
+
+    uint8_t regs[256];
+    uint8_t cur;        /* register being addressed */
+    bool first_byte;    /* next send() byte is a register address */
+};
+
+static int lm3530_event(I2CSlave *i2c, enum i2c_event event)
+{
+    LM3530State *s = LM3530(i2c);
+
+    if (event == I2C_START_SEND || event == I2C_START_SEND_ASYNC) {
+        s->first_byte = true;
+    }
+    return 0;
+}
+
+static int lm3530_send(I2CSlave *i2c, uint8_t data)
+{
+    LM3530State *s = LM3530(i2c);
+
+    if (s->first_byte) {
+        s->cur = data;
+        s->first_byte = false;
+    } else {
+        s->regs[s->cur++] = data;
+    }
+    return 0;
+}
+
+static uint8_t lm3530_recv(I2CSlave *i2c)
+{
+    LM3530State *s = LM3530(i2c);
+
+    return s->regs[s->cur++];
+}
+
+static void lm3530_reset(DeviceState *dev)
+{
+    LM3530State *s = LM3530(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->cur = 0;
+    s->first_byte = false;
+}
+
+static const VMStateDescription lm3530_vmstate = {
+    .name = TYPE_LM3530,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(i2c, LM3530State),
+        VMSTATE_UINT8_ARRAY(regs, LM3530State, 256),
+        VMSTATE_UINT8(cur, LM3530State),
+        VMSTATE_BOOL(first_byte, LM3530State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void lm3530_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, lm3530_reset);
+    dc->vmsd = &lm3530_vmstate;
+    dc->desc = "TI LM3530 backlight driver";
+    k->event = lm3530_event;
+    k->send = lm3530_send;
+    k->recv = lm3530_recv;
+}
+
+static const TypeInfo lm3530_info = {
+    .name = TYPE_LM3530,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(LM3530State),
+    .class_init = lm3530_class_init,
+};
+
+static void lm3530_register_types(void)
+{
+    type_register_static(&lm3530_info);
+}
+
+type_init(lm3530_register_types)

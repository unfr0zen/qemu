diff --git a/hw/i2c/omap3_i2c.c b/hw/i2c/omap3_i2c.c
new file mode 100644
index 0000000..b0d0228
--- /dev/null
+++ b/hw/i2c/omap3_i2c.c
@@ -0,0 +1,425 @@
+/*
+ * OMAP3 I2C controller (master mode, with the FIFO)
+ *
+ * Transfers happen at bus speed zero: a start addresses the slave at once,
+ * each byte written to I2C_DATA goes straight to the slave, and a receive
+ * fills the RX FIFO from the slave as it drains. The FIFO status follows
+ * the thresholds in I2C_BUF the way Linux's i2c-omap uses them on OMAP3:
+ * XRDY/RRDY while a whole threshold's worth can move, XDR/RDR to drain the
+ * tail (with BUFSTAT's counts), ARDY once the transfer is done, NACK when
+ * the slave does not answer. U-Boot polls the same bits with thresholds of
+ * one byte.
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/omap3_i2c.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define I2C_REV         0x00
+#define I2C_IE          0x04
+#define I2C_STAT        0x08
+#define I2C_WE          0x0c
+#define I2C_SYSS        0x10
+#define I2C_BUF         0x14
+#define I2C_CNT         0x18
+#define I2C_DATA        0x1c
+#define I2C_SYSC        0x20
+#define I2C_CON         0x24
+#define I2C_OA0         0x28
+#define I2C_SA          0x2c
+#define I2C_PSC         0x30
+#define I2C_SCLL        0x34
+#define I2C_SCLH        0x38
+#define I2C_SYSTEST     0x3c
+#define I2C_BUFSTAT     0x40
+#define I2C_OA1         0x44
+#define I2C_OA2         0x48
+#define I2C_OA3         0x4c
+#define I2C_ACTOA       0x50
+#define I2C_SBLOCK      0x54
+
+#define STAT_AL         (1 << 0)
+#define STAT_NACK       (1 << 1)
+#define STAT_ARDY       (1 << 2)
+#define STAT_RRDY       (1 << 3)
+#define STAT_XRDY       (1 << 4)
+#define STAT_BF         (1 << 8)
+#define STAT_BB         (1 << 12)
+#define STAT_RDR        (1 << 13)
+#define STAT_XDR        (1 << 14)
+#define STAT_LATCHED    0x0ee7      /* events software acknowledges */
+
+#define CON_STT         (1 << 0)
+#define CON_STP         (1 << 1)
+#define CON_TRX         (1 << 9)
+#define CON_MST         (1 << 10)
+#define CON_EN          (1 << 15)
+
+#define BUF_TXFIFO_CLR  (1 << 6)
+#define BUF_RXFIFO_CLR  (1 << 14)
+
+static uint32_t i2c_xthr(Omap3I2cState *s)
+{
+    return (s->buf & 0x3f) + 1;
+}
+
+static uint32_t i2c_rthr(Omap3I2cState *s)
+{
+    return ((s->buf >> 8) & 0x3f) + 1;
+}
+
+static uint16_t i2c_stat(Omap3I2cState *s)
+{
+    uint16_t st = s->stat;
+
+    if (s->active) {
+        st |= STAT_BB;
+        if (!s->receiving && s->remaining) {
+            st |= s->remaining >= i2c_xthr(s) ? STAT_XRDY : STAT_XDR;
+        } else if (s->receiving && s->rx_count) {
+            if (s->rx_count >= i2c_rthr(s)) {
+                st |= STAT_RRDY;
+            } else if (!s->remaining) {
+                st |= STAT_RDR;
+            }
+        }
+    } else {
+        st |= STAT_BF;
+    }
+    return st;
+}
+
+static void i2c_update_irq(Omap3I2cState *s)
+{
+    qemu_set_irq(s->irq, !!(i2c_stat(s) & s->ie));
+}
+
+static void i2c_stop(Omap3I2cState *s)
+{
+    if (s->active) {
+        i2c_end_transfer(s->bus);
+        s->active = false;
+    }
+    s->con &= ~(CON_MST | CON_STT | CON_STP);
+}
+
+/* The transfer's bytes have all moved: report it, and stop if asked. */
+static void i2c_finish(Omap3I2cState *s)
+{
+    s->stat |= STAT_ARDY;
+    if (s->con & CON_STP) {
+        i2c_stop(s);
+    }
+}
+
+static void i2c_fill_rx(Omap3I2cState *s)
+{
+    while (s->remaining && s->rx_count < OMAP3_I2C_FIFO) {
+        s->rx_fifo[(s->rx_head + s->rx_count++) % OMAP3_I2C_FIFO] =
+            i2c_recv(s->bus);
+        s->remaining--;
+    }
+}
+
+static void i2c_start(Omap3I2cState *s)
+{
+    s->con &= ~CON_STT;
+    s->receiving = !(s->con & CON_TRX);
+    s->rx_head = s->rx_count = 0;
+    if (i2c_start_transfer(s->bus, s->sa & 0x7f, s->receiving)) {
+        s->stat |= STAT_NACK;
+        s->active = false;
+        i2c_end_transfer(s->bus);
+        return;
+    }
+    s->active = true;
+    s->remaining = s->cnt;
+    if (s->receiving) {
+        i2c_fill_rx(s);
+    }
+    if (!s->remaining && !s->rx_count) {
+        i2c_finish(s);
+    }
+}
+
+static void i2c_write_data(Omap3I2cState *s, uint8_t b)
+{
+    if (!s->active || s->receiving || !s->remaining) {
+        qemu_log_mask(LOG_GUEST_ERROR, "omap3-i2c: data written with no "
+                      "transmission in progress\n");
+        return;
+    }
+    s->remaining--;
+    if (i2c_send(s->bus, b)) {
+        s->stat |= STAT_NACK;
+        s->remaining = 0;
+        return;
+    }
+    if (!s->remaining) {
+        i2c_finish(s);
+    }
+}
+
+static uint8_t i2c_read_data(Omap3I2cState *s)
+{
+    uint8_t b;
+
+    if (!s->rx_count) {
+        return 0;
+    }
+    b = s->rx_fifo[s->rx_head];
+    s->rx_head = (s->rx_head + 1) % OMAP3_I2C_FIFO;
+    s->rx_count--;
+    i2c_fill_rx(s);
+    if (s->active && !s->remaining && !s->rx_count) {
+        i2c_finish(s);
+    }
+    return b;
+}
+
+static uint64_t i2c_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Omap3I2cState *s = opaque;
+    uint64_t v;
+
+    switch (addr) {
+    case I2C_REV:
+        return 0x40;
+    case I2C_IE:
+        return s->ie;
+    case I2C_STAT:
+        return i2c_stat(s);
+    case I2C_WE:
+        return s->we;
+    case I2C_SYSS:
+        return 1;                       /* RDONE */
+    case I2C_BUF:
+        return s->buf;
+    case I2C_CNT:
+        return s->cnt;
+    case I2C_DATA:
+        v = i2c_read_data(s);
+        i2c_update_irq(s);
+        return v;
+    case I2C_SYSC:
+        return s->sysc;
+    case I2C_CON:
+        return s->con;
+    case I2C_OA0:
+        return s->oa[0];
+    case I2C_SA:
+        return s->sa;
+    case I2C_PSC:
+        return s->psc;
+    case I2C_SCLL:
+        return s->scll;
+    case I2C_SCLH:
+        return s->sclh;
+    case I2C_SYSTEST:
+        return s->systest;
+    case I2C_BUFSTAT:
+        return (s->fifo_depth & 3) << 14 | MIN(s->rx_count, 63) << 8 |
+               (s->receiving ? 0 : MIN(s->remaining, 63));
+    case I2C_OA1:
+    case I2C_OA2:
+    case I2C_OA3:
+        return s->oa[(addr - I2C_OA1) / 4 + 1];
+    case I2C_ACTOA:
+    case I2C_SBLOCK:
+        return 0;
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "omap3-i2c: bad read at 0x%" HWADDR_PRIx "\n",
+                  addr);
+    return 0;
+}
+
+static void i2c_reset(DeviceState *dev)
+{
+    Omap3I2cState *s = OMAP3_I2C(dev);
+
+    if (s->active) {
+        i2c_end_transfer(s->bus);
+    }
+    s->ie = 0;
+    s->stat = 0;
+    s->we = 0;
+    s->buf = 0;
+    s->cnt = 0;
+    s->sysc = 0;
+    s->con = 0;
+    memset(s->oa, 0, sizeof(s->oa));
+    s->sa = 0x3ff;
+    s->psc = 0;
+    s->scll = 0;
+    s->sclh = 0;
+    s->systest = 0;
+    s->active = false;
+    s->receiving = false;
+    s->remaining = 0;
+    s->rx_head = s->rx_count = 0;
+    i2c_update_irq(s);
+}
+
+static void i2c_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    Omap3I2cState *s = opaque;
+
+    switch (addr) {
+    case I2C_IE:
+        s->ie = val & 0x7fff;
+        break;
+    case I2C_STAT:
+        s->stat &= ~(val & STAT_LATCHED);
+        break;
+    case I2C_WE:
+        s->we = val;
+        return;
+    case I2C_BUF:
+        if (val & BUF_RXFIFO_CLR) {
+            s->rx_head = s->rx_count = 0;
+        }
+        s->buf = val & ~(BUF_TXFIFO_CLR | BUF_RXFIFO_CLR);
+        break;
+    case I2C_CNT:
+        s->cnt = val;
+        return;
+    case I2C_DATA:
+        i2c_write_data(s, val);
+        break;
+    case I2C_SYSC:
+        if (val & 2) {                  /* SRST */
+            i2c_reset(DEVICE(s));
+            return;
+        }
+        s->sysc = val;
+        return;
+    case I2C_CON:
+        s->con = val;
+        if (!(val & CON_EN)) {
+            i2c_stop(s);
+            s->stat = 0;
+            s->rx_head = s->rx_count = 0;
+            s->remaining = 0;
+        } else if (val & CON_STT) {
+            i2c_start(s);
+        } else if ((val & CON_STP) && s->active && !s->remaining) {
+            i2c_stop(s);
+        }
+        break;
+    case I2C_OA0:
+        s->oa[0] = val;
+        return;
+    case I2C_SA:
+        s->sa = val & 0x3ff;
+        return;
+    case I2C_PSC:
+        s->psc = val;
+        return;
+    case I2C_SCLL:
+        s->scll = val;
+        return;
+    case I2C_SCLH:
+        s->sclh = val;
+        return;
+    case I2C_SYSTEST:
+        s->systest = val;
+        return;
+    case I2C_OA1:
+    case I2C_OA2:
+    case I2C_OA3:
+        s->oa[(addr - I2C_OA1) / 4 + 1] = val;
+        return;
+    case I2C_SBLOCK:
+        return;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "omap3-i2c: bad write at 0x%" HWADDR_PRIx "\n", addr);
+        return;
+    }
+    i2c_update_irq(s);
+}
+
+static const MemoryRegionOps i2c_ops = {
+    .read = i2c_read,
+    .write = i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 2,
+    .impl.max_access_size = 2,
+};
+
+static void i2c_init(Object *obj)
+{
+    Omap3I2cState *s = OMAP3_I2C(obj);
+
+    memory_region_init_io(&s->iomem, obj, &i2c_ops, s, "omap3-i2c", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    s->bus = i2c_init_bus(DEVICE(obj), "i2c");
+}
+
+static const Property i2c_properties[] = {
+    DEFINE_PROP_UINT8("fifo-depth", Omap3I2cState, fifo_depth, 0),
+};
+
+static const VMStateDescription i2c_vmstate = {
+    .name = TYPE_OMAP3_I2C,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16(ie, Omap3I2cState),
+        VMSTATE_UINT16(stat, Omap3I2cState),
+        VMSTATE_UINT16(we, Omap3I2cState),
+        VMSTATE_UINT16(buf, Omap3I2cState),
+        VMSTATE_UINT16(cnt, Omap3I2cState),
+        VMSTATE_UINT16(sysc, Omap3I2cState),
+        VMSTATE_UINT16(con, Omap3I2cState),
+        VMSTATE_UINT16_ARRAY(oa, Omap3I2cState, 4),
+        VMSTATE_UINT16(sa, Omap3I2cState),
+        VMSTATE_UINT16(psc, Omap3I2cState),
+        VMSTATE_UINT16(scll, Omap3I2cState),
+        VMSTATE_UINT16(sclh, Omap3I2cState),
+        VMSTATE_UINT16(systest, Omap3I2cState),
+        VMSTATE_BOOL(active, Omap3I2cState),
+        VMSTATE_BOOL(receiving, Omap3I2cState),
+        VMSTATE_UINT32(remaining, Omap3I2cState),
+        VMSTATE_UINT8_ARRAY(rx_fifo, Omap3I2cState, OMAP3_I2C_FIFO),
+        VMSTATE_UINT32(rx_head, Omap3I2cState),
+        VMSTATE_UINT32(rx_count, Omap3I2cState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void i2c_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, i2c_reset);
+    device_class_set_props(dc, i2c_properties);
+    dc->vmsd = &i2c_vmstate;
+    dc->desc = "OMAP3 I2C controller";
+}
+
+static const TypeInfo i2c_info = {
+    .name = TYPE_OMAP3_I2C,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Omap3I2cState),
+    .instance_init = i2c_init,
+    .class_init = i2c_class_init,
+};
+
+static void i2c_register_types(void)
+{
+    type_register_static(&i2c_info);
+}
+
+type_init(i2c_register_types)
diff --git a/hw/i2c/pfuze200.c b/hw/i2c/pfuze200.c
new file mode 100644
index 0000000..c5f1303
--- /dev/null
+++ b/hw/i2c/pfuze200.c
@@ -0,0 +1,124 @@
+/*
+ * NXP PFUZE200 PMIC (i2c) — a stub register file.
+ *
+ * The board's PMIC sits on i2c4 at address 0x08. Both firmwares talk to
+ * it through a plain 8-bit-address / 8-bit-value register file, and both
+ * trip over the missing device:
+ *
+ *   U-Boot:  wait_for_sr_state: failed sr=a1 cr=b8 state=202
+ *            i2c_init_transfer: failed for chip 0x8 retry=0
+ *            Set PMIC switcher mode error!
+ *   Linux:   pfuze100-regulator 3-0008: unrecognized pfuze chip ID!
+ *            pfuze100-regulator: probe of 3-0008 failed with error -110
+ *
+ * The model stores any write and ACKs every transfer, so regulator
+ * setup writes stick (and read back the same); only the identification
+ * registers carry non-zero reset values:
+ *
+ *   0x00 DEVICEID: low nibble 1 = PFUZE200, what the Linux driver's
+ *        pfuze_identify() compares against the DT's "fsl,pfuze200"
+ *        (drivers/regulator/pfuze100-regulator.c, PFUZE100_DEVICEID).
+ *   0x03 REVID / 0x04 FABID: only printed, any plausible value.
+ *
+ * Copyright (c) 2026
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/i2c.h"
+#include "hw/i2c/pfuze200.h"
+#include "hw/core/qdev-properties.h"
+#include "qemu/module.h"
+
+/* Read-only identification (regmap 8/8, auto-increment on read) */
+#define PFUZE_DEVICEID  0x00
+#define PFUZE_REVID     0x03
+#define PFUZE_FABID     0x04
+
+static int pfuze_event(I2CSlave *i2c, enum i2c_event event)
+{
+    Pfuze200State *s = PFUZE200(i2c);
+
+    switch (event) {
+    case I2C_START_SEND:
+    case I2C_START_SEND_ASYNC:
+    case I2C_START_RECV:
+        s->first_byte = true;
+        break;
+    case I2C_FINISH:
+    case I2C_NACK:
+        break;
+    }
+    return 0;
+}
+
+/* Master -> device: the first byte is the register address. */
+static int pfuze_send(I2CSlave *i2c, uint8_t data)
+{
+    Pfuze200State *s = PFUZE200(i2c);
+
+    if (s->first_byte) {
+        s->cur = data;
+        s->first_byte = false;
+        return 0;
+    }
+    /* The identification words are fused: writes land on other regs. */
+    if (s->cur != PFUZE_DEVICEID && s->cur != PFUZE_REVID &&
+        s->cur != PFUZE_FABID) {
+        s->regs[s->cur] = data;
+    }
+    s->cur = (s->cur + 1) & 0xff;
+    return 0;
+}
+
+/* Device -> master: the addressed register, then increment. */
+static uint8_t pfuze_recv(I2CSlave *i2c)
+{
+    Pfuze200State *s = PFUZE200(i2c);
+    uint8_t val = s->regs[s->cur];
+
+    s->cur = (s->cur + 1) & 0xff;
+    return val;
+}
+
+static void pfuze_reset(DeviceState *dev)
+{
+    Pfuze200State *s = PFUZE200(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[PFUZE_DEVICEID] = 0x01;     /* ID: PFUZE200 */
+    s->regs[PFUZE_REVID] = 0x20;        /* full layer 2, metal layer 0 */
+    s->regs[PFUZE_FABID] = 0x00;
+    s->cur = 0;
+}
+
+static void pfuze_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    I2CSlaveClass *isc = I2C_SLAVE_CLASS(oc);
+
+    device_class_set_legacy_reset(dc, pfuze_reset);
+    dc->desc = "NXP PFUZE200 PMIC (stub)";
+
+    isc->event = pfuze_event;
+    isc->send = pfuze_send;
+    isc->recv = pfuze_recv;
+}
+
+static const TypeInfo pfuze_info = {
+    .name = TYPE_PFUZE200,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(Pfuze200State),
+    .class_init = pfuze_class_init,
+};
+
+static void pfuze_register_types(void)
+{
+    type_register_static(&pfuze_info);
+}
+
+type_init(pfuze_register_types)
diff --git a/hw/input/adbs_a330.c b/hw/input/adbs_a330.c
new file mode 100644
index 0000000..dda122f
--- /dev/null
+++ b/hw/input/adbs_a330.c
@@ -0,0 +1,203 @@
+/*
+ * Avago ADBS-A320 optical finger navigation sensor (i2c), the j49's ring
+ *
+ * The ring turns over the sensor; Nest's avago-adbs-a330 driver reads the
+ * product and revision IDs at probe, sets the sensor up through its OFN
+ * registers, and on each MOTION_L edge reads DELTA_X and DELTA_Y until both
+ * come back zero, accumulating the configured axis (DELTA_Y on j49).
+ *
+ * Motion arrives on the QOM "motion" property: writing N adds N counts
+ * (signed) to what the sensor has to report. MOTION_L (GPIO output 0,
+ * active low) is held while any is pending, and DELTA_Y hands it out at
+ * most 127 counts per read; DELTA_X reads zero.
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/i2c.h"
+#include "hw/core/irq.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define TYPE_ADBS_A330 "adbs-a330"
+OBJECT_DECLARE_SIMPLE_TYPE(AdbsA330State, ADBS_A330)
+
+#define REG_PRODUCT_ID          0x00
+#define REG_REVISION_ID         0x01
+#define REG_MOTION              0x02
+#define REG_DELTA_X             0x03
+#define REG_DELTA_Y             0x04
+#define REG_SQUAL               0x05
+#define REG_SOFT_RESET          0x3a
+#define REG_INVERSE_REVISION_ID 0x3e
+#define REG_INVERSE_PRODUCT_ID  0x3f
+
+#define PRODUCT_ID              0x83    /* ADBS-A320 */
+#define REVISION_ID             0x01
+#define MOTION_MOT              0x80
+
+struct AdbsA330State {
+    I2CSlave i2c;
+
+    qemu_irq motion_l;
+    uint8_t regs[256];
+    uint8_t cur;
+    bool first_byte;
+    int32_t pending;            /* counts not yet read out */
+};
+
+static void adbs_update(AdbsA330State *s)
+{
+    qemu_set_irq(s->motion_l, !s->pending);
+}
+
+static uint8_t adbs_take(AdbsA330State *s)
+{
+    int32_t d = MAX(MIN(s->pending, 127), -128);
+
+    s->pending -= d;
+    adbs_update(s);
+    return (uint8_t)(int8_t)d;
+}
+
+static uint8_t adbs_read(AdbsA330State *s, uint8_t reg)
+{
+    switch (reg) {
+    case REG_PRODUCT_ID:
+        return PRODUCT_ID;
+    case REG_REVISION_ID:
+        return REVISION_ID;
+    case REG_INVERSE_PRODUCT_ID:
+        return (uint8_t)~PRODUCT_ID;
+    case REG_INVERSE_REVISION_ID:
+        return (uint8_t)~REVISION_ID;
+    case REG_MOTION:
+        return s->pending ? MOTION_MOT : 0;
+    case REG_DELTA_X:
+        return 0;
+    case REG_DELTA_Y:
+        return adbs_take(s);
+    case REG_SQUAL:
+        return 0x40;                    /* a finger on the ring's surface */
+    }
+    return s->regs[reg];
+}
+
+static int adbs_event(I2CSlave *i2c, enum i2c_event event)
+{
+    AdbsA330State *s = ADBS_A330(i2c);
+
+    if (event == I2C_START_SEND || event == I2C_START_SEND_ASYNC) {
+        s->first_byte = true;
+    }
+    return 0;
+}
+
+static int adbs_send(I2CSlave *i2c, uint8_t data)
+{
+    AdbsA330State *s = ADBS_A330(i2c);
+
+    if (s->first_byte) {
+        s->cur = data;
+        s->first_byte = false;
+    } else {
+        s->regs[s->cur++] = data;
+    }
+    return 0;
+}
+
+static uint8_t adbs_recv(I2CSlave *i2c)
+{
+    AdbsA330State *s = ADBS_A330(i2c);
+
+    return adbs_read(s, s->cur++);
+}
+
+static void adbs_get_motion(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    AdbsA330State *s = ADBS_A330(obj);
+
+    visit_type_int32(v, name, &s->pending, errp);
+}
+
+static void adbs_set_motion(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    AdbsA330State *s = ADBS_A330(obj);
+    int32_t counts;
+
+    if (!visit_type_int32(v, name, &counts, errp)) {
+        return;
+    }
+    s->pending += counts;
+    adbs_update(s);
+}
+
+static void adbs_reset(DeviceState *dev)
+{
+    AdbsA330State *s = ADBS_A330(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->cur = 0;
+    s->first_byte = false;
+    s->pending = 0;
+    adbs_update(s);
+}
+
+static void adbs_init(Object *obj)
+{
+    AdbsA330State *s = ADBS_A330(obj);
+
+    qdev_init_gpio_out(DEVICE(obj), &s->motion_l, 1);
+    object_property_add(obj, "motion", "int32", adbs_get_motion,
+                        adbs_set_motion, NULL, NULL);
+}
+
+static const VMStateDescription adbs_vmstate = {
+    .name = TYPE_ADBS_A330,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(i2c, AdbsA330State),
+        VMSTATE_UINT8_ARRAY(regs, AdbsA330State, 256),
+        VMSTATE_UINT8(cur, AdbsA330State),
+        VMSTATE_BOOL(first_byte, AdbsA330State),
+        VMSTATE_INT32(pending, AdbsA330State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void adbs_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, adbs_reset);
+    dc->vmsd = &adbs_vmstate;
+    dc->desc = "Avago ADBS-A320 optical finger navigation sensor";
+    k->event = adbs_event;
+    k->send = adbs_send;
+    k->recv = adbs_recv;
+}
+
+static const TypeInfo adbs_info = {
+    .name = TYPE_ADBS_A330,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(AdbsA330State),
+    .instance_init = adbs_init,
+    .class_init = adbs_class_init,
+};
+
+static void adbs_register_types(void)
+{
+    type_register_static(&adbs_info);
+}
+
+type_init(adbs_register_types)

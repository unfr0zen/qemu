diff --git a/include/hw/misc/omap3_gpmc.h b/include/hw/misc/omap3_gpmc.h
new file mode 100644
index 0000000..6402d20
--- /dev/null
+++ b/include/hw/misc/omap3_gpmc.h
@@ -0,0 +1,69 @@
+/*
+ * OMAP3 general-purpose memory controller (GPMC) with a NAND flash on
+ * one chip select and the BCH ECC engine
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_OMAP3_GPMC_H
+#define HW_MISC_OMAP3_GPMC_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_OMAP3_GPMC "omap3-gpmc"
+OBJECT_DECLARE_SIMPLE_TYPE(Omap3GpmcState, OMAP3_GPMC)
+
+#define OMAP3_GPMC_NUM_CS       8
+#define OMAP3_NAND_PAGE         2048
+#define OMAP3_NAND_OOB          64
+#define OMAP3_NAND_PAGE_RAW     (OMAP3_NAND_PAGE + OMAP3_NAND_OOB)
+#define OMAP3_NAND_PAGES_PER_BLOCK 64
+
+struct Omap3GpmcState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;         /* registers, 0x6e000000 */
+    MemoryRegion cs_space;      /* the 1 GiB chip-select space at 0 */
+    MemoryRegion nand_window;   /* data port, mapped per CONFIG7 */
+    qemu_irq irq;
+
+    /* the NAND: raw pages of 2048 data + 64 OOB bytes */
+    BlockBackend *blk;
+    uint8_t nand_cs;
+    uint8_t nand_id[5];
+    uint32_t nand_pages;
+
+    uint32_t sysconfig;
+    uint32_t irqstatus;
+    uint32_t irqenable;
+    uint32_t timeout_control;
+    uint32_t config;
+    uint32_t cs_config[OMAP3_GPMC_NUM_CS][7];
+    uint32_t prefetch_config1;
+    uint32_t prefetch_config2;
+    uint32_t prefetch_control;
+    uint32_t prefetch_remaining;    /* bytes the engine has still to move */
+    uint32_t ecc_config;
+    uint32_t ecc_control;
+    uint32_t ecc_size_config;
+
+    /* NAND chip state */
+    uint8_t cmd;
+    uint8_t addr[5];
+    uint8_t naddr;
+    uint8_t out_mode;           /* what data reads return */
+    uint32_t row;
+    uint32_t col;               /* byte column in page_buf */
+    uint8_t status;
+    uint8_t page_buf[OMAP3_NAND_PAGE_RAW];
+    bool programming;
+
+    /* ECC engine: the bytes moved since it was cleared */
+    uint8_t ecc_buf[OMAP3_NAND_PAGE_RAW];
+    uint32_t ecc_count;
+};
+
+#endif
diff --git a/include/hw/misc/omap3_prcm.h b/include/hw/misc/omap3_prcm.h
new file mode 100644
index 0000000..f6adf96
--- /dev/null
+++ b/include/hw/misc/omap3_prcm.h
@@ -0,0 +1,86 @@
+/*
+ * OMAP3 power, reset and clock management (CM and PRM), the system
+ * control module (SCM, with the TAP identification block) and the SDRAM
+ * controller with its memory scheduler (SDRC, SMS)
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_OMAP3_PRCM_H
+#define HW_MISC_OMAP3_PRCM_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_OMAP3_CM "omap3-cm"
+OBJECT_DECLARE_SIMPLE_TYPE(Omap3CmState, OMAP3_CM)
+
+#define TYPE_OMAP3_PRM "omap3-prm"
+OBJECT_DECLARE_SIMPLE_TYPE(Omap3PrmState, OMAP3_PRM)
+
+#define TYPE_OMAP3_SCM "omap3-scm"
+OBJECT_DECLARE_SIMPLE_TYPE(Omap3ScmState, OMAP3_SCM)
+
+#define TYPE_OMAP3_SDRC "omap3-sdrc"
+OBJECT_DECLARE_SIMPLE_TYPE(Omap3SdrcState, OMAP3_SDRC)
+
+#define OMAP3_CM_SIZE   0x2000
+#define OMAP3_PRM_SIZE  0x2000
+
+/* CM named outputs: "gpt-clksel"[n] is GPTIMER(n+1)'s source, 1 = sys_clk */
+#define OMAP3_CM_GPT_CLKSEL "gpt-clksel"
+#define OMAP3_NUM_GPT       12
+
+struct Omap3CmState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint32_t regs[OMAP3_CM_SIZE / 4];
+    qemu_irq gpt_clksel[OMAP3_NUM_GPT];
+};
+
+/*
+ * PRM named inputs: "wakeup"[n] is a module's wake-up request, n one of
+ * OMAP3_WAKE_*; a rising edge is latched in its domain's PM_WKST.
+ */
+#define OMAP3_PRM_WAKEUP    "wakeup"
+enum {
+    OMAP3_WAKE_GPIO1,           /* .. OMAP3_WAKE_GPIO1 + 5: GPIO1-6 */
+    OMAP3_WAKE_UART1 = OMAP3_WAKE_GPIO1 + 6,
+    OMAP3_WAKE_UART2,
+    OMAP3_WAKE_UART3,
+    OMAP3_NUM_WAKE,
+};
+
+struct Omap3PrmState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint32_t regs[OMAP3_PRM_SIZE / 4];
+    qemu_irq irq;
+};
+
+struct Omap3ScmState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;         /* 0x48002000: padconf and general */
+    MemoryRegion tap;           /* 0x4830a000: IDCODE, die ID */
+    uint32_t regs[0x1000 / 4];
+    uint32_t idcode;            /* properties */
+    uint32_t die_id[4];
+    uint32_t omap_status;
+    uint32_t sys_boot;
+};
+
+struct Omap3SdrcState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion sdrc;          /* 0x6d000000 */
+    MemoryRegion sms;           /* 0x6c000000 */
+    uint32_t sdrc_regs[0x400 / 4];
+    uint32_t sms_regs[0x400 / 4];
+};
+
+#endif

diff --git a/hw/misc/em35x_ncp.c b/hw/misc/em35x_ncp.c
new file mode 100644
index 0000000..92dd5fb
--- /dev/null
+++ b/hw/misc/em35x_ncp.c
@@ -0,0 +1,364 @@
+/*
+ * Silicon Labs EM35x network co-processor, as a chardev.
+ *
+ * The Nest Display-3.4 carries an EM35x (802.15.4 / Thread radio, running
+ * Silicon Labs' ConnectIP "ip-modem-app") on ECSPI3, with its chip select
+ * on a GPIO and three more lines: nRESET and nWAKE from the SoC, nHOST_INT
+ * back to it.
+ *
+ * This device is the chip's SPI slave port as its firmware drives it
+ * (spi-protocol2-sc1.c in ip-modem-app): the reply to a transaction is laid
+ * out the moment nSSEL falls, which a model on the far side of a chardev
+ * could not do in time. The application behind the port (the management
+ * protocol, booting, sleeping) lives outside QEMU, in qemu/ui/em35x.py, and
+ * sees only the byte stream the SPI frames carry:
+ *
+ *   QEMU -> model, two bytes each:
+ *     'd' byte   a stream byte the host sent (the payload of its SPI frame)
+ *     's' level  nSSEL (0 = selected)
+ *     'r' level  nRESET (0 = held in reset)
+ *     'w' level  nWAKE (0 = wake request)
+ *   model -> QEMU, two bytes each:
+ *     'd' byte   a stream byte for the host (appended to the TX ring)
+ *     'a' level  the SPI port is up (1: the chip runs; 0: in reset, asleep
+ *                or absent, it answers 0xff and drops what it is sent)
+ *     'f' 0      drop the TX ring (the chip rebooted)
+ *     'z' 0      deep sleep, once the host has clocked out the TX ring
+ *
+ * A transaction clocks out 0xff (the preloaded data register), the header
+ * H = 0x31 (| 0x08 on the first transactions after a boot), the length L
+ * of the stream bytes that follow (up to 0xfe), and those bytes. At nSSEL
+ * rising the bytes that went out leave the ring, and the host's frame is
+ * parsed: up to 5 leading 0x00/0xff, a header with (h & 0xe1) == 0x20 and
+ * 0x10 set, a length, then its stream bytes. The port never reports busy
+ * (header bit 0x04): the model takes whatever arrives. nHOST_INT is low
+ * while the ring holds bytes and neither nSSEL nor nWAKE is asserted.
+ *
+ * Asleep, the port is off: nHOST_INT stays high, and the transaction that
+ * wakes the chip (any nSSEL edge) is lost, 0xff out and its MOSI dropped,
+ * so spi-server sends it again. A falling nWAKE wakes it too: the chip
+ * then holds nHOST_INT low until nWAKE rises, the host's cue that it is up.
+ *
+ * With no model attached the chip reads as absent: 0xff, nHOST_INT high.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "chardev/char-fe.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/misc/em35x_ncp.h"
+#include "hw/ssi/ssi.h"
+#include "qemu/fifo8.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define EM35X_NCP_RING_DEPTH    4096
+#define EM35X_NCP_FRAME_MAX     0xfe    /* stream bytes per SPI frame */
+#define EM35X_NCP_XFER_MAX      0x110   /* a transaction, as the host sizes it */
+
+OBJECT_DECLARE_SIMPLE_TYPE(EM35xNcpState, EM35X_NCP)
+
+struct EM35xNcpState {
+    SSIPeripheral parent_obj;
+
+    CharFrontend chr;
+    qemu_irq nhost_int;
+    Fifo8 ring;                 /* stream bytes for the host */
+    bool nssel, nreset, nwake;
+    bool up;                    /* the SPI port runs ('a') */
+    bool first;                 /* no transaction since the boot yet */
+    bool sleep_pending;         /* 'z': sleep once the ring is out */
+    bool asleep;
+    bool waking;                /* woken by nWAKE: nHOST_INT low till it rises */
+    bool lost;                  /* this transaction woke the chip */
+
+    /* The transaction in progress. */
+    uint8_t miso[EM35X_NCP_XFER_MAX];
+    int miso_len;               /* 0xff, H, L, and L stream bytes */
+    int reply_len;              /* L */
+    uint8_t mosi[EM35X_NCP_XFER_MAX];
+    int clocked;
+
+    uint8_t msg[2];             /* a message from the model, in progress */
+    int msg_len;
+};
+
+static void em35x_send(EM35xNcpState *s, char kind, uint8_t val)
+{
+    uint8_t msg[2] = { kind, val };
+
+    if (qemu_chr_fe_backend_connected(&s->chr)) {
+        qemu_chr_fe_write_all(&s->chr, msg, sizeof(msg));
+    }
+}
+
+static void em35x_update_int(EM35xNcpState *s)
+{
+    bool low = s->waking ||
+               (s->up && !s->asleep && !fifo8_is_empty(&s->ring) &&
+                s->nssel && s->nwake);
+
+    qemu_set_irq(s->nhost_int, !low);
+}
+
+static void em35x_sleep_if_done(EM35xNcpState *s)
+{
+    if (s->sleep_pending && fifo8_is_empty(&s->ring) && s->nssel) {
+        s->sleep_pending = false;
+        s->asleep = true;
+    }
+}
+
+/* nSSEL fell: lay out what the chip clocks back. */
+static void em35x_select(EM35xNcpState *s)
+{
+    s->clocked = 0;
+    s->miso_len = 0;
+    s->reply_len = 0;
+    if (s->asleep) {
+        s->asleep = false;
+        s->lost = true;
+    }
+    if (!s->up || s->lost) {
+        return;
+    }
+    /* Peek: only what gets clocked out leaves the ring. */
+    s->reply_len = fifo8_peek_buf(&s->ring, s->miso + 3,
+                                  MIN(fifo8_num_used(&s->ring),
+                                      EM35X_NCP_FRAME_MAX));
+    s->miso[0] = 0xff;
+    s->miso[1] = 0x31 | (s->first ? 0x08 : 0);
+    s->miso[2] = s->reply_len;
+    s->miso_len = 3 + s->reply_len;
+}
+
+/* nSSEL rose: retire what went out, take in what came. */
+static void em35x_deselect(EM35xNcpState *s)
+{
+    int i, len;
+
+    if (s->lost) {
+        s->lost = false;
+        return;
+    }
+    if (!s->up) {
+        return;
+    }
+    /* A reboot ('f') may have emptied the ring meanwhile. */
+    if (s->clocked > 3) {
+        fifo8_drop(&s->ring, MIN(MIN(s->reply_len, s->clocked - 3),
+                                 fifo8_num_used(&s->ring)));
+    }
+    if (s->clocked >= 2) {
+        s->first = false;
+    }
+    em35x_sleep_if_done(s);
+    for (i = 0; i < 5 && i < s->clocked &&
+                (s->mosi[i] == 0x00 || s->mosi[i] == 0xff); i++) {
+    }
+    if (i + 2 > s->clocked) {
+        return;
+    }
+    if ((s->mosi[i] & 0xe1) != 0x20 || !(s->mosi[i] & 0x10)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "em35x-ncp: bad frame header 0x%02x\n",
+                      s->mosi[i]);
+        return;
+    }
+    len = MIN(s->mosi[i + 1], s->clocked - (i + 2));
+    for (int j = 0; j < len; j++) {
+        em35x_send(s, 'd', s->mosi[i + 2 + j]);
+    }
+}
+
+static uint32_t em35x_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    EM35xNcpState *s = EM35X_NCP(dev);
+    uint8_t out;
+
+    /* The bus is shared by chip selects this device doesn't see. */
+    if (s->nssel || !s->up || s->lost) {
+        return 0xff;
+    }
+    out = s->clocked < s->miso_len ? s->miso[s->clocked] : 0xff;
+    if (s->clocked < EM35X_NCP_XFER_MAX) {
+        s->mosi[s->clocked++] = val;
+    }
+    return out;
+}
+
+static void em35x_line(void *opaque, char kind, bool *line, int level)
+{
+    EM35xNcpState *s = opaque;
+
+    if (*line != !!level) {
+        *line = !!level;
+        em35x_send(s, kind, *line);
+    }
+}
+
+static void em35x_nssel(void *opaque, int n, int level)
+{
+    EM35xNcpState *s = opaque;
+    bool was = s->nssel;
+
+    em35x_line(s, 's', &s->nssel, level);
+    if (was && !s->nssel) {
+        em35x_select(s);
+    } else if (!was && s->nssel) {
+        em35x_deselect(s);
+    }
+    em35x_update_int(s);
+}
+
+static void em35x_nreset(void *opaque, int n, int level)
+{
+    EM35xNcpState *s = opaque;
+
+    em35x_line(s, 'r', &s->nreset, level);
+}
+
+static void em35x_nwake(void *opaque, int n, int level)
+{
+    EM35xNcpState *s = opaque;
+
+    em35x_line(s, 'w', &s->nwake, level);
+    if (!s->nwake && s->asleep) {
+        s->asleep = false;
+        s->waking = true;
+    } else if (s->nwake) {
+        s->waking = false;
+    }
+    em35x_update_int(s);
+}
+
+static void em35x_message(EM35xNcpState *s, uint8_t kind, uint8_t val)
+{
+    switch (kind) {
+    case 'd':
+        if (!fifo8_is_full(&s->ring)) {
+            fifo8_push(&s->ring, val);
+        }
+        break;
+    case 'a':
+        s->up = val != 0;
+        break;
+    case 'f':
+        fifo8_reset(&s->ring);
+        s->first = true;
+        s->sleep_pending = s->asleep = s->waking = false;
+        break;
+    case 'z':
+        s->sleep_pending = true;
+        em35x_sleep_if_done(s);
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "em35x-ncp: bad message 0x%02x\n",
+                      kind);
+    }
+    em35x_update_int(s);
+}
+
+static int em35x_chr_can_read(void *opaque)
+{
+    return 256;
+}
+
+static void em35x_chr_read(void *opaque, const uint8_t *buf, int size)
+{
+    EM35xNcpState *s = opaque;
+
+    for (int i = 0; i < size; i++) {
+        s->msg[s->msg_len++] = buf[i];
+        if (s->msg_len == sizeof(s->msg)) {
+            s->msg_len = 0;
+            em35x_message(s, s->msg[0], s->msg[1]);
+        }
+    }
+}
+
+static void em35x_chr_event(void *opaque, QEMUChrEvent event)
+{
+    EM35xNcpState *s = opaque;
+
+    switch (event) {
+    case CHR_EVENT_OPENED:
+        /* A new model: tell it where the lines stand. */
+        s->msg_len = 0;
+        em35x_send(s, 's', s->nssel);
+        em35x_send(s, 'r', s->nreset);
+        em35x_send(s, 'w', s->nwake);
+        break;
+    case CHR_EVENT_CLOSED:
+        /* The chip is gone with it. */
+        fifo8_reset(&s->ring);
+        s->up = false;
+        s->sleep_pending = s->asleep = s->waking = false;
+        em35x_update_int(s);
+        break;
+    default:
+        break;
+    }
+}
+
+static void em35x_realize(SSIPeripheral *dev, Error **errp)
+{
+    EM35xNcpState *s = EM35X_NCP(dev);
+
+    fifo8_create(&s->ring, EM35X_NCP_RING_DEPTH);
+    qdev_init_gpio_in_named(DEVICE(dev), em35x_nssel, EM35X_NCP_NSSEL, 1);
+    qdev_init_gpio_in_named(DEVICE(dev), em35x_nreset, EM35X_NCP_NRESET, 1);
+    qdev_init_gpio_in_named(DEVICE(dev), em35x_nwake, EM35X_NCP_NWAKE, 1);
+    qdev_init_gpio_out_named(DEVICE(dev), &s->nhost_int, EM35X_NCP_NHOST_INT,
+                             1);
+    if (qemu_chr_fe_backend_connected(&s->chr)) {
+        qemu_chr_fe_set_handlers(&s->chr, em35x_chr_can_read, em35x_chr_read,
+                                 em35x_chr_event, NULL, s, NULL, true);
+    }
+}
+
+static void em35x_reset(DeviceState *dev)
+{
+    EM35xNcpState *s = EM35X_NCP(dev);
+
+    /*
+     * The SoC's reset is not the chip's: the model's state (up, the ring)
+     * stands until it says otherwise or nRESET reboots it.
+     */
+    s->nssel = s->nreset = s->nwake = true;
+    s->waking = s->lost = false;
+    s->clocked = s->miso_len = s->reply_len = 0;
+    em35x_update_int(s);
+}
+
+static const Property em35x_properties[] = {
+    DEFINE_PROP_CHR("chardev", EM35xNcpState, chr),
+};
+
+static void em35x_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(oc);
+
+    k->realize = em35x_realize;
+    k->transfer_raw = em35x_transfer;
+    device_class_set_legacy_reset(dc, em35x_reset);
+    device_class_set_props(dc, em35x_properties);
+    dc->desc = "Silicon Labs EM35x NCP (SPI port; application via chardev)";
+}
+
+static const TypeInfo em35x_info = {
+    .name = TYPE_EM35X_NCP,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(EM35xNcpState),
+    .class_init = em35x_class_init,
+};
+
+static void em35x_register_types(void)
+{
+    type_register_static(&em35x_info);
+}
+
+type_init(em35x_register_types)
diff --git a/hw/misc/imx6_mmdc.c b/hw/misc/imx6_mmdc.c
new file mode 100644
index 0000000..de7cbb8
--- /dev/null
+++ b/hw/misc/imx6_mmdc.c
@@ -0,0 +1,136 @@
+/*
+ * i.MX6 MMDC emulation — a stub that answers the probe.
+ *
+ * The 4.1.15 imx-mmdc driver maps the block, reads MDMISC for the DDR
+ * type, then enables the automatic power saving: it clears PSD (bit 0)
+ * in MAPSR and spins until PSS (bit 4) sets — the hardware asserts the
+ * status once the core is allowed to enter its counter-based power save.
+ * Reads-as-zero left PSS clear, the poll timed out and the probe failed:
+ *
+ *   imx_mmdc_probe: failed to enable automatic power saving
+ *   imx-mmdc: probe of 21b0000.mmdc failed with error -16
+ *
+ * The stub makes PSS follow the hardware: 1 whenever power saving is
+ * enabled (PSD clear), 0 while the driver disables it. Everything else is
+ * a plain register file.
+ *
+ * The suspend code (suspend-imx6.S) puts the DDR in self-refresh by setting
+ * DVFS (bit 21) and spinning until DVACK (bit 25) sets, then clears DVFS
+ * and waits for DVACK to clear on resume; DVACK follows DVFS. On resume it
+ * also starts a ZQ calibration (MPZQHWCTRL.ZQ_HW_FOR) and a read FIFO reset
+ * (MPDGCTRL0.RST_RD_FIFO) and polls each bit until the hardware clears it:
+ * both complete at once.
+ *
+ * Driver: arch/arm/mach-imx/mmdc.c v4.1 (MMDC_MAPSR 0x404, PSD bit 0,
+ * PSS bit 4), i.MX6SX Reference Manual ch. 47.
+ *
+ * Copyright (c) 2026
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/imx6_mmdc.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define MMDC_MDMISC     0x018
+#define MMDC_MAPSR      0x404
+#define BP_MAPSR_PSD    0       /* power saving disable (RW) */
+#define BP_MAPSR_PSS    4       /* power saving status (RO, follows !PSD) */
+#define BP_MAPSR_DVFS   21      /* self-refresh request (RW) */
+#define BP_MAPSR_DVACK  25      /* self-refresh ack (RO, follows DVFS) */
+#define MMDC_MPZQHWCTRL 0x800
+#define BP_ZQ_HW_FOR    16      /* force ZQ calibration (self-clearing) */
+#define MMDC_MPDGCTRL0  0x83c
+#define BP_RST_RD_FIFO  31      /* read FIFO reset (self-clearing) */
+
+static uint64_t imx6_mmdc_read(void *opaque, hwaddr off, unsigned size)
+{
+    Imx6MmdcState *s = IMX6_MMDC(opaque);
+    uint32_t val;
+
+    if (off < sizeof(s->regs)) {
+        val = s->regs[off / 4];
+    } else {
+        val = 0;
+    }
+    if (off == MMDC_MAPSR) {
+        val = deposit32(val, BP_MAPSR_PSS, 1,
+                        !extract32(val, BP_MAPSR_PSD, 1));
+        val = deposit32(val, BP_MAPSR_DVACK, 1,
+                        extract32(val, BP_MAPSR_DVFS, 1));
+    }
+    return val;
+}
+
+static void imx6_mmdc_write(void *opaque, hwaddr off, uint64_t val,
+                            unsigned size)
+{
+    Imx6MmdcState *s = IMX6_MMDC(opaque);
+
+    if (off == MMDC_MPZQHWCTRL) {
+        val = deposit32(val, BP_ZQ_HW_FOR, 1, 0);
+    } else if (off == MMDC_MPDGCTRL0) {
+        val = deposit32(val, BP_RST_RD_FIFO, 1, 0);
+    }
+    if (off < sizeof(s->regs)) {
+        s->regs[off / 4] = val;
+    }
+}
+
+static const MemoryRegionOps imx6_mmdc_ops = {
+    .read = imx6_mmdc_read,
+    .write = imx6_mmdc_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void imx6_mmdc_realize(DeviceState *dev, Error **errp)
+{
+    Imx6MmdcState *s = IMX6_MMDC(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(s), &imx6_mmdc_ops, s,
+                          TYPE_IMX6_MMDC, IMX6_MMDC_REG_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+}
+
+static const VMStateDescription imx6_mmdc_vmstate = {
+    .name = TYPE_IMX6_MMDC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, Imx6MmdcState, IMX6_MMDC_REG_SIZE / 4),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx6_mmdc_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = imx6_mmdc_realize;
+    dc->vmsd = &imx6_mmdc_vmstate;
+    dc->desc = "i.MX6 MMDC (probe stub)";
+}
+
+static const TypeInfo imx6_mmdc_info = {
+    .name = TYPE_IMX6_MMDC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Imx6MmdcState),
+    .class_init = imx6_mmdc_class_init,
+};
+
+static void imx6_mmdc_register_types(void)
+{
+    type_register_static(&imx6_mmdc_info);
+}
+
+type_init(imx6_mmdc_register_types)

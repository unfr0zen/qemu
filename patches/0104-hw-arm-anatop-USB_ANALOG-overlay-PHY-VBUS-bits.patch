+
+#define TYPE_TPS65921_SUB "tps65921-sub"
+OBJECT_DECLARE_SIMPLE_TYPE(Tps65921SubState, TPS65921_SUB)
+
+/* the four I2C slaves: 0x48 (USB), 0x49, 0x4a, 0x4b (power, RTC) */
+#define TPS65921_ADDR   0x48
+#define TPS65921_NUM_ID 4
+
+typedef struct Tps65921Slave {
+    uint8_t ptr;                /* register pointer */
+    bool addressed;             /* first byte of a write sets ptr */
+} Tps65921Slave;
+
+struct Tps65921State {
+    I2CSlave parent_obj;        /* ID 0, at 0x48 */
+
+    Tps65921SubState *sub[TPS65921_NUM_ID - 1];
+    Tps65921Slave slave[TPS65921_NUM_ID];
+    uint8_t regs[TPS65921_NUM_ID][256];
+    qemu_irq irq;               /* SYS_NIRQ, active high here */
+    int64_t rtc_offset;         /* guest RTC - host clock, seconds */
+    uint32_t adcin_mv[16];      /* MADC inputs (mV), QOM "adcinN-mv" */
+    bool pwron;                 /* the PWRON pin (button pressed) */
+    uint8_t pwr_pending;        /* power SIH events, before IMR1 */
+};
+
+/* GPIO input 0: the PWRON pin, 1 while the button is pressed. */
+
+struct Tps65921SubState {
+    I2CSlave parent_obj;
+
+    Tps65921State *core;
+    uint8_t id;
+};
+
+#endif

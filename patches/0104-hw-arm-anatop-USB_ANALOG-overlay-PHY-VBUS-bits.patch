+/*
+ * An SDIO card is a transport; what its I/O functions actually do lives in
+ * a chip model implementing this interface. The card routes CMD52/CMD53
+ * accesses to functions 1..7 here; function 0 (CCCR/FBR/CIS) stays in the
+ * card itself. @incr distinguishes incrementing-address transfers from
+ * FIFO reads/writes at a fixed address.
+ */
+#define TYPE_SDIO_FUNCTION "sdio-function"
+typedef struct SDIOFunctionClass SDIOFunctionClass;
+DECLARE_CLASS_CHECKERS(SDIOFunctionClass, SDIO_FUNCTION, TYPE_SDIO_FUNCTION)
+
+struct SDIOFunctionClass {
+    InterfaceClass parent_class;
+
+    uint8_t (*rw)(DeviceState *dev, unsigned fn, uint32_t addr,
+                  uint8_t val, bool write);
+    void (*read_block)(DeviceState *dev, unsigned fn, uint32_t addr,
+                       uint8_t *buf, unsigned len, bool incr);
+    void (*write_block)(DeviceState *dev, unsigned fn, uint32_t addr,
+                        const uint8_t *buf, unsigned len, bool incr);
+};
 DECLARE_INSTANCE_CHECKER(SDState, SD_CARD_SPI, TYPE_SD_CARD_SPI)
 

+#include "qapi/error.h"
+#include "crypto/cipher.h"
+#include "crypto/hmac.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/sd/sd.h"
+#include "hw/net/bcm43341.h"
+#include "net/net.h"
+#include "system/reset.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(BCM43341State, BCM43341)
+
+/* -- Backplane ------------------------------------------------------------ */
+
+#define SI_ENUM_BASE            0x18000000
+#define SI_WRAP_BASE            0x18100000
+#define SI_CORE_SIZE            0x1000
+#define BCM_EROM_BASE           0x1810a000
+#define BCM_EROM_WORDS          64
+#define BCM_RAM_SIZE            (512 * KiB)
+/* Where the "firmware" leaves its sdpcm_shared_t, below the NVRAM. */
+#define BCM_SHARED_ADDR         0x70000
+
+#define BCM_CHIP_ID             43341
+#define BCM_CHIP_REV            2       /* B0, what the 43341b0 image is for */
+
+enum { CORE_CC, CORE_D11, CORE_SDIOD, CORE_ARM, CORE_SOCRAM, NUM_CORES };
+
+static const struct {
+    uint16_t id;
+    uint8_t rev;
+} bcm_cores[NUM_CORES] = {
+    [CORE_CC]     = { 0x800, 43 },
+    [CORE_D11]    = { 0x812, 24 },
+    [CORE_SDIOD]  = { 0x829, 14 },      /* >= 12: the driver enables KSO */
+    [CORE_ARM]    = { 0x82a, 7 },
+    [CORE_SOCRAM] = { 0x80e, 13 },      /* >= 8: sized through bankinfo */
+};
+
+/* AI wrapper */
+#define AI_IOCTRL               0x408
+#define AI_RESETCTRL            0x800
+#define AIRC_RESET              1
+#define SICF_CLOCK_EN           1

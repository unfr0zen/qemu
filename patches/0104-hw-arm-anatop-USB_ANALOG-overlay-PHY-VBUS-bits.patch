+/*
+ * OMAP3 system DMA controller (SDMA, "DMA4")
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_DMA_OMAP3_SDMA_H

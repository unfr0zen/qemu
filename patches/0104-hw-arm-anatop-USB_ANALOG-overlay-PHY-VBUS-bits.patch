diff --git a/hw/arm/flintstone_board.c b/hw/arm/flintstone_board.c
new file mode 100644
index 0000000..a80dd50
--- /dev/null
+++ b/hw/arm/flintstone_board.c
@@ -0,0 +1,308 @@
+/*
+ * The board around the i.MX6SX, as a chardev — Nest Display-3.4.
+ *
+ * Every physical control on this product is wired to a GPIO bank, and the
+ * stock firmware knows them only through those banks (gpio-keys, device
+ * tree exporters, gpio-poweroff). This device is the other end of those
+ * wires — a chardev so something outside QEMU can press the button and
+ * watch what the firmware drives, with nothing in the guest knowing it is
+ * being watched:
+ *
+ *   HU-BUTTON   (out of this device, into GPIO2_IO18) the front button,
+ *               gpio-keys "HU Button", active high, KEY_ENTER.
+ *   BP-DETACHED (out of this device, into GPIO5_IO13) the backplate detect
+ *               line, the DT's sensor-mcu-gpios "detect#": low while the
+ *               display sits on its base, as it does from reset.
+ *   POWEROFF    (GPIO1_IO11) gpio-poweroff: the firmware raises it to cut
+ *               the board's power.
+ *   WIFI-RESET  (GPIO1_IO04) the Broadcom wifi module's reset line.
+ *   HALL-ENABLE (GPIO7_IO02) the wheel's Hall sensor power (active low).
+ *   VBATT-EN    (GPIO6_IO16) the battery divider's ADC input enable.
+ *   BEEPER-EN   (GPIO1_IO05) the piezo's enable (pwm-beeper, active low).
+ *   BEEPER      (PWM1) the piezo's drive, as the frequency PWM1 runs at:
+ *               pwm-beeper plays a click as 2 kHz for 3 ms.
+ *
+ * Lines out, one per change, stamped with guest time in microseconds
+ * (level in permille, 0 and 1000 — the lines are plain GPIO):
+ *
+ *   POWEROFF out 1000 1234567   firmware is powering the board off
+ *   HU-BUTTON in 1000 1234567   the button level the SoC sees
+ *   BEEPER out 2000 1234567     the piezo is driven at 2000 Hz (0: still;
+ *                               the level is in Hz for this one)
+ *
+ * Lines in:
+ *
+ *   set HU-BUTTON 1             press the button (0 = release)
+ *   hold HU-BUTTON 1 3000       press it for exactly 3000 ms of guest
+ *                               time, then release
+ *   set BP-DETACHED 1           lift the display off its base (0 = put
+ *                               it back)
+ *   dump                        report every line again
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "chardev/char-fe.h"
+#include "hw/arm/flintstone_board.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/core/sysbus.h"
+#include "qemu/error-report.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "system/runstate.h"
+
+static const char *const flintstone_board_in_names[FLINTSTONE_BOARD_IN] = {
+    "POWEROFF",
+    "WIFI-RESET",
+    "HALL-ENABLE",
+    "VBATT-EN",
+    "BEEPER-EN",
+};
+
+struct FlintstoneBoardState {
+    DeviceState parent_obj;
+
+    CharFrontend chr;
+    QEMUTimer *hold;            /* ends the pending "hold" */
+    int hold_level;
+    GString *cmd;
+
+    bool poweroff_exit;
+
+    qemu_irq button;            /* into GPIO2_IO18 */
+    bool button_level;
+    qemu_irq detect;            /* into GPIO5_IO13, low while attached */
+    bool detached;
+
+    bool lines[FLINTSTONE_BOARD_IN];
+    int beeper_hz;
+};
+
+static void board_send_line(FlintstoneBoardState *s, const char *line)
+{
+    qemu_chr_fe_write_all(&s->chr, (const uint8_t *)line, strlen(line));
+}
+
+static void board_emit(FlintstoneBoardState *s, const char *name,
+                       char dir, int level)
+{
+    int64_t t = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    g_autofree char *line = g_strdup_printf("%s %c %d %" PRId64 "\n",
+                                            name, dir, level, t / SCALE_US);
+    board_send_line(s, line);
+}
+
+static void board_set_button(FlintstoneBoardState *s, bool level)
+{
+    if (level == s->button_level) {
+        return;
+    }
+    s->button_level = level;
+    qemu_set_irq(s->button, level);
+    board_emit(s, "HU-BUTTON", 'i', level ? 1000 : 0);
+}
+
+static void board_set_detached(FlintstoneBoardState *s, bool detached)
+{
+    if (detached == s->detached) {
+        return;
+    }
+    s->detached = detached;
+    qemu_set_irq(s->detect, detached);
+    board_emit(s, "BP-DETACHED", 'i', detached ? 1000 : 0);
+}
+
+static void board_set_line(FlintstoneBoardState *s, int line, bool level)
+{
+    assert(line >= 0 && line < FLINTSTONE_BOARD_IN);
+
+    if (level == s->lines[line]) {
+        return;
+    }
+    s->lines[line] = level;
+    board_emit(s, flintstone_board_in_names[line], 'o', level ? 1000 : 0);
+
+    if (line == FLINTSTONE_BOARD_IN_POWEROFF && level && s->poweroff_exit) {
+        /* The firmware believes it just cut the board's power. */
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    }
+}
+
+static void flintstone_board_hold_end(void *opaque)
+{
+    FlintstoneBoardState *s = opaque;
+
+    board_set_button(s, !s->hold_level);
+}
+
+static void board_command(FlintstoneBoardState *s, const char *line)
+{
+    g_auto(GStrv) argv = g_strsplit(line, " ", 0);
+    char *end;
+    int64_t ms;
+    int level;
+
+    if (!argv[0] || !*argv[0]) {
+        return;
+    }
+    if (!strcmp(argv[0], "dump")) {
+        /* A new listener starts from the whole picture. */
+        board_emit(s, "HU-BUTTON", 'i', s->button_level ? 1000 : 0);
+        for (int i = 0; i < FLINTSTONE_BOARD_IN; i++) {
+            board_emit(s, flintstone_board_in_names[i], 'o',
+                       s->lines[i] ? 1000 : 0);
+        }
+        board_emit(s, "BEEPER", 'o', s->beeper_hz);
+        board_emit(s, "BP-DETACHED", 'i', s->detached ? 1000 : 0);
+        return;
+    }
+    if (!strcmp(argv[0], "set") && argv[1] && argv[2] && !argv[3] &&
+        !strcmp(argv[1], "BP-DETACHED") &&
+        (!strcmp(argv[2], "0") || !strcmp(argv[2], "1"))) {
+        board_set_detached(s, argv[2][0] == '1');
+        return;
+    }
+    if ((!strcmp(argv[0], "set") || !strcmp(argv[0], "hold")) &&
+        argv[1] && argv[2] && !strcmp(argv[1], "HU-BUTTON") &&
+        (!strcmp(argv[2], "0") || !strcmp(argv[2], "1"))) {
+        level = argv[2][0] == '1';
+        if (!strcmp(argv[0], "set") && !argv[3]) {
+            board_set_button(s, level);
+            return;
+        }
+        if (!strcmp(argv[0], "hold") && argv[3] && !argv[4] &&
+            (ms = g_ascii_strtoll(argv[3], &end, 10)) > 0 && !*end) {
+            /* One hold at a time: a new one first lets the last go. */
+            if (timer_pending(s->hold)) {
+                timer_del(s->hold);
+                flintstone_board_hold_end(s);
+            }
+            s->hold_level = level;
+            board_set_button(s, level);
+            timer_mod(s->hold, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                               ms * SCALE_MS);
+            return;
+        }
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "flintstone.board: bad command '%s'\n",
+                  line);
+}
+
+static int board_chr_can_read(void *opaque)
+{
+    return 256;
+}
+
+static void board_chr_read(void *opaque, const uint8_t *buf, int size)
+{
+    FlintstoneBoardState *s = opaque;
+
+    for (int i = 0; i < size; i++) {
+        if (buf[i] == '\n') {
+            board_command(s, s->cmd->str);
+            g_string_truncate(s->cmd, 0);
+        } else if (buf[i] != '\r') {
+            g_string_append_c(s->cmd, buf[i]);
+        }
+    }
+}
+
+static void board_chr_event(void *opaque, QEMUChrEvent event)
+{
+    FlintstoneBoardState *s = opaque;
+
+    if (event == CHR_EVENT_OPENED) {
+        g_string_truncate(s->cmd, 0);
+        board_command(s, "dump");
+    }
+}
+
+static void flintstone_board_gpio_in(void *opaque, int line, int level)
+{
+    FlintstoneBoardState *s = opaque;
+
+    board_set_line(s, line, level != 0);
+}
+
+static void flintstone_board_beeper(void *opaque, int n, int hz)
+{
+    FlintstoneBoardState *s = opaque;
+
+    if (hz != s->beeper_hz) {
+        s->beeper_hz = hz;
+        board_emit(s, "BEEPER", 'o', hz);
+    }
+}
+
+static void flintstone_board_reset(DeviceState *dev)
+{
+    FlintstoneBoardState *s = FLINTSTONE_BOARD(dev);
+
+    if (s->hold) {
+        timer_del(s->hold);
+    }
+    memset(s->lines, 0, sizeof(s->lines));
+    /* The button rests unpressed: active high, idle low. */
+    s->button_level = false;
+    qemu_set_irq(s->button, 0);
+    /* The display sits on its base. */
+    s->detached = false;
+    qemu_set_irq(s->detect, 0);
+}
+
+static void flintstone_board_realize(DeviceState *dev, Error **errp)
+{
+    FlintstoneBoardState *s = FLINTSTONE_BOARD(dev);
+
+    qdev_init_gpio_out(dev, &s->button, 1);
+    qdev_init_gpio_out_named(dev, &s->detect, FLINTSTONE_BOARD_DETECT, 1);
+    qdev_init_gpio_in(dev, flintstone_board_gpio_in, FLINTSTONE_BOARD_IN);
+    qdev_init_gpio_in_named(dev, flintstone_board_beeper,
+                            FLINTSTONE_BOARD_BEEPER, 1);
+
+    s->cmd = g_string_new(NULL);
+    s->hold = timer_new_ns(QEMU_CLOCK_VIRTUAL, flintstone_board_hold_end, s);
+    if (qemu_chr_fe_backend_connected(&s->chr)) {
+        qemu_chr_fe_set_handlers(&s->chr, board_chr_can_read, board_chr_read,
+                                 board_chr_event, NULL, s, NULL, true);
+    }
+}
+
+static const Property flintstone_board_properties[] = {
+    DEFINE_PROP_CHR("chardev", FlintstoneBoardState, chr),
+    /*
+     * The firmware raises POWEROFF to cut the board's power; when the UI
+     * is watching, QEMU follows it and exits.
+     */
+    DEFINE_PROP_BOOL("poweroff-exit", FlintstoneBoardState, poweroff_exit,
+                     false),
+};
+
+static void flintstone_board_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = flintstone_board_realize;
+    device_class_set_legacy_reset(dc, flintstone_board_reset);
+    device_class_set_props(dc, flintstone_board_properties);
+    dc->desc = "Nest Display-3.4 board (button and power lines via chardev)";
+}
+
+static const TypeInfo flintstone_board_info = {
+    .name = TYPE_FLINTSTONE_BOARD,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(FlintstoneBoardState),
+    .class_init = flintstone_board_class_init,
+};
+
+static void flintstone_board_register_types(void)
+{
+    type_register_static(&flintstone_board_info);
+}
+
+type_init(flintstone_board_register_types)
diff --git a/hw/arm/fsl-imx6sx.c b/hw/arm/fsl-imx6sx.c
index 588932e..0e85816 100644
--- a/hw/arm/fsl-imx6sx.c
+++ b/hw/arm/fsl-imx6sx.c
@@ -184,6 +184,34 @@ static Notifier fsl_imx6sx_ccm_notifier = {
     .notify = fsl_imx6sx_ccm_init_done,
 };
 
+/* Anatop USB_ANALOG overlay: VBUS/charger detection for the imx_usb driver */
+static uint32_t usb_analog_regs[64];
+
+static uint64_t usb_analog_read(void *opaque, hwaddr addr, unsigned size)
+{
+    uint32_t *r = opaque;
+    uint32_t idx = addr / 4;
+    return (idx < 64) ? r[idx] : 0;
+}
+
+static void usb_analog_write(void *opaque, hwaddr addr,
+                              uint64_t value, unsigned size)
+{
+    uint32_t *r = opaque;
+    uint32_t idx = addr / 4;
+    if (idx < 64) {
+        r[idx] = value;
+    }
+}
+
+static const MemoryRegionOps usb_analog_ops = {
+    .read = usb_analog_read,
+    .write = usb_analog_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
 static void fsl_imx6sx_realize(DeviceState *dev, Error **errp)
 {
     MachineState *ms = MACHINE(qdev_get_machine());
@@ -596,6 +624,25 @@ static void fsl_imx6sx_realize(DeviceState *dev, Error **errp)
         create_unimplemented_device(nm, fsl_imx6sx_unimplemented[i].addr,
                                     fsl_imx6sx_unimplemented[i].size);
     }
+
+    /*
+     * USB charger detection: overlay the anatop USB_ANALOG registers
+     * so the imx_usb_charger driver sees VBUS present.  Without this,
+     * nlclient never detects USB connected and never creates the dropbox.
+     */
+    {
+        static MemoryRegion usb_analog_mr;
+
+        /* USB1_VBUS_DETECT_STAT (anatop+0x1C0): all VBUS thresholds met */
+        usb_analog_regs[0] = BIT(0) | BIT(2) | BIT(3) | BIT(4);
+        /* USB1_CHRG_DETECT_STAT (anatop+0x240): SDP (standard downstream) */
+        usb_analog_regs[0x80 / 4] = BIT(0) | BIT(1) | BIT(2) | BIT(3);
+        memory_region_init_io(&usb_analog_mr, NULL, &usb_analog_ops,
+                              usb_analog_regs, "anatop-usb-analog", 0x100);
+        memory_region_add_subregion(get_system_memory(),
+                                    FSL_IMX6SX_ANATOP_ADDR + 0x1C0,
+                                    &usb_analog_mr);
+    }
 }
 
 static const Property fsl_imx6sx_properties[] = {
diff --git a/hw/arm/j49.c b/hw/arm/j49.c
new file mode 100644
index 0000000..47fc46b
--- /dev/null
+++ b/hw/arm/j49.c
@@ -0,0 +1,339 @@
+/*
+ * Nest Learning Thermostat gen 2 ("j49", Display-2.x) machine
+ *
+ * An AM3703 (OMAP3630 family) with 64 MiB of mobile DDR, a 256 MiB Micron
+ * MT29F2G16 x16 NAND on GPMC chip select 0 and a TPS65921 on I2C1. The
+ * goal is to boot the unit's own firmware unmodified from its NAND: the
+ * GP-image x-loader, U-Boot 2012.10, the 2.6.37 kernel and its JFFS2 root.
+ *
+ * The NAND drive (-drive if=none,id=nand,format=raw,file=...) is the raw
+ * image: 2112-byte pages, data then OOB.
+ *
+ * Boot ROM: as the AM3703's ROM does for a GP device booting from NAND, the
+ * machine reads the image at block 0 - a little-endian size and load
+ * address, then the code - from the pages' data areas into SRAM, and starts
+ * the CPU in the ROM, which launches it.
+
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/arm/omap3630.h"
+#include "hw/arm/j49_board.h"
+#include "hw/arm/machines-qom.h"
+#include "hw/core/boards.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/core/cpu.h"
+#include "hw/core/split-irq.h"
+#include "hw/misc/em35x_ncp.h"
+#include "hw/misc/tps65921.h"
+#include "hw/net/wl1271.h"
+#include "hw/sd/sd.h"
+#include "net/net.h"
+#include "system/address-spaces.h"
+#include "system/block-backend.h"
+#include "system/blockdev.h"
+#include "system/reset.h"
+#include "system/system.h"
+#include "system/qtest.h"
+#include "qemu/error-report.h"
+#include "qemu/timer.h"
+#include "qemu/units.h"
+#include "qapi/visitor.h"
+
+#define J49_RAM_SIZE        (64 * MiB)
+/* The battery reaches ADCIN0 through a divide-by-three (Nest's
+ * nlReadBatteryLevel: volts = 3 * mV / 1000). A charged cell. */
+#define J49_BATTERY_MV      3900
+
+/*
+ * The ring, as the page turns it: /machine/wheel-position counts detents
+ * (as on the flintstone; the page has 24 to the turn), and the ring has
+ * none of its own. The sensor reads the ring's inner edge at the coarse
+ * resolution adbs-a330 sets (OFN_RESOLUTION RES=1, nominally 250 cpi):
+ * about 2400 counts to the turn, so J49_RING_COUNTS a detent. Positive
+ * counts move nlclient's selection counterclockwise, so a clockwise turn
+ * (the position going up) feeds negative ones. The counts go in as a hand
+ * turns a ring, a few at each of the driver's 60 Hz reports, not all at
+ * once: nlclient integrates the stream, and takes one large report as a
+ * flick.
+ */
+#define J49_RING_COUNTS     100
+#define J49_RING_SLEW       34              /* counts per 1/60 s */
+
+struct J49Wheel {
+    int64_t position;
+    Object *ring;
+    int64_t owed;                   /* counts still to turn */
+    QEMUTimer *slew;
+};
+
+static void j49_wheel_slew(void *opaque)
+{
+    struct J49Wheel *w = opaque;
+    int64_t step = MAX(MIN(w->owed, J49_RING_SLEW), -J49_RING_SLEW);
+
+    if (!step) {
+        return;
+    }
+    object_property_set_int(w->ring, "motion", step, &error_abort);
+    w->owed -= step;
+    timer_mod(w->slew, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                       NANOSECONDS_PER_SECOND / 60);
+}
+
+static void j49_get_wheel(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    struct J49Wheel *w = opaque;
+
+    visit_type_int64(v, name, &w->position, errp);
+}
+
+static void j49_set_wheel(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    struct J49Wheel *w = opaque;
+    int64_t position;
+
+    if (!visit_type_int64(v, name, &position, errp)) {
+        return;
+    }
+    w->owed -= (position - w->position) * J49_RING_COUNTS;
+    w->position = position;
+    if (!timer_pending(w->slew)) {
+        j49_wheel_slew(w);
+    }
+}
+
+struct J49RomBoot {
+    Omap3630State *soc;
+    BlockBackend *blk;
+};
+
+/* Read `len` data bytes from the NAND's data areas, from data offset `off`. */
+static bool j49_nand_read_data(BlockBackend *blk, uint64_t off, uint8_t *buf,
+                               uint32_t len)
+{
+    while (len) {
+        uint64_t page = off / OMAP3_NAND_PAGE, col = off % OMAP3_NAND_PAGE;
+        uint32_t n = MIN(len, OMAP3_NAND_PAGE - col);
+
+        if (blk_pread(blk, page * OMAP3_NAND_PAGE_RAW + col, n, buf, 0) < 0) {
+            return false;
+        }
+        off += n;
+        buf += n;
+        len -= n;
+    }
+    return true;
+}
+
+static void j49_rom_boot(void *opaque)
+{
+    struct J49RomBoot *rom = opaque;
+    uint8_t hdr[8];
+    g_autofree uint8_t *image = NULL;
+    uint32_t size, load;
+
+    /* Nothing else resets the CPU (no arm_load_kernel): a watchdog or
+     * software reboot must not resume with the MMU and caches on. */
+    cpu_reset(first_cpu);
+
+    if (!j49_nand_read_data(rom->blk, 0, hdr, sizeof(hdr))) {
+        error_report("j49: boot ROM could not read the NAND");
+        exit(1);
+    }
+    size = ldl_le_p(hdr);
+    load = ldl_le_p(hdr + 4);
+    if (load < OMAP3630_SRAM_ADDR ||
+        size > OMAP3630_SRAM_ADDR + OMAP3630_SRAM_SIZE - load) {
+        error_report("j49: no GP boot image in NAND block 0 (size 0x%" PRIx32
+                     ", load 0x%" PRIx32 ")", size, load);
+        exit(1);
+    }
+    image = g_malloc(size);
+    if (!j49_nand_read_data(rom->blk, sizeof(hdr), image, size)) {
+        error_report("j49: boot ROM could not read the boot image");
+        exit(1);
+    }
+    cpu_physical_memory_write(load, image, size);
+    omap3630_rom_set_entry(rom->soc, load);
+    cpu_set_pc(first_cpu, OMAP3630_ROM_ADDR);
+}
+
+/*
+ * The wifi module on MMC2: a WL1271 behind an SDIO card. WLAN_EN is GPIO
+ * 103 (the "vmmc2" fixed regulator), which powers both and is reported to
+ * the board; WLAN_IRQ is GPIO 102, level high (board-diamond.c).
+ * -nic user,model=wl1271 is the network behind the access point.
+ */
+static void j49_init_wifi(Omap3630State *soc, DeviceState *board)
+{
+    DeviceState *card = qdev_new(TYPE_SDIO_CARD);
+    DeviceState *chip = qdev_new(TYPE_WL1271);
+    DeviceState *wlan_en = qdev_new(TYPE_SPLIT_IRQ);
+
+    qemu_configure_nic_device(chip, true, NULL);
+    qdev_realize_and_unref(chip, NULL, &error_fatal);
+
+    /* TI's IDs; the driver takes function 2. */
+    qdev_prop_set_uint8(card, "class", 0);
+    qdev_prop_set_uint16(card, "vendor-id", 0x0097);
+    qdev_prop_set_uint16(card, "device-id", 0x4076);
+    qdev_prop_set_uint16(card, "device-id-f2", 0x4076);
+    /* MMC2 runs at 1.8 V (vmmc2), which the WL1271 takes. */
+    qdev_prop_set_uint32(card, "ocr", 0x00ff8080);
+    object_property_set_link(OBJECT(card), "function-device", OBJECT(chip),
+                             &error_fatal);
+    qdev_realize_and_unref(card,
+                           qdev_get_child_bus(DEVICE(&soc->mmc[1].sdhci),
+                                              "sd-bus"),
+                           &error_fatal);
+
+    qdev_prop_set_uint32(wlan_en, "num-lines", 3);
+    qdev_realize_and_unref(wlan_en, NULL, &error_fatal);
+    qdev_connect_gpio_out(DEVICE(&soc->gpio[3]), 7,
+                          qdev_get_gpio_in(wlan_en, 0));
+    qdev_connect_gpio_out(wlan_en, 0,
+                          qdev_get_gpio_in(board, J49_BOARD_IN_WIFI_ENABLE));
+    qdev_connect_gpio_out(wlan_en, 1,
+                          qdev_get_gpio_in_named(card, "power", 0));
+    qdev_connect_gpio_out(wlan_en, 2,
+                          qdev_get_gpio_in_named(chip, "power", 0));
+
+    qdev_connect_gpio_out_named(chip, "irq", 0,
+                                qdev_get_gpio_in(DEVICE(&soc->gpio[3]), 6));
+}
+
+/*
+ * The EM357 radio (board-diamond.c j49_zigbee_device, spidev2.0): on McSPI2
+ * chip select 0, nRESET on GPIO 61 and nHOST_INT into GPIO 182. The j49
+ * wires no nWAKE. -global em35x-ncp.chardev=... attaches qemu/ui/em35x.py.
+ */
+static void j49_init_ncp(Omap3630State *soc)
+{
+    DeviceState *ncp = qdev_new(TYPE_EM35X_NCP);
+
+    qdev_realize_and_unref(ncp, qdev_get_child_bus(DEVICE(&soc->mcspi[1]),
+                                                   "spi"),
+                           &error_fatal);
+    qdev_connect_gpio_out(DEVICE(&soc->mcspi[1]), 0,
+                          qdev_get_gpio_in_named(ncp, EM35X_NCP_NSSEL, 0));
+    qdev_connect_gpio_out(DEVICE(&soc->gpio[1]), 29,
+                          qdev_get_gpio_in_named(ncp, EM35X_NCP_NRESET, 0));
+    qdev_connect_gpio_out_named(ncp, EM35X_NCP_NHOST_INT, 0,
+                                qdev_get_gpio_in(DEVICE(&soc->gpio[5]), 22));
+}
+
+static void j49_init(MachineState *machine)
+{
+    Omap3630State *soc;
+    BlockBackend *nand = blk_by_name("nand");
+    struct J49RomBoot *rom;
+    I2CSlave *pmic, *ring;
+    DeviceState *board;
+    struct J49Wheel *wheel;
+
+    if (machine->ram_size != J49_RAM_SIZE) {
+        error_report("j49: this board has %lu MiB of SDRAM",
+                     (unsigned long)(J49_RAM_SIZE / MiB));
+        exit(1);
+    }
+    /* qtest builds the machine without a firmware to boot. */
+    if (!nand && !qtest_enabled()) {
+        error_report("j49: the board boots from its NAND: "
+                     "-drive if=none,id=nand,format=raw,file=NAND.raw");
+        exit(1);
+    }
+
+    soc = OMAP3630(object_new(TYPE_OMAP3630));
+    object_property_add_child(OBJECT(machine), "soc", OBJECT(soc));
+    if (nand) {
+        qdev_prop_set_drive_err(DEVICE(&soc->gpmc), "drive", nand,
+                                &error_fatal);
+    }
+    for (int i = 0; i < OMAP3630_NUM_UART && i < 3; i++) {
+        qdev_prop_set_chr(DEVICE(&soc->uart[i]), "chardev", serial_hd(i));
+    }
+    qdev_realize(DEVICE(soc), NULL, &error_fatal);
+    object_unref(OBJECT(soc));
+
+    memory_region_add_subregion(get_system_memory(), OMAP3630_SDRAM_ADDR,
+                                machine->ram);
+
+    /* The TPS65921 on I2C1, its SYS_NIRQ into the MPU's sys_nirq. */
+    pmic = i2c_slave_new(TYPE_TPS65921, TPS65921_ADDR);
+    object_property_add_child(OBJECT(machine), "pmic", OBJECT(pmic));
+    i2c_slave_realize_and_unref(pmic, soc->i2c[0].bus, &error_fatal);
+    qdev_connect_gpio_out(DEVICE(pmic), 0,
+                          qdev_get_gpio_in(DEVICE(&soc->intc),
+                                           OMAP3630_IRQ_SYS_NIRQ));
+    object_property_set_uint(OBJECT(pmic), "adcin0-mv", J49_BATTERY_MV / 3,
+                             &error_fatal);
+
+    /* The panel backlight driver on I2C3 (board-diamond.c lm3530-backlight). */
+    i2c_slave_create_simple(soc->i2c[2].bus, "lm3530", 0x36);
+
+    /*
+     * The ring: an optical finger navigation sensor on I2C2 at 0x57, its
+     * MOTION_L into GPIO 108 (bank 4, line 12). /machine/ring.motion takes
+     * the turns.
+     */
+    ring = i2c_slave_new("adbs-a330", 0x57);
+    object_property_add_child(OBJECT(machine), "ring", OBJECT(ring));
+    i2c_slave_realize_and_unref(ring, soc->i2c[1].bus, &error_fatal);
+    qdev_connect_gpio_out(DEVICE(ring), 0,
+                          qdev_get_gpio_in(DEVICE(&soc->gpio[3]), 12));
+    wheel = g_new0(struct J49Wheel, 1);
+    wheel->ring = OBJECT(ring);
+    wheel->slew = timer_new_ns(QEMU_CLOCK_VIRTUAL, j49_wheel_slew, wheel);
+    object_property_add(OBJECT(machine), "wheel-position", "int",
+                        j49_get_wheel, j49_set_wheel, NULL, wheel);
+
+    /*
+     * The board around the SoC (j49.board, -global j49.board.chardev=...):
+     * its button is the ring's click on the TPS65921's PWRON; it watches
+     * the battery disconnect (GPIO 161), the WL1271 enable (GPIO 103) and
+     * the piezo enable (GPIO 58).
+     */
+    board = qdev_new(TYPE_J49_BOARD);
+    object_property_add_child(OBJECT(machine), "board", OBJECT(board));
+    qdev_realize_and_unref(board, NULL, &error_fatal);
+    qdev_connect_gpio_out(board, 0, qdev_get_gpio_in(DEVICE(pmic), 0));
+    qdev_connect_gpio_out(DEVICE(&soc->gpio[5]), 1,
+                          qdev_get_gpio_in(board, J49_BOARD_IN_POWEROFF));
+    qdev_connect_gpio_out(DEVICE(&soc->gpio[1]), 26,
+                          qdev_get_gpio_in(board, J49_BOARD_IN_BEEPER_ENABLE));
+    /* The piezo: pwm-beeper on GPTIMER11's PWM pin (omap-pwm timer 11). */
+    qdev_connect_gpio_out_named(DEVICE(&soc->gpt[10]), OMAP3_GPTIMER_PWM_HZ, 0,
+                                qdev_get_gpio_in_named(board, J49_BOARD_BEEPER,
+                                                       0));
+    j49_init_wifi(soc, board);
+    j49_init_ncp(soc);
+
+    if (nand) {
+        rom = g_new0(struct J49RomBoot, 1);
+        rom->soc = soc;
+        rom->blk = nand;
+        qemu_register_reset(j49_rom_boot, rom);
+    }
+}
+
+static void j49_machine_class_init(MachineClass *mc)
+{
+    mc->desc = "Nest Learning Thermostat gen 2 (AM3703, 'j49')";
+    mc->init = j49_init;
+    mc->min_cpus = 1;
+    mc->max_cpus = 1;
+    mc->default_cpus = 1;
+    mc->default_ram_size = J49_RAM_SIZE;
+    mc->default_ram_id = "j49.ram";
+}
+
+DEFINE_MACHINE_ARM("j49", j49_machine_class_init)
diff --git a/hw/arm/j49_board.c b/hw/arm/j49_board.c
new file mode 100644
index 0000000..86eb22c
--- /dev/null
+++ b/hw/arm/j49_board.c
@@ -0,0 +1,252 @@
+/*
+ * The board around the AM3703, as a chardev - Nest gen 2 (j49)
+ *
+ * The other end of the j49's front controls and of the lines its firmware
+ * drives, so something outside QEMU can press the button and watch the
+ * board, with nothing in the guest knowing it is being watched. It speaks
+ * the protocol of the flintstone's board device, which run.sh --ui's page
+ * already understands:
+ *
+ *   HU-BUTTON   (out of this device, into the TPS65921's PWRON) the
+ *               ring's click, twl4030_pwrbutton, KEY_POWER.
+ *   POWEROFF    (GPIO 161) the battery disconnect: Linux's power-off
+ *               raises it to cut the board's power.
+ *   WIFI-ENABLE (GPIO 103) the WL1271's enable.
+ *   BEEPER-EN   (GPIO 58) the piezo's enable (active low).
+ *   BEEPER      the piezo's drive, as its frequency in Hz.
+ *
+ * Lines out, one per change, stamped with guest time in microseconds
+ * (level in permille, 0 and 1000; Hz for BEEPER):
+ *
+ *   POWEROFF out 1000 1234567
+ *   HU-BUTTON in 1000 1234567
+ *
+ * Lines in:
+ *
+ *   set HU-BUTTON 1             press the button (0 = release)
+ *   hold HU-BUTTON 1 3000       press it for 3000 ms of guest time
+ *   dump                        report every line again
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "chardev/char-fe.h"
+#include "hw/arm/j49_board.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "system/runstate.h"
+
+static const char *const j49_board_in_names[J49_BOARD_IN] = {
+    "POWEROFF",
+    "WIFI-ENABLE",
+    "BEEPER-EN",
+};
+
+struct J49BoardState {
+    DeviceState parent_obj;
+
+    CharFrontend chr;
+    QEMUTimer *hold;            /* ends the pending "hold" */
+    int hold_level;
+    GString *cmd;
+
+    bool poweroff_exit;
+
+    qemu_irq button;            /* into the TPS65921's PWRON */
+    bool button_level;
+
+    bool lines[J49_BOARD_IN];
+    int beeper_hz;
+};
+
+static void board_emit(J49BoardState *s, const char *name, char dir, int level)
+{
+    int64_t t = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    g_autofree char *line = g_strdup_printf("%s %s %d %" PRId64 "\n", name,
+                                            dir == 'i' ? "in" : "out", level,
+                                            t / SCALE_US);
+
+    qemu_chr_fe_write_all(&s->chr, (const uint8_t *)line, strlen(line));
+}
+
+static void board_set_button(J49BoardState *s, bool level)
+{
+    if (level == s->button_level) {
+        return;
+    }
+    s->button_level = level;
+    qemu_set_irq(s->button, level);
+    board_emit(s, "HU-BUTTON", 'i', level ? 1000 : 0);
+}
+
+static void board_set_line(J49BoardState *s, int line, bool level)
+{
+    if (level == s->lines[line]) {
+        return;
+    }
+    s->lines[line] = level;
+    board_emit(s, j49_board_in_names[line], 'o', level ? 1000 : 0);
+
+    if (line == J49_BOARD_IN_POWEROFF && level && s->poweroff_exit) {
+        /* The firmware believes it just cut the board's power. */
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    }
+}
+
+static void board_hold_end(void *opaque)
+{
+    J49BoardState *s = opaque;
+
+    board_set_button(s, !s->hold_level);
+}
+
+static void board_command(J49BoardState *s, const char *line)
+{
+    g_auto(GStrv) argv = g_strsplit(line, " ", 0);
+    char *end;
+    int64_t ms;
+    int level;
+
+    if (!argv[0] || !*argv[0]) {
+        return;
+    }
+    if (!strcmp(argv[0], "dump")) {
+        board_emit(s, "HU-BUTTON", 'i', s->button_level ? 1000 : 0);
+        for (int i = 0; i < J49_BOARD_IN; i++) {
+            board_emit(s, j49_board_in_names[i], 'o', s->lines[i] ? 1000 : 0);
+        }
+        board_emit(s, "BEEPER", 'o', s->beeper_hz);
+        return;
+    }
+    if ((!strcmp(argv[0], "set") || !strcmp(argv[0], "hold")) &&
+        argv[1] && argv[2] && !strcmp(argv[1], "HU-BUTTON") &&
+        (!strcmp(argv[2], "0") || !strcmp(argv[2], "1"))) {
+        level = argv[2][0] == '1';
+        if (!strcmp(argv[0], "set") && !argv[3]) {
+            board_set_button(s, level);
+            return;
+        }
+        if (!strcmp(argv[0], "hold") && argv[3] && !argv[4] &&
+            (ms = g_ascii_strtoll(argv[3], &end, 10)) > 0 && !*end) {
+            if (timer_pending(s->hold)) {
+                timer_del(s->hold);
+                board_hold_end(s);
+            }
+            s->hold_level = level;
+            board_set_button(s, level);
+            timer_mod(s->hold, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                               ms * SCALE_MS);
+            return;
+        }
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "j49.board: bad command '%s'\n", line);
+}
+
+static int board_chr_can_read(void *opaque)
+{
+    return 256;
+}
+
+static void board_chr_read(void *opaque, const uint8_t *buf, int size)
+{
+    J49BoardState *s = opaque;
+
+    for (int i = 0; i < size; i++) {
+        if (buf[i] == '\n') {
+            board_command(s, s->cmd->str);
+            g_string_truncate(s->cmd, 0);
+        } else if (buf[i] != '\r') {
+            g_string_append_c(s->cmd, buf[i]);
+        }
+    }
+}
+
+static void board_chr_event(void *opaque, QEMUChrEvent event)
+{
+    J49BoardState *s = opaque;
+
+    if (event == CHR_EVENT_OPENED) {
+        g_string_truncate(s->cmd, 0);
+        board_command(s, "dump");
+    }
+}
+
+static void board_gpio_in(void *opaque, int line, int level)
+{
+    board_set_line(opaque, line, level != 0);
+}
+
+static void board_beeper(void *opaque, int n, int hz)
+{
+    J49BoardState *s = opaque;
+
+    if (hz != s->beeper_hz) {
+        s->beeper_hz = hz;
+        board_emit(s, "BEEPER", 'o', hz);
+    }
+}
+
+static void board_reset(DeviceState *dev)
+{
+    J49BoardState *s = J49_BOARD(dev);
+
+    if (s->hold) {
+        timer_del(s->hold);
+    }
+    memset(s->lines, 0, sizeof(s->lines));
+    s->button_level = false;
+    qemu_set_irq(s->button, 0);
+}
+
+static void board_realize(DeviceState *dev, Error **errp)
+{
+    J49BoardState *s = J49_BOARD(dev);
+
+    qdev_init_gpio_out(dev, &s->button, 1);
+    qdev_init_gpio_in(dev, board_gpio_in, J49_BOARD_IN);
+    qdev_init_gpio_in_named(dev, board_beeper, J49_BOARD_BEEPER, 1);
+
+    s->cmd = g_string_new(NULL);
+    s->hold = timer_new_ns(QEMU_CLOCK_VIRTUAL, board_hold_end, s);
+    if (qemu_chr_fe_backend_connected(&s->chr)) {
+        qemu_chr_fe_set_handlers(&s->chr, board_chr_can_read, board_chr_read,
+                                 board_chr_event, NULL, s, NULL, true);
+    }
+}
+
+static const Property board_properties[] = {
+    DEFINE_PROP_CHR("chardev", J49BoardState, chr),
+    /* POWEROFF cuts the board's power; when the UI watches, QEMU exits. */
+    DEFINE_PROP_BOOL("poweroff-exit", J49BoardState, poweroff_exit, false),
+};
+
+static void board_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = board_realize;
+    device_class_set_legacy_reset(dc, board_reset);
+    device_class_set_props(dc, board_properties);
+    dc->desc = "Nest gen 2 board (button and power lines via chardev)";
+}
+
+static const TypeInfo board_info = {
+    .name = TYPE_J49_BOARD,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(J49BoardState),
+    .class_init = board_class_init,
+};
+
+static void board_register_types(void)
+{
+    type_register_static(&board_info);
+}
+
+type_init(board_register_types)

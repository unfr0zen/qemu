diff --git a/hw/misc/omap3_bch.c b/hw/misc/omap3_bch.c
new file mode 100644
index 0000000..de00131
--- /dev/null
+++ b/hw/misc/omap3_bch.c
@@ -0,0 +1,118 @@
+/*
+ * BCH parity for the OMAP3 GPMC ECC engine
+ *
+ * The GPMC's 4-bit BCH code: GF(2^13) with the primitive polynomial
+ * x^13 + x^4 + x^3 + x + 1 (0x201b), generator g(x) = lcm of the minimal
+ * polynomials of a, a^3, a^5, a^7 (degree 52). The parity of a sector is
+ * the remainder of data(x) * x^52 by g(x), data bits taken most
+ * significant bit of the first byte first.
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/omap3_bch.h"
+
+#define GF_M        13
+#define GF_N        ((1 << GF_M) - 1)
+#define GF_POLY     0x201b
+
+static uint64_t bch4_generator;     /* bit i: coefficient of x^i, i < 52 */
+
+static void omap3_bch4_init(void)
+{
+    uint16_t exp[2 * GF_N], log[GF_N + 1];
+    uint8_t g[64] = { 1 };          /* GF(2) coefficients, g[0] = 1 */
+    int deg = 0;
+    int done[GF_N] = { 0 };
+
+    for (int i = 0, x = 1; i < GF_N; i++) {
+        exp[i] = exp[i + GF_N] = x;
+        log[x] = i;
+        x <<= 1;
+        if (x & (1 << GF_M)) {
+            x ^= GF_POLY;
+        }
+    }
+
+    for (int r = 1; r <= 7; r += 2) {
+        /* minimal polynomial of a^r: product over its cyclotomic coset */
+        uint16_t m[GF_M + 2] = { 1 };   /* coefficients in GF(2^13) */
+        int mdeg = 0;
+
+        if (done[r]) {
+            continue;
+        }
+        for (int j = r; !done[j]; j = (j * 2) % GF_N) {
+            done[j] = 1;
+            /* m(x) *= (x + a^j) */
+            for (int k = mdeg + 1; k >= 0; k--) {
+                uint16_t prev = k ? m[k - 1] : 0;
+                uint16_t mul = m[k] ? exp[log[m[k]] + j] : 0;
+
+                m[k] = prev ^ mul;
+            }
+            mdeg++;
+        }
+        /* g(x) *= m(x); m's coefficients are all 0 or 1 */
+        {
+            uint8_t prod[64] = { 0 };
+
+            for (int a = 0; a <= deg; a++) {
+                for (int b = 0; b <= mdeg; b++) {
+                    prod[a + b] ^= g[a] & (m[b] & 1);
+                }
+            }
+            memcpy(g, prod, sizeof(g));
+            deg += mdeg;
+        }
+    }
+
+    bch4_generator = 0;
+    for (int i = 0; i < OMAP3_BCH4_BITS; i++) {
+        bch4_generator |= (uint64_t)g[i] << i;
+    }
+}
+
+uint64_t omap3_bch4_parity(const uint8_t *data, size_t len)
+{
+    const uint64_t top = 1ull << (OMAP3_BCH4_BITS - 1);
+    const uint64_t mask = (1ull << OMAP3_BCH4_BITS) - 1;
+    uint64_t r = 0;
+
+    if (!bch4_generator) {
+        omap3_bch4_init();
+    }
+    for (size_t i = 0; i < len; i++) {
+        for (int b = 7; b >= 0; b--) {
+            uint64_t feedback = ((r & top) != 0) ^ ((data[i] >> b) & 1);
+
+            r = (r << 1) & mask;
+            if (feedback) {
+                r ^= bch4_generator;
+            }
+        }
+    }
+    return r;
+}
+
+uint64_t omap3_bch4_mulx52(uint64_t r)
+{
+    const uint64_t top = 1ull << (OMAP3_BCH4_BITS - 1);
+    const uint64_t mask = (1ull << OMAP3_BCH4_BITS) - 1;
+
+    if (!bch4_generator) {
+        omap3_bch4_init();
+    }
+    for (int i = 0; i < OMAP3_BCH4_BITS; i++) {
+        bool feedback = r & top;
+
+        r = (r << 1) & mask;
+        if (feedback) {
+            r ^= bch4_generator;
+        }
+    }
+    return r;
+}
diff --git a/hw/misc/omap3_gpmc.c b/hw/misc/omap3_gpmc.c
new file mode 100644
index 0000000..236fe98
--- /dev/null
+++ b/hw/misc/omap3_gpmc.c
@@ -0,0 +1,766 @@
+/*
+ * OMAP3 general-purpose memory controller (GPMC) with a NAND flash on
+ * one chip select and the BCH ECC engine
+ *
+ * The NAND is the board's Micron MT29F2G16 (x16, 2048 + 64 byte pages, 64
+ * pages a block), its backend a raw image: each
+ * page's 2048 data bytes followed by its 64 OOB bytes, ECC included.
+ * Software reaches it through the chip select's NAND_COMMAND/ADDRESS/DATA
+ * registers, or the chip select's window for data (Linux and U-Boot read
+ * through the window, x-loader through NAND_DATA). Programming ANDs into
+ * the page and erasing fills the block with 0xff, as flash does; both are
+ * refused while GPMC_CONFIG drives the write-protect pin low.
+ *
+ * The chip has no ONFI parameter page: READ ID at 0x20 repeats the ID, so
+ * software sizes it from the ID's fourth byte (0x55: 2 KiB pages, 64-byte
+ * OOB, 128 KiB blocks, x16).
+ *
+ * The prefetch/write-posting engine (polled use, as Linux drives it): once
+ * started for TRANSFERCOUNT bytes on the NAND's chip select, its FIFO
+ * always holds (or has room for) the next min(64, remaining) bytes, which
+ * software moves through the chip-select window; COUNTVALUE reaches 0
+ * when they have all gone through.
+ *
+ * BCH engine: every byte moved through the data port of the configured chip
+ * select while the engine is enabled is recorded. In wrap mode 6 (writing)
+ * a sector's result is the BCH4 parity of its 512 data bytes; in wrap
+ * mode 9 (reading), once the page's OOB has also been read, it is the
+ * received code word (data, then the stored code at OOB 36 + 7 * sector)
+ * times x^52, modulo the generator: zero when it is intact. That is the
+ * form the decoders x-loader, U-Boot and Linux share expect, data bit
+ * 8 * byte + bit (LSB first) at degree 104 + 4095 - (8 * byte + 7 - bit);
+ * a flipped parity bit lands below degree 104, where they find no data
+ * error to correct ("BCH decoding failed", the data left as read).
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/omap3_gpmc.h"
+#include "hw/misc/omap3_bch.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "migration/vmstate.h"
+#include "system/block-backend.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/units.h"
+
+#define GPMC_REVISION           0x000
+#define GPMC_SYSCONFIG          0x010
+#define GPMC_SYSSTATUS          0x014
+#define GPMC_IRQSTATUS          0x018
+#define GPMC_IRQENABLE          0x01c
+#define GPMC_TIMEOUT_CONTROL    0x040
+#define GPMC_ERR_ADDRESS        0x044
+#define GPMC_ERR_TYPE           0x048
+#define GPMC_CONFIG             0x050
+#define GPMC_STATUS             0x054
+#define GPMC_CS_BASE            0x060   /* + 0x30 * cs */
+#define GPMC_CS_STRIDE          0x30
+#define GPMC_CS_CONFIG1         0x00
+#define GPMC_CS_CONFIG7         0x18
+#define GPMC_CS_NAND_COMMAND    0x1c
+#define GPMC_CS_NAND_ADDRESS    0x20
+#define GPMC_CS_NAND_DATA       0x24
+#define GPMC_PREFETCH_CONFIG1   0x1e0
+#define GPMC_PREFETCH_CONFIG2   0x1e4
+#define GPMC_PREFETCH_CONTROL   0x1ec
+#define GPMC_PREFETCH_STATUS    0x1f0
+#define GPMC_ECC_CONFIG         0x1f4
+#define GPMC_ECC_CONTROL        0x1f8
+#define GPMC_ECC_SIZE_CONFIG    0x1fc
+#define GPMC_ECC_RESULT         0x200   /* 1..9 */
+#define GPMC_BCH_RESULT         0x240   /* + 0x10 * sector, 4 words */
+#define GPMC_BCH_SWDATA         0x2d0
+
+#define CONFIG_WRITEPROTECT     (1 << 4)
+#define STATUS_EMPTYWRITEBUFFER (1 << 0)
+#define STATUS_WAIT0            (1 << 8)
+#define IRQ_WAIT0EDGE           (1 << 8)
+
+#define CONFIG1_DEVICESIZE(v)   (((v) >> 12) & 3)
+#define CONFIG7_BASE(v)         ((v) & 0x3f)
+#define CONFIG7_CSVALID         (1 << 6)
+#define CONFIG7_MASK(v)         (((v) >> 8) & 0xf)
+
+#define PREFETCH_ENGINE_CS(v)   (((v) >> 24) & 7)
+#define PREFETCH_ENABLEENGINE   (1 << 7)
+#define PREFETCH_STARTENGINE    (1 << 0)
+#define PREFETCH_FIFO           64
+#define IRQ_TERMINALCOUNT       (1 << 1)
+
+#define ECC_CONFIG_ENABLE       (1 << 0)
+#define ECC_CONFIG_CS(v)        (((v) >> 1) & 7)
+#define ECC_CONFIG_TOPSECTOR(v) (((v) >> 4) & 7)
+#define ECC_CONFIG_WRAPMODE(v)  (((v) >> 8) & 0xf)
+#define ECC_CONFIG_BCHT8        (1 << 12)
+#define ECC_CONFIG_BCH          (1 << 16)
+#define ECC_CONTROL_CLEAR       (1 << 8)
+
+#define BCH4_WRAP_READ          9
+#define BCH4_ECC_OFFSET         36
+#define BCH4_ECC_BYTES          7
+
+/* what data-port reads return */
+enum {
+    OUT_NONE,
+    OUT_ID,
+    OUT_STATUS,
+    OUT_PAGE,
+};
+
+#define NAND_STATUS_READY       0x60
+#define NAND_STATUS_NOT_WP      0x80
+#define NAND_STATUS_FAIL        0x01
+
+static bool gpmc_nand_wide(Omap3GpmcState *s)
+{
+    return CONFIG1_DEVICESIZE(s->cs_config[s->nand_cs][0]) == 1;
+}
+
+static uint64_t gpmc_page_offset(uint32_t row)
+{
+    return (uint64_t)row * OMAP3_NAND_PAGE_RAW;
+}
+
+static void gpmc_nand_load(Omap3GpmcState *s)
+{
+    if (s->row >= s->nand_pages ||
+        blk_pread(s->blk, gpmc_page_offset(s->row), OMAP3_NAND_PAGE_RAW,
+                  s->page_buf, 0) < 0) {
+        memset(s->page_buf, 0xff, sizeof(s->page_buf));
+    }
+}
+
+static bool gpmc_nand_writable(Omap3GpmcState *s)
+{
+    return s->config & CONFIG_WRITEPROTECT;     /* nWP driven high */
+}
+
+static void gpmc_nand_ready(Omap3GpmcState *s)
+{
+    s->irqstatus |= IRQ_WAIT0EDGE;
+    qemu_set_irq(s->irq, !!(s->irqstatus & s->irqenable));
+}
+
+static void gpmc_nand_program(Omap3GpmcState *s)
+{
+    uint8_t page[OMAP3_NAND_PAGE_RAW];
+
+    s->status &= ~NAND_STATUS_FAIL;
+    if (!gpmc_nand_writable(s) || s->row >= s->nand_pages ||
+        blk_pread(s->blk, gpmc_page_offset(s->row), sizeof(page), page, 0) < 0) {
+        s->status |= NAND_STATUS_FAIL;
+        return;
+    }
+    for (int i = 0; i < OMAP3_NAND_PAGE_RAW; i++) {
+        page[i] &= s->page_buf[i];
+    }
+    if (blk_pwrite(s->blk, gpmc_page_offset(s->row), sizeof(page), page, 0) < 0) {
+        s->status |= NAND_STATUS_FAIL;
+    }
+}
+
+static void gpmc_nand_erase(Omap3GpmcState *s)
+{
+    uint32_t first = s->row & ~(OMAP3_NAND_PAGES_PER_BLOCK - 1);
+    uint64_t len = (uint64_t)OMAP3_NAND_PAGES_PER_BLOCK * OMAP3_NAND_PAGE_RAW;
+    g_autofree uint8_t *block = NULL;
+
+    s->status &= ~NAND_STATUS_FAIL;
+    if (!gpmc_nand_writable(s) || first >= s->nand_pages) {
+        s->status |= NAND_STATUS_FAIL;
+        return;
+    }
+    block = g_malloc(len);
+    memset(block, 0xff, len);
+    if (blk_pwrite(s->blk, gpmc_page_offset(first), len, block, 0) < 0) {
+        s->status |= NAND_STATUS_FAIL;
+    }
+}
+
+/* Column cycles count words on an x16 part. */
+static uint32_t gpmc_nand_column(Omap3GpmcState *s)
+{
+    uint32_t col = s->addr[0] | (s->addr[1] << 8);
+
+    return gpmc_nand_wide(s) ? col * 2 : col;
+}
+
+static void gpmc_nand_command(Omap3GpmcState *s, uint8_t cmd)
+{
+    switch (cmd) {
+    case 0xff:                  /* RESET */
+        s->out_mode = OUT_NONE;
+        s->programming = false;
+        s->status = NAND_STATUS_READY | NAND_STATUS_NOT_WP;
+        gpmc_nand_ready(s);
+        break;
+    case 0x90:                  /* READ ID */
+    case 0x00:                  /* READ */
+    case 0x05:                  /* CHANGE READ COLUMN */
+    case 0x60:                  /* BLOCK ERASE */
+        s->naddr = 0;
+        break;
+    case 0x80:                  /* PROGRAM */
+        s->naddr = 0;
+        s->programming = true;
+        memset(s->page_buf, 0xff, sizeof(s->page_buf));
+        break;
+    case 0x85:                  /* CHANGE WRITE COLUMN */
+        s->naddr = 0;
+        break;
+    case 0x30:                  /* READ confirm */
+        s->col = gpmc_nand_column(s);
+        s->row = s->addr[2] | (s->addr[3] << 8) | (s->addr[4] << 16);
+        gpmc_nand_load(s);
+        s->out_mode = OUT_PAGE;
+        gpmc_nand_ready(s);
+        break;
+    case 0xe0:                  /* CHANGE READ COLUMN confirm */
+        s->col = gpmc_nand_column(s);
+        s->out_mode = OUT_PAGE;
+        break;
+    case 0x10:                  /* PROGRAM confirm */
+        if (s->programming) {
+            gpmc_nand_program(s);
+            s->programming = false;
+        }
+        s->out_mode = OUT_STATUS;
+        gpmc_nand_ready(s);
+        break;
+    case 0xd0:                  /* BLOCK ERASE confirm */
+        s->row = s->addr[0] | (s->addr[1] << 8) | (s->addr[2] << 16);
+        gpmc_nand_erase(s);
+        s->out_mode = OUT_STATUS;
+        gpmc_nand_ready(s);
+        break;
+    case 0x70:                  /* READ STATUS */
+        s->out_mode = OUT_STATUS;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "omap3-gpmc: NAND command 0x%02x\n", cmd);
+        return;
+    }
+    s->cmd = cmd;
+}
+
+static void gpmc_nand_address(Omap3GpmcState *s, uint8_t a)
+{
+    if (s->naddr < sizeof(s->addr)) {
+        s->addr[s->naddr] = a;
+    }
+    s->naddr++;
+    switch (s->cmd) {
+    case 0x90:
+        s->out_mode = OUT_ID;
+        s->col = 0;
+        break;
+    case 0x80:
+        if (s->naddr == 5) {
+            s->col = gpmc_nand_column(s);
+            s->row = s->addr[2] | (s->addr[3] << 8) | (s->addr[4] << 16);
+        }
+        break;
+    case 0x85:
+        if (s->naddr == 2) {
+            s->col = gpmc_nand_column(s);
+        }
+        break;
+    }
+}
+
+static void gpmc_ecc_feed(Omap3GpmcState *s, uint8_t b)
+{
+    if ((s->ecc_config & ECC_CONFIG_ENABLE) &&
+        ECC_CONFIG_CS(s->ecc_config) == s->nand_cs &&
+        s->ecc_count < sizeof(s->ecc_buf)) {
+        s->ecc_buf[s->ecc_count++] = b;
+    }
+}
+
+/* One bus cycle on the data port: a byte, or a word on an x16 part. */
+static uint32_t gpmc_nand_read_cycle(Omap3GpmcState *s)
+{
+    int n = gpmc_nand_wide(s) ? 2 : 1;
+    uint32_t v = 0;
+
+    switch (s->out_mode) {
+    case OUT_ID:                /* one ID byte per cycle, on D[7:0] */
+        v = s->col < sizeof(s->nand_id) ? s->nand_id[s->col] : 0;
+        s->col++;
+        return v;
+    case OUT_STATUS:
+        return s->status;
+    case OUT_PAGE:
+        for (int i = 0; i < n; i++) {
+            uint8_t b = s->col < OMAP3_NAND_PAGE_RAW ? s->page_buf[s->col] : 0xff;
+
+            s->col++;
+            gpmc_ecc_feed(s, b);
+            v |= b << (8 * i);
+        }
+        return v;
+    default:
+        return 0;
+    }
+}
+
+static void gpmc_nand_write_cycle(Omap3GpmcState *s, uint32_t v)
+{
+    int n = gpmc_nand_wide(s) ? 2 : 1;
+
+    for (int i = 0; i < n; i++) {
+        uint8_t b = v >> (8 * i);
+
+        gpmc_ecc_feed(s, b);
+        if (s->programming && s->col < OMAP3_NAND_PAGE_RAW) {
+            s->page_buf[s->col] = b;
+        }
+        s->col++;
+    }
+}
+
+static uint64_t gpmc_nand_data_read(Omap3GpmcState *s, unsigned size)
+{
+    int bus = gpmc_nand_wide(s) ? 2 : 1;
+    int cycles = MAX(size / bus, 1);
+    uint64_t v = 0;
+
+    for (int i = 0; i < cycles; i++) {
+        v |= (uint64_t)gpmc_nand_read_cycle(s) << (8 * bus * i);
+    }
+    return v;
+}
+
+static void gpmc_nand_data_write(Omap3GpmcState *s, uint64_t v, unsigned size)
+{
+    int bus = gpmc_nand_wide(s) ? 2 : 1;
+    int cycles = MAX(size / bus, 1);
+
+    for (int i = 0; i < cycles; i++) {
+        gpmc_nand_write_cycle(s, v >> (8 * bus * i));
+    }
+}
+
+static bool gpmc_prefetch_running(Omap3GpmcState *s)
+{
+    return (s->prefetch_control & PREFETCH_STARTENGINE) &&
+           (s->prefetch_config1 & PREFETCH_ENABLEENGINE) &&
+           PREFETCH_ENGINE_CS(s->prefetch_config1) == s->nand_cs;
+}
+
+static void gpmc_prefetch_moved(Omap3GpmcState *s, unsigned size)
+{
+    if (!gpmc_prefetch_running(s) || !s->prefetch_remaining) {
+        return;
+    }
+    s->prefetch_remaining -= MIN(size, s->prefetch_remaining);
+    if (!s->prefetch_remaining) {
+        s->irqstatus |= IRQ_TERMINALCOUNT;
+        qemu_set_irq(s->irq, !!(s->irqstatus & s->irqenable));
+    }
+}
+
+static uint64_t gpmc_window_read(void *opaque, hwaddr addr, unsigned size)
+{
+    uint64_t v = gpmc_nand_data_read(opaque, size);
+
+    gpmc_prefetch_moved(opaque, size);
+    return v;
+}
+
+static void gpmc_window_write(void *opaque, hwaddr addr, uint64_t val,
+                              unsigned size)
+{
+    gpmc_nand_data_write(opaque, val, size);
+    gpmc_prefetch_moved(opaque, size);
+}
+
+static const MemoryRegionOps gpmc_window_ops = {
+    .read = gpmc_window_read,
+    .write = gpmc_window_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+/* Map the NAND's data window where its CONFIG7 puts it, if valid. */
+static void gpmc_update_window(Omap3GpmcState *s)
+{
+    uint32_t c7 = s->cs_config[s->nand_cs][6];
+    /* MASKADDRESS 0b1111: 16 MiB, 0b1110: 32 MiB ... 0b0000: 256 MiB */
+    uint64_t size = (16 * MiB) << ctz32(CONFIG7_MASK(c7) | 0x10);
+
+    if (memory_region_is_mapped(&s->nand_window)) {
+        memory_region_del_subregion(&s->cs_space, &s->nand_window);
+    }
+    if (!(c7 & CONFIG7_CSVALID)) {
+        return;
+    }
+    memory_region_set_size(&s->nand_window, MIN(size, 256 * MiB));
+    memory_region_add_subregion_overlap(&s->cs_space,
+                                        (uint64_t)CONFIG7_BASE(c7) << 24,
+                                        &s->nand_window, 1);
+}
+
+/* A sector's BCH result: 52 bits, low word first. */
+static uint64_t gpmc_bch_result(Omap3GpmcState *s, int sector)
+{
+    const uint8_t *data = s->ecc_buf + sector * 512;
+    uint32_t ecc_end = OMAP3_NAND_PAGE + BCH4_ECC_OFFSET +
+                       (sector + 1) * BCH4_ECC_BYTES;
+    uint64_t parity, stored = 0;
+
+    if (!(s->ecc_config & ECC_CONFIG_BCH) || (s->ecc_config & ECC_CONFIG_BCHT8)) {
+        qemu_log_mask(LOG_UNIMP, "omap3-gpmc: ECC config 0x%x\n", s->ecc_config);
+        return 0;
+    }
+    if (sector > ECC_CONFIG_TOPSECTOR(s->ecc_config) ||
+        s->ecc_count < (sector + 1) * 512) {
+        return 0;
+    }
+    parity = omap3_bch4_parity(data, 512);
+    if (ECC_CONFIG_WRAPMODE(s->ecc_config) == BCH4_WRAP_READ &&
+        s->ecc_count >= ecc_end) {
+        for (int i = 0; i < BCH4_ECC_BYTES; i++) {
+            stored = stored << 8 | s->ecc_buf[ecc_end - BCH4_ECC_BYTES + i];
+        }
+        parity ^= stored & ((1ull << OMAP3_BCH4_BITS) - 1);
+        parity = omap3_bch4_mulx52(parity);
+    }
+    return parity;
+}
+
+static uint64_t gpmc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Omap3GpmcState *s = opaque;
+
+    if (addr >= GPMC_CS_BASE &&
+        addr < GPMC_CS_BASE + GPMC_CS_STRIDE * OMAP3_GPMC_NUM_CS) {
+        int cs = (addr - GPMC_CS_BASE) / GPMC_CS_STRIDE;
+        hwaddr reg = (addr - GPMC_CS_BASE) % GPMC_CS_STRIDE;
+
+        if (reg <= GPMC_CS_CONFIG7) {
+            return s->cs_config[cs][reg / 4];
+        }
+        if (reg == GPMC_CS_NAND_DATA && cs == s->nand_cs) {
+            return gpmc_nand_data_read(s, size);
+        }
+        return 0;
+    }
+    if (addr >= GPMC_BCH_RESULT && addr < GPMC_BCH_RESULT + 0x10 * 8) {
+        int sector = (addr - GPMC_BCH_RESULT) / 0x10;
+        uint64_t r = gpmc_bch_result(s, sector);
+
+        switch ((addr - GPMC_BCH_RESULT) % 0x10) {
+        case 0:
+            return (uint32_t)r;
+        case 4:
+            return r >> 32;
+        default:
+            return 0;
+        }
+    }
+
+    switch (addr) {
+    case GPMC_REVISION:
+        return 0x50;
+    case GPMC_SYSCONFIG:
+        return s->sysconfig;
+    case GPMC_SYSSTATUS:
+        return 1;                       /* RESETDONE */
+    case GPMC_IRQSTATUS:
+        return s->irqstatus;
+    case GPMC_IRQENABLE:
+        return s->irqenable;
+    case GPMC_TIMEOUT_CONTROL:
+        return s->timeout_control;
+    case GPMC_ERR_ADDRESS:
+    case GPMC_ERR_TYPE:
+        return 0;
+    case GPMC_CONFIG:
+        return s->config;
+    case GPMC_STATUS:
+        return STATUS_EMPTYWRITEBUFFER | STATUS_WAIT0;
+    case GPMC_PREFETCH_CONFIG1:
+        return s->prefetch_config1;
+    case GPMC_PREFETCH_CONFIG2:
+        return s->prefetch_config2;
+    case GPMC_PREFETCH_CONTROL:
+        return s->prefetch_control;
+    case GPMC_PREFETCH_STATUS:
+        if (!gpmc_prefetch_running(s)) {
+            return 0;
+        }
+        /* FIFOPOINTER: bytes ready (reading) or free (posting) */
+        return MIN(PREFETCH_FIFO, s->prefetch_remaining) << 24 |
+               (s->prefetch_remaining > PREFETCH_FIFO ? 1 << 16 : 0) |
+               (s->prefetch_remaining & 0x3fff);
+    case GPMC_ECC_CONFIG:
+        return s->ecc_config;
+    case GPMC_ECC_CONTROL:
+        return s->ecc_control;
+    case GPMC_ECC_SIZE_CONFIG:
+        return s->ecc_size_config;
+    case GPMC_ECC_RESULT ... GPMC_ECC_RESULT + 0x20:
+        qemu_log_mask(LOG_UNIMP, "omap3-gpmc: Hamming ECC result read\n");
+        return 0;
+    case GPMC_BCH_SWDATA:
+        return 0;
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "omap3-gpmc: bad read at 0x%" HWADDR_PRIx "\n",
+                  addr);
+    return 0;
+}
+
+static void gpmc_reset(DeviceState *dev)
+{
+    Omap3GpmcState *s = OMAP3_GPMC(dev);
+
+    s->sysconfig = 0;
+    s->irqstatus = 0;
+    s->irqenable = 0;
+    s->timeout_control = 0x1ff0;
+    s->config = 0x00000a00;
+    memset(s->cs_config, 0, sizeof(s->cs_config));
+    /* As the boot ROM leaves it for NAND boot: an x16 NAND on the boot
+     * chip select, valid at 0, 16 MiB. */
+    s->cs_config[s->nand_cs][0] = 0x00001800;
+    s->cs_config[s->nand_cs][6] = 0x00000f40;
+    s->prefetch_config1 = 0x00004000;
+    s->prefetch_config2 = 0;
+    s->prefetch_control = 0;
+    s->prefetch_remaining = 0;
+    s->ecc_config = 0;
+    s->ecc_control = 0;
+    s->ecc_size_config = 0x3fcff000;
+    s->ecc_count = 0;
+    s->cmd = 0;
+    s->naddr = 0;
+    s->out_mode = OUT_NONE;
+    s->programming = false;
+    s->status = NAND_STATUS_READY | NAND_STATUS_NOT_WP;
+    gpmc_update_window(s);
+    qemu_set_irq(s->irq, 0);
+}
+
+static void gpmc_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    Omap3GpmcState *s = opaque;
+
+    if (addr >= GPMC_CS_BASE &&
+        addr < GPMC_CS_BASE + GPMC_CS_STRIDE * OMAP3_GPMC_NUM_CS) {
+        int cs = (addr - GPMC_CS_BASE) / GPMC_CS_STRIDE;
+        hwaddr reg = (addr - GPMC_CS_BASE) % GPMC_CS_STRIDE;
+
+        if (reg <= GPMC_CS_CONFIG7) {
+            s->cs_config[cs][reg / 4] = val;
+            if (cs == s->nand_cs && reg == GPMC_CS_CONFIG7) {
+                gpmc_update_window(s);
+            }
+            return;
+        }
+        if (cs != s->nand_cs) {
+            return;                     /* nothing on this chip select */
+        }
+        switch (reg) {
+        case GPMC_CS_NAND_COMMAND:
+            gpmc_nand_command(s, val);
+            return;
+        case GPMC_CS_NAND_ADDRESS:
+            gpmc_nand_address(s, val);
+            return;
+        case GPMC_CS_NAND_DATA:
+            gpmc_nand_data_write(s, val, size);
+            return;
+        }
+        return;
+    }
+
+    switch (addr) {
+    case GPMC_SYSCONFIG:
+        if (val & 2) {                  /* SOFTRESET */
+            gpmc_reset(DEVICE(s));
+            return;
+        }
+        s->sysconfig = val;
+        return;
+    case GPMC_IRQSTATUS:
+        s->irqstatus &= ~val;
+        break;
+    case GPMC_IRQENABLE:
+        s->irqenable = val;
+        break;
+    case GPMC_TIMEOUT_CONTROL:
+        s->timeout_control = val;
+        return;
+    case GPMC_CONFIG:
+        s->config = val;
+        return;
+    case GPMC_PREFETCH_CONFIG1:
+        s->prefetch_config1 = val;
+        return;
+    case GPMC_PREFETCH_CONFIG2:
+        s->prefetch_config2 = val;
+        return;
+    case GPMC_PREFETCH_CONTROL:
+        if ((val & PREFETCH_STARTENGINE) &&
+            !(s->prefetch_control & PREFETCH_STARTENGINE)) {
+            s->prefetch_remaining = s->prefetch_config2 & 0x3fff;
+        }
+        s->prefetch_control = val & PREFETCH_STARTENGINE;
+        return;
+    case GPMC_ECC_CONFIG:
+        s->ecc_config = val;
+        return;
+    case GPMC_ECC_CONTROL:
+        if (val & ECC_CONTROL_CLEAR) {
+            s->ecc_count = 0;
+        }
+        s->ecc_control = val & 0xf;
+        return;
+    case GPMC_ECC_SIZE_CONFIG:
+        s->ecc_size_config = val;
+        return;
+    case GPMC_ERR_ADDRESS:
+    case GPMC_ERR_TYPE:
+    case GPMC_BCH_SWDATA:
+        return;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "omap3-gpmc: bad write at 0x%" HWADDR_PRIx "\n", addr);
+        return;
+    }
+    qemu_set_irq(s->irq, !!(s->irqstatus & s->irqenable));
+}
+
+static const MemoryRegionOps gpmc_ops = {
+    .read = gpmc_read,
+    .write = gpmc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+static void gpmc_realize(DeviceState *dev, Error **errp)
+{
+    Omap3GpmcState *s = OMAP3_GPMC(dev);
+    int64_t len;
+
+    if (!s->blk) {
+        s->nand_pages = 0;
+        return;
+    }
+    if (!blk_supports_write_perm(s->blk)) {
+        error_setg(errp, "omap3-gpmc: the NAND drive must be writable");
+        return;
+    }
+    if (blk_set_perm(s->blk, BLK_PERM_CONSISTENT_READ | BLK_PERM_WRITE,
+                     BLK_PERM_ALL, errp) < 0) {
+        return;
+    }
+    len = blk_getlength(s->blk);
+    if (len < 0 || len % (OMAP3_NAND_PAGE_RAW * OMAP3_NAND_PAGES_PER_BLOCK)) {
+        error_setg(errp, "omap3-gpmc: the NAND image must hold whole blocks "
+                   "of %d-byte pages (data + OOB)", OMAP3_NAND_PAGE_RAW);
+        return;
+    }
+    s->nand_pages = len / OMAP3_NAND_PAGE_RAW;
+}
+
+static void gpmc_init(Object *obj)
+{
+    Omap3GpmcState *s = OMAP3_GPMC(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &gpmc_ops, s, "omap3-gpmc", 0x1000);
+    memory_region_init(&s->cs_space, obj, "omap3-gpmc-cs", 1 * GiB);
+    memory_region_init_io(&s->nand_window, obj, &gpmc_window_ops, s,
+                          "omap3-gpmc-nand", 16 * MiB);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_mmio(sbd, &s->cs_space);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static const Property gpmc_properties[] = {
+    DEFINE_PROP_DRIVE("drive", Omap3GpmcState, blk),
+    DEFINE_PROP_UINT8("nand-cs", Omap3GpmcState, nand_cs, 0),
+    /* Micron MT29F2G16ABBEA: 2c ba 90 55 06 */
+    DEFINE_PROP_UINT8("nand-id0", Omap3GpmcState, nand_id[0], 0x2c),
+    DEFINE_PROP_UINT8("nand-id1", Omap3GpmcState, nand_id[1], 0xba),
+    DEFINE_PROP_UINT8("nand-id2", Omap3GpmcState, nand_id[2], 0x90),
+    DEFINE_PROP_UINT8("nand-id3", Omap3GpmcState, nand_id[3], 0x55),
+    DEFINE_PROP_UINT8("nand-id4", Omap3GpmcState, nand_id[4], 0x06),
+};
+
+static int gpmc_post_load(void *opaque, int version_id)
+{
+    gpmc_update_window(opaque);
+    return 0;
+}
+
+static const VMStateDescription gpmc_vmstate = {
+    .name = TYPE_OMAP3_GPMC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = gpmc_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(sysconfig, Omap3GpmcState),
+        VMSTATE_UINT32(irqstatus, Omap3GpmcState),
+        VMSTATE_UINT32(irqenable, Omap3GpmcState),
+        VMSTATE_UINT32(timeout_control, Omap3GpmcState),
+        VMSTATE_UINT32(config, Omap3GpmcState),
+        VMSTATE_UINT32_2DARRAY(cs_config, Omap3GpmcState, OMAP3_GPMC_NUM_CS, 7),
+        VMSTATE_UINT32(prefetch_config1, Omap3GpmcState),
+        VMSTATE_UINT32(prefetch_config2, Omap3GpmcState),
+        VMSTATE_UINT32(prefetch_control, Omap3GpmcState),
+        VMSTATE_UINT32(prefetch_remaining, Omap3GpmcState),
+        VMSTATE_UINT32(ecc_config, Omap3GpmcState),
+        VMSTATE_UINT32(ecc_control, Omap3GpmcState),
+        VMSTATE_UINT32(ecc_size_config, Omap3GpmcState),
+        VMSTATE_UINT8(cmd, Omap3GpmcState),
+        VMSTATE_UINT8_ARRAY(addr, Omap3GpmcState, 5),
+        VMSTATE_UINT8(naddr, Omap3GpmcState),
+        VMSTATE_UINT8(out_mode, Omap3GpmcState),
+        VMSTATE_UINT32(row, Omap3GpmcState),
+        VMSTATE_UINT32(col, Omap3GpmcState),
+        VMSTATE_UINT8(status, Omap3GpmcState),
+        VMSTATE_UINT8_ARRAY(page_buf, Omap3GpmcState, OMAP3_NAND_PAGE_RAW),
+        VMSTATE_BOOL(programming, Omap3GpmcState),
+        VMSTATE_UINT8_ARRAY(ecc_buf, Omap3GpmcState, OMAP3_NAND_PAGE_RAW),
+        VMSTATE_UINT32(ecc_count, Omap3GpmcState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void gpmc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = gpmc_realize;
+    device_class_set_legacy_reset(dc, gpmc_reset);
+    device_class_set_props(dc, gpmc_properties);
+    dc->vmsd = &gpmc_vmstate;
+    dc->desc = "OMAP3 GPMC with NAND flash";
+}
+
+static const TypeInfo gpmc_info = {
+    .name = TYPE_OMAP3_GPMC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Omap3GpmcState),
+    .instance_init = gpmc_init,
+    .class_init = gpmc_class_init,
+};
+
+static void gpmc_register_types(void)
+{
+    type_register_static(&gpmc_info);
+}
+
+type_init(gpmc_register_types)
diff --git a/hw/misc/omap3_prcm.c b/hw/misc/omap3_prcm.c
new file mode 100644
index 0000000..00856ae
--- /dev/null
+++ b/hw/misc/omap3_prcm.c
@@ -0,0 +1,683 @@
+/*
+ * OMAP3 power, reset and clock management (CM and PRM), the system
+ * control module (SCM, with the TAP identification block) and the SDRAM
+ * controller with its memory scheduler (SDRC, SMS)
+ *
+ * These are register files: clocks are not modelled, only what software
+ * waits on or reads back. A DPLL reports lock when its enable field asks
+ * for lock mode; every module reports itself functional; every power
+ * domain is on and never in transition; the SDRC's DLLs are locked. The
+ * PRM resets the system on RST_DPLL3/RST_GS, and the CM drives each GP
+ * timer's clock-source selection.
+ *
+ * Wake-up: a module's wake-up request (GPIO1-6, UART1-3) enabled in its
+ * domain's PM_WKEN is latched in PM_WKST; one also in PM_MPUGRPSEL sets
+ * PRM_IRQSTATUS_MPU.WKUP_ST, and the PRM interrupt is IRQSTATUS_MPU &
+ * IRQENABLE_MPU. That is what ends a suspend's WFI with every module's own
+ * interrupt off.
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/omap3_prcm.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "system/runstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+/* CM: one block per domain */
+#define CM_IVA2         0x0000
+#define CM_MPU          0x0900
+#define CM_CORE         0x0a00
+#define CM_WKUP         0x0c00
+#define CM_CKGEN        0x0d00
+#define CM_PER          0x1000
+
+#define CM_IDLEST1      0x20
+#define CM_IDLEST2      0x24
+#define CM_IDLEST3      0x28
+#define CM_CLKSEL       0x40
+#define CM_CLKSTST      0x4c
+
+#define CM_CLKEN_PLL_IVA2       (CM_IVA2 + 0x04)
+#define CM_IDLEST_PLL_IVA2      (CM_IVA2 + 0x24)
+#define CM_CLKEN_PLL_MPU        (CM_MPU + 0x04)
+#define CM_IDLEST_PLL_MPU       (CM_MPU + 0x24)
+#define CM_CLKEN_PLL            (CM_CKGEN + 0x00)
+#define CM_CLKEN2_PLL           (CM_CKGEN + 0x04)
+#define CM_IDLEST_CKGEN         (CM_CKGEN + 0x20)
+#define CM_IDLEST2_CKGEN        (CM_CKGEN + 0x24)
+#define CM_CLKSEL_CORE          (CM_CORE + CM_CLKSEL)
+#define CM_CLKSEL_WKUP          (CM_WKUP + CM_CLKSEL)
+#define CM_CLKSEL_PER           (CM_PER + CM_CLKSEL)
+
+#define DPLL_LOCKED(en)         (((en) & 7) == 7)
+
+static uint32_t cm_gpt_clksel(Omap3CmState *s, int gpt)
+{
+    switch (gpt) {
+    case 0:
+        return s->regs[CM_CLKSEL_WKUP / 4] & 1;
+    case 1 ... 8:
+        return (s->regs[CM_CLKSEL_PER / 4] >> (gpt - 1)) & 1;
+    case 9 ... 10:
+        return (s->regs[CM_CLKSEL_CORE / 4] >> (gpt - 3)) & 1;
+    default:
+        return 0;               /* GPTIMER12: the 32 kHz secure clock */
+    }
+}
+
+static void cm_update_gpt(Omap3CmState *s)
+{
+    for (int i = 0; i < OMAP3_NUM_GPT; i++) {
+        qemu_set_irq(s->gpt_clksel[i], cm_gpt_clksel(s, i));
+    }
+}
+
+/*
+ * In CORE, WKUP and PER a module's IDLEST bit sits at the position of its
+ * FCLKEN/ICLKEN bits: it reads idle (1) once both its clocks are gated
+ * (the kernel's SRAM code idles the SDRC that way), functional (0)
+ * otherwise. Other domains' IDLEST bits mean idle/standby of the domain's
+ * single module: always functional.
+ */
+static uint32_t cm_idlest(Omap3CmState *s, hwaddr addr)
+{
+    hwaddr dom = addr & ~0xff;
+    int n = ((addr & 0xff) - CM_IDLEST1) / 4;   /* IDLEST1..3 */
+    static const uint8_t fclken[] = { 0x00, 0x04, 0x08 };
+    static const uint8_t iclken[] = { 0x10, 0x14, 0x18 };
+
+    if (dom != CM_CORE && dom != CM_WKUP && dom != CM_PER) {
+        return 0;
+    }
+    return ~(s->regs[(dom + fclken[n]) / 4] | s->regs[(dom + iclken[n]) / 4]);
+}
+
+static uint64_t cm_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Omap3CmState *s = opaque;
+    uint32_t en;
+
+    switch (addr) {
+    case CM_IDLEST_PLL_IVA2:
+        return DPLL_LOCKED(s->regs[CM_CLKEN_PLL_IVA2 / 4]);
+    case CM_IDLEST_PLL_MPU:
+        return DPLL_LOCKED(s->regs[CM_CLKEN_PLL_MPU / 4]);
+    case CM_IDLEST_CKGEN:
+        en = s->regs[CM_CLKEN_PLL / 4];
+        /* ST_CORE_CLK: DPLL3; ST_PERIPH_CLK and the clocks it makes: DPLL4 */
+        return DPLL_LOCKED(en) | (DPLL_LOCKED(en >> 16) ? 0x3f3e : 0);
+    case CM_IDLEST2_CKGEN:
+        return DPLL_LOCKED(s->regs[CM_CLKEN2_PLL / 4]) ? 0x3 : 0;
+    }
+    switch (addr & 0xff) {
+    case CM_IDLEST1:
+    case CM_IDLEST2:
+    case CM_IDLEST3:
+        return cm_idlest(s, addr);
+    case CM_CLKSTST:
+        return 1;               /* clock active */
+    }
+    return s->regs[addr / 4];
+}
+
+static void cm_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    Omap3CmState *s = opaque;
+
+    s->regs[addr / 4] = val;
+    switch (addr) {
+    case CM_CLKSEL_CORE:
+    case CM_CLKSEL_WKUP:
+    case CM_CLKSEL_PER:
+        cm_update_gpt(s);
+        break;
+    }
+}
+
+static const MemoryRegionOps cm_ops = {
+    .read = cm_read,
+    .write = cm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void cm_reset(DeviceState *dev)
+{
+    Omap3CmState *s = OMAP3_CM(dev);
+
+    /* The TRM's reset values (OMAP3630 where they differ from 3430):
+     * every clock-select field must name a valid parent, or Linux's clock
+     * framework finds none. The boot software locks the DPLLs. */
+    static const struct {
+        uint16_t reg;
+        uint32_t val;
+    } reset[] = {
+        { CM_CLKEN_PLL_IVA2,    0x00000011 },
+        { CM_IVA2 + 0x40,       0x00080000 },   /* CM_CLKSEL1_PLL_IVA2 */
+        { CM_IVA2 + 0x44,       0x00000001 },   /* CM_CLKSEL2_PLL_IVA2 */
+        { 0x0800,               0x00000010 },   /* CM_REVISION */
+        { 0x0810,               0x00000001 },   /* CM_SYSCONFIG */
+        { CM_CLKEN_PLL_MPU,     0x00000015 },
+        { CM_MPU + 0x40,        0x00080000 },   /* CM_CLKSEL1_PLL_MPU */
+        { CM_MPU + 0x44,        0x00000001 },   /* CM_CLKSEL2_PLL_MPU */
+        { CM_CORE + 0x10,       0x00000042 },   /* CM_ICLKEN1_CORE */
+        { CM_CLKSEL_CORE,       0x00001105 },
+        { CM_CLKSEL_WKUP,       0x00000012 },
+        { CM_CLKEN_PLL,         0x00110015 },
+        { CM_CLKEN2_PLL,        0x00000011 },
+        { CM_CKGEN + 0x40,      0x08000040 },   /* CM_CLKSEL1_PLL */
+        { CM_CKGEN + 0x44,      0x02400000 },   /* CM_CLKSEL2_PLL */
+        { CM_CKGEN + 0x48,      0x00000001 },   /* CM_CLKSEL3_PLL */
+        { CM_CKGEN + 0x50,      0x00000001 },   /* CM_CLKSEL5_PLL */
+        { CM_CKGEN + 0x70,      0x00000003 },   /* CM_CLKOUT_CTRL */
+        { 0x0e40,               0x00000410 },   /* CM_CLKSEL_DSS */
+        { 0x0f40,               0x00000004 },   /* CM_CLKSEL_CAM */
+        { 0x1140,               0x10100a50 },   /* CM_CLKSEL1_EMU */
+        { 0x1148,               0x00000002 },   /* CM_CLKSTCTRL_EMU */
+    };
+
+    memset(s->regs, 0, sizeof(s->regs));
+    for (int i = 0; i < ARRAY_SIZE(reset); i++) {
+        s->regs[reset[i].reg / 4] = reset[i].val;
+    }
+    cm_update_gpt(s);
+}
+
+static void cm_init(Object *obj)
+{
+    Omap3CmState *s = OMAP3_CM(obj);
+
+    memory_region_init_io(&s->iomem, obj, &cm_ops, s, "omap3-cm", OMAP3_CM_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    qdev_init_gpio_out_named(DEVICE(obj), s->gpt_clksel, OMAP3_CM_GPT_CLKSEL,
+                             OMAP3_NUM_GPT);
+}
+
+static const VMStateDescription cm_vmstate = {
+    .name = TYPE_OMAP3_CM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, Omap3CmState, OMAP3_CM_SIZE / 4),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void cm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, cm_reset);
+    dc->vmsd = &cm_vmstate;
+    dc->desc = "OMAP3 clock manager";
+}
+
+/* PRM */
+#define PRM_REVISION            0x0804
+#define PRM_IRQSTATUS_MPU       0x0818
+#define PRM_IRQENABLE_MPU       0x081c
+#define IRQ_WKUP_ST             (1 << 0)
+#define PRM_CLKSEL              0x0d40
+#define PRM_VC_BYPASS_VAL       0x123c
+#define PRM_RSTCTRL             0x1250
+#define PRM_RSTST               0x1258
+#define PRM_CLKSRC_CTRL         0x1270
+#define PRM_VP1_CONFIG          0x12b0
+#define PRM_VP1_STATUS          0x12c4
+#define PRM_VP2_CONFIG          0x12d0
+#define PRM_VP2_STATUS          0x12e4
+#define VP_CONFIG_FORCEUPDATE   (1 << 2)
+#define IRQ_VP1_TRANXDONE       (1 << 15)
+#define IRQ_VP2_TRANXDONE       (1 << 21)
+
+#define PM_PWSTST               0xe4
+#define PM_PREPWSTST            0xe8
+#define RM_RSTST                0x58
+#define PM_WKEN1                0xa0
+#define PM_MPUGRPSEL1           0xa4
+#define PM_WKST1                0xb0
+#define PM_WKST3                0xb8
+
+#define PRM_CORE                0x0a00
+#define PRM_WKUP                0x0c00
+#define PRM_PER                 0x1000
+
+/* Each wake-up request's domain and bit in its PM_WKEN1/PM_WKST1 */
+static const struct {
+    hwaddr domain;
+    int bit;
+} prm_wake[OMAP3_NUM_WAKE] = {
+    [OMAP3_WAKE_GPIO1]     = { PRM_WKUP, 3 },
+    [OMAP3_WAKE_GPIO1 + 1] = { PRM_PER, 13 },
+    [OMAP3_WAKE_GPIO1 + 2] = { PRM_PER, 14 },
+    [OMAP3_WAKE_GPIO1 + 3] = { PRM_PER, 15 },
+    [OMAP3_WAKE_GPIO1 + 4] = { PRM_PER, 16 },
+    [OMAP3_WAKE_GPIO1 + 5] = { PRM_PER, 17 },
+    [OMAP3_WAKE_UART1]     = { PRM_CORE, 13 },
+    [OMAP3_WAKE_UART2]     = { PRM_CORE, 14 },
+    [OMAP3_WAKE_UART3]     = { PRM_PER, 11 },
+};
+
+#define PRM_CLKSEL_19M2         2
+#define VC_BYPASS_VALID         (1 << 24)
+#define RSTCTRL_RST_DPLL3       (1 << 2)
+#define RSTCTRL_RST_GS          (1 << 1)
+
+static void prm_update_irq(Omap3PrmState *s)
+{
+    qemu_set_irq(s->irq, !!(s->regs[PRM_IRQSTATUS_MPU / 4] &
+                            s->regs[PRM_IRQENABLE_MPU / 4]));
+}
+
+static void prm_wakeup(void *opaque, int n, int level)
+{
+    Omap3PrmState *s = opaque;
+    hwaddr domain = prm_wake[n].domain;
+    uint32_t bit = 1u << prm_wake[n].bit;
+
+    if (!level || !(s->regs[(domain + PM_WKEN1) / 4] & bit)) {
+        return;
+    }
+    s->regs[(domain + PM_WKST1) / 4] |= bit;
+    if (s->regs[(domain + PM_MPUGRPSEL1) / 4] & bit) {
+        s->regs[PRM_IRQSTATUS_MPU / 4] |= IRQ_WKUP_ST;
+        prm_update_irq(s);
+    }
+}
+
+static uint64_t prm_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Omap3PrmState *s = opaque;
+
+    switch (addr) {
+    case PRM_REVISION:
+        return 0x10;
+    case PRM_VP1_STATUS:
+    case PRM_VP2_STATUS:
+        return 1;               /* VPINIDLE */
+    }
+    if (addr < 0x1200 || addr >= 0x1300) {
+        switch (addr & 0xff) {
+        case PM_PWSTST:
+        case PM_PREPWSTST:
+            return 0x7;         /* ON, logic retained, not in transition */
+        }
+    }
+    return s->regs[addr / 4];
+}
+
+static void prm_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    Omap3PrmState *s = opaque;
+
+    switch (addr) {
+    case PRM_IRQSTATUS_MPU:
+    case PRM_RSTST:
+        s->regs[addr / 4] &= ~val;
+        prm_update_irq(s);
+        return;
+    case PRM_IRQENABLE_MPU:
+        s->regs[addr / 4] = val;
+        prm_update_irq(s);
+        return;
+    case PRM_VC_BYPASS_VAL:
+        s->regs[addr / 4] = val & ~VC_BYPASS_VALID;   /* sent at once */
+        return;
+    case PRM_VP1_CONFIG:
+    case PRM_VP2_CONFIG:
+        /* a forced update completes at once */
+        s->regs[addr / 4] = val;
+        if (val & VP_CONFIG_FORCEUPDATE) {
+            s->regs[PRM_IRQSTATUS_MPU / 4] |=
+                addr == PRM_VP1_CONFIG ? IRQ_VP1_TRANXDONE : IRQ_VP2_TRANXDONE;
+        }
+        return;
+    case PRM_RSTCTRL:
+        if (val & (RSTCTRL_RST_DPLL3 | RSTCTRL_RST_GS)) {
+            qemu_log_mask(CPU_LOG_RESET, "omap3-prm: software reset\n");
+            s->regs[PRM_RSTST / 4] = val & RSTCTRL_RST_GS ? 0x2 : 0x4;
+            qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+        }
+        return;
+    }
+    /*
+     * RM_RSTST and the wake-up status (PM_WKST*) are write-1-to-clear: Linux
+     * clears a UART's wake-up bit after each idle, and one read back set
+     * keeps the UART from sleeping, so the idle loop never reaches WFI.
+     */
+    if ((addr < 0x1200 || addr >= 0x1300) &&
+        ((addr & 0xff) == RM_RSTST || (addr & 0xff) == PM_WKST1 ||
+         (addr & 0xff) == PM_WKST3)) {
+        s->regs[addr / 4] &= ~val;
+        return;
+    }
+    s->regs[addr / 4] = val;
+}
+
+static const MemoryRegionOps prm_ops = {
+    .read = prm_read,
+    .write = prm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void prm_reset(DeviceState *dev)
+{
+    Omap3PrmState *s = OMAP3_PRM(dev);
+    uint32_t rstst = s->regs[PRM_RSTST / 4];
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[PRM_CLKSEL / 4] = PRM_CLKSEL_19M2;
+    s->regs[PRM_CLKSRC_CTRL / 4] = 0x40;          /* SYSCLKDIV: /1 */
+    /* A software reset keeps its cause; power-on is a cold reset. */
+    s->regs[PRM_RSTST / 4] = rstst ? rstst : 0x1;
+}
+
+static void prm_init(Object *obj)
+{
+    Omap3PrmState *s = OMAP3_PRM(obj);
+
+    memory_region_init_io(&s->iomem, obj, &prm_ops, s, "omap3-prm",
+                          OMAP3_PRM_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    qdev_init_gpio_in_named(DEVICE(obj), prm_wakeup, OMAP3_PRM_WAKEUP,
+                            OMAP3_NUM_WAKE);
+}
+
+static const VMStateDescription prm_vmstate = {
+    .name = TYPE_OMAP3_PRM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, Omap3PrmState, OMAP3_PRM_SIZE / 4),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void prm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, prm_reset);
+    dc->vmsd = &prm_vmstate;
+    dc->desc = "OMAP3 power and reset manager";
+}
+
+/* SCM and the TAP identification registers */
+#define CONTROL_PADCONF_OFF     0x270
+#define CONTROL_GENERAL_PURPOSE_STATUS 0x2f4
+#define CONTROL_STATUS          0x2f0
+#define CONTROL_OMAP_STATUS     0x44c
+
+#define TAP_IDCODE              0x204
+#define TAP_PRODUCTION_ID       0x208
+#define TAP_DIE_ID              0x218
+
+#define CONTROL_STATUS_GP       (3 << 8)
+#define START_PADCONF_SAVE      (1 << 1)
+#define PADCONF_SAVE_DONE       (1 << 0)
+
+static uint64_t scm_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Omap3ScmState *s = opaque;
+    uint32_t word;
+
+    switch (addr & ~3) {
+    case CONTROL_STATUS:
+        word = CONTROL_STATUS_GP | s->sys_boot;
+        break;
+    case CONTROL_OMAP_STATUS:
+        word = s->omap_status;
+        break;
+    default:
+        word = s->regs[addr / 4];
+    }
+    return extract32(word, (addr & 3) * 8, size * 8);
+}
+
+static void scm_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    Omap3ScmState *s = opaque;
+
+    s->regs[addr / 4] = deposit32(s->regs[addr / 4], (addr & 3) * 8, size * 8,
+                                  val);
+    /*
+     * The pad configuration save (before the core domain goes off)
+     * completes at once: the kernel polls for it.
+     */
+    if ((addr & ~3) == CONTROL_PADCONF_OFF &&
+        (s->regs[CONTROL_PADCONF_OFF / 4] & START_PADCONF_SAVE)) {
+        s->regs[CONTROL_GENERAL_PURPOSE_STATUS / 4] |= PADCONF_SAVE_DONE;
+    }
+}
+
+static const MemoryRegionOps scm_ops = {
+    .read = scm_read,
+    .write = scm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+static uint64_t tap_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Omap3ScmState *s = opaque;
+
+    switch (addr) {
+    case TAP_IDCODE:
+        return s->idcode;
+    case TAP_PRODUCTION_ID:
+        return 0x000000f0;
+    case TAP_DIE_ID ... TAP_DIE_ID + 0xc:
+        return s->die_id[(addr - TAP_DIE_ID) / 4];
+    }
+    return 0;
+}
+
+static void tap_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    qemu_log_mask(LOG_GUEST_ERROR, "omap3-tap: write to read-only 0x%" HWADDR_PRIx
+                  "\n", addr);
+}
+
+static const MemoryRegionOps tap_ops = {
+    .read = tap_read,
+    .write = tap_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void scm_reset(DeviceState *dev)
+{
+    Omap3ScmState *s = OMAP3_SCM(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+}
+
+static void scm_init(Object *obj)
+{
+    Omap3ScmState *s = OMAP3_SCM(obj);
+
+    memory_region_init_io(&s->iomem, obj, &scm_ops, s, "omap3-scm", 0x1000);
+    memory_region_init_io(&s->tap, obj, &tap_ops, s, "omap3-tap", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->tap);
+}
+
+static const Property scm_properties[] = {
+    /* OMAP3630 ES1.2 (hawkeye 0xb891), the AM3703's die */
+    DEFINE_PROP_UINT32("idcode", Omap3ScmState, idcode, 0x2b89102f),
+    /* AM3703: no SGX, no IVA, 256 KiB L2, ISP and NEON */
+    DEFINE_PROP_UINT32("omap-status", Omap3ScmState, omap_status, 0x5c00),
+    DEFINE_PROP_UINT32("sys-boot", Omap3ScmState, sys_boot, 0x2f),
+    DEFINE_PROP_UINT32("die-id0", Omap3ScmState, die_id[0], 0),
+    DEFINE_PROP_UINT32("die-id1", Omap3ScmState, die_id[1], 0),
+    DEFINE_PROP_UINT32("die-id2", Omap3ScmState, die_id[2], 0),
+    DEFINE_PROP_UINT32("die-id3", Omap3ScmState, die_id[3], 0),
+};
+
+static const VMStateDescription scm_vmstate = {
+    .name = TYPE_OMAP3_SCM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, Omap3ScmState, 0x1000 / 4),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void scm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, scm_reset);
+    device_class_set_props(dc, scm_properties);
+    dc->vmsd = &scm_vmstate;
+    dc->desc = "OMAP3 system control module";
+}
+
+/* SDRC and SMS */
+#define SDRC_SYSSTATUS          0x14
+#define SDRC_DLLA_CTRL          0x60
+#define SDRC_DLLA_STATUS        0x64
+#define SDRC_DLLB_CTRL          0x68
+#define SDRC_DLLB_STATUS        0x6c
+#define SDRC_DLL_LOCKED         (1 << 2)
+#define SDRC_DLL_IDLE           (1 << 2)
+#define SMS_SYSSTATUS           0x14
+
+static uint64_t sdrc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Omap3SdrcState *s = opaque;
+
+    switch (addr) {
+    case 0x00:
+        return 0x40;            /* REVISION */
+    case SDRC_SYSSTATUS:
+        return 1;               /* RESETDONE */
+    case SDRC_DLLA_STATUS:
+    case SDRC_DLLB_STATUS:
+        /* locked unless its control register idles it */
+        return s->sdrc_regs[(addr - 4) / 4] & SDRC_DLL_IDLE ? 0 : SDRC_DLL_LOCKED;
+    }
+    return s->sdrc_regs[addr / 4];
+}
+
+static void sdrc_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    Omap3SdrcState *s = opaque;
+
+    s->sdrc_regs[addr / 4] = val;
+}
+
+static const MemoryRegionOps sdrc_ops = {
+    .read = sdrc_read,
+    .write = sdrc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static uint64_t sms_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Omap3SdrcState *s = opaque;
+
+    if (addr == SMS_SYSSTATUS) {
+        return 1;
+    }
+    return s->sms_regs[addr / 4];
+}
+
+static void sms_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    Omap3SdrcState *s = opaque;
+
+    s->sms_regs[addr / 4] = val;
+}
+
+static const MemoryRegionOps sms_ops = {
+    .read = sms_read,
+    .write = sms_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void sdrc_reset(DeviceState *dev)
+{
+    Omap3SdrcState *s = OMAP3_SDRC(dev);
+
+    memset(s->sdrc_regs, 0, sizeof(s->sdrc_regs));
+    memset(s->sms_regs, 0, sizeof(s->sms_regs));
+}
+
+static void sdrc_init(Object *obj)
+{
+    Omap3SdrcState *s = OMAP3_SDRC(obj);
+
+    memory_region_init_io(&s->sdrc, obj, &sdrc_ops, s, "omap3-sdrc", 0x400);
+    memory_region_init_io(&s->sms, obj, &sms_ops, s, "omap3-sms", 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->sdrc);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->sms);
+}
+
+static const VMStateDescription sdrc_vmstate = {
+    .name = TYPE_OMAP3_SDRC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(sdrc_regs, Omap3SdrcState, 0x400 / 4),
+        VMSTATE_UINT32_ARRAY(sms_regs, Omap3SdrcState, 0x400 / 4),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void sdrc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, sdrc_reset);
+    dc->vmsd = &sdrc_vmstate;
+    dc->desc = "OMAP3 SDRAM controller and memory scheduler";
+}
+
+static const TypeInfo omap3_prcm_types[] = {
+    {
+        .name = TYPE_OMAP3_CM,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(Omap3CmState),
+        .instance_init = cm_init,
+        .class_init = cm_class_init,
+    }, {
+        .name = TYPE_OMAP3_PRM,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(Omap3PrmState),
+        .instance_init = prm_init,
+        .class_init = prm_class_init,
+    }, {
+        .name = TYPE_OMAP3_SCM,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(Omap3ScmState),
+        .instance_init = scm_init,
+        .class_init = scm_class_init,
+    }, {
+        .name = TYPE_OMAP3_SDRC,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(Omap3SdrcState),
+        .instance_init = sdrc_init,
+        .class_init = sdrc_class_init,
+    },
+};
+
+DEFINE_TYPES(omap3_prcm_types)
diff --git a/hw/misc/tps65921.c b/hw/misc/tps65921.c
new file mode 100644
index 0000000..4b81892
--- /dev/null
+++ b/hw/misc/tps65921.c
@@ -0,0 +1,398 @@
+/*
+ * TI TPS65921 power management companion (TWL4030 family)
+ *
+ * Four I2C slaves share the chip: 0x48 holds the USB PHY, 0x49 the
+ * interrupt bridge, GPIO and the primary interrupt handler, 0x4a the
+ * keypad, MADC and PWMs, 0x4b the power management, backup and RTC
+ * registers. Each is 256 registers behind an auto-incrementing pointer,
+ * the first byte of a write.
+ *
+ * Modelled behaviour: the USB PHY's DPLL clock reports running; the RTC
+ * keeps the host's time (QEMU's -rtc base) plus whatever the guest sets,
+ * latched into the time registers by RTC_CTRL.GET_TIME and taken back when
+ * the guest restarts it after writing them; the MADC's software
+ * conversions (SW1, SW2) complete at once, each selected channel's input
+ * (QOM "adcinN-mv", in mV at the channel's input, before its prescaler)
+ * becoming the 10-bit code, full scale 1.5 V after the prescaler; P1_SW_EVENTS.DEVOFF (Linux's
+ * twl4030_poweroff) switches the board off: the emulation ends.
+ *
+ * Interrupts: the power module's secondary handler (PWR_ISR1/IMR1, edge
+ * selection in PWR_EDR1, clear-on-read when PWR_SIH_CTRL.COR is set, as
+ * Linux sets it) feeds the primary handler's PIH_ISR_P1 bit 5, which
+ * drives SYS_NIRQ. Its one source is PWRON, the power button pin (GPIO
+ * input 0, or the QOM "pwron" property); STS_HW_CONDITIONS.STS_PWON reads
+ * the pin.
+ *
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/tps65921.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/bcd.h"
+#include "qemu/cutils.h"
+#include "qemu/module.h"
+#include "system/rtc.h"
+#include "system/runstate.h"
+
+/* ID 0 (0x48) */
+#define USB_PHY_CLK_CTRL_STS    0xff
+#define USB_PHY_DPLL_CLK        0x01
+
+/* ID 3 (0x4b) */
+#define RTC_SECONDS             0x1c
+#define RTC_CTRL                0x29
+#define RTC_STATUS              0x2a
+#define RTC_CTRL_STOP_RTC       0x01    /* 1: running */
+#define RTC_CTRL_GET_TIME       0x40
+#define RTC_STATUS_RUN          0x02
+#define PM_P1_SW_EVENTS         0x46    /* PM_MASTER 0x36 + 0x10 */
+#define PM_DEVOFF               0x01
+#define PM_STS_HW_CONDITIONS    0x45    /* PM_MASTER 0x36 + 0x0f */
+#define STS_PWON                0x01
+
+/* ID 3: the power module's secondary interrupt handler (INT base 0x2e) */
+#define PWR_ISR1                0x2e
+#define PWR_IMR1                0x2f
+#define PWR_EDR1                0x33
+#define PWR_SIH_CTRL            0x35
+#define SIH_CTRL_COR            0x04
+#define PWR_PWRON               0x01
+
+/* ID 1: the primary interrupt handler (PIH base 0x80) */
+#define PIH_ISR_P1              0x81
+#define PIH_POWER               (1 << 5)
+
+/* ID 2 (0x4a): MADC */
+#define MADC_SW1SELECT_LSB      0x06
+#define MADC_SW2SELECT_LSB      0x0a
+#define MADC_CTRL_SW1           0x12
+#define MADC_CTRL_SW2           0x13
+#define MADC_GPCH0_LSB          0x37
+#define MADC_EOC_SW             0x02
+#define MADC_SW_START           0x20
+
+/* each channel's prescaler, numerator/denominator, as the driver scales */
+static const uint8_t madc_ratio[16][2] = {
+    { 1, 1 }, { 1, 1 }, { 6, 10 }, { 6, 10 }, { 6, 10 }, { 6, 10 },
+    { 6, 10 }, { 6, 10 }, { 3, 14 }, { 1, 3 }, { 1, 1 }, { 15, 100 },
+    { 1, 4 }, { 1, 1 }, { 1, 1 }, { 5, 11 },
+};
+
+static void tps_madc_convert(Tps65921State *s, uint8_t ctrl)
+{
+    uint8_t *r = s->regs[2];
+    uint8_t sel = ctrl == MADC_CTRL_SW1 ? MADC_SW1SELECT_LSB : MADC_SW2SELECT_LSB;
+    uint16_t channels = r[sel] | r[sel + 1] << 8;
+
+    for (int i = 0; i < 16; i++) {
+        uint64_t code;
+
+        if (!(channels & (1 << i))) {
+            continue;
+        }
+        code = (uint64_t)s->adcin_mv[i] * 1023 * madc_ratio[i][0] /
+               (1500 * madc_ratio[i][1]);
+        code = MIN(code, 1023);
+        r[MADC_GPCH0_LSB + 2 * i] = (code & 3) << 6;
+        r[MADC_GPCH0_LSB + 2 * i + 1] = code >> 2;
+    }
+    r[ctrl] = MADC_EOC_SW;              /* done, not busy */
+}
+
+static void tps_rtc_latch(Tps65921State *s)
+{
+    struct tm tm;
+    uint8_t *r = &s->regs[3][RTC_SECONDS];
+
+    qemu_get_timedate(&tm, s->rtc_offset);
+    r[0] = to_bcd(tm.tm_sec);
+    r[1] = to_bcd(tm.tm_min);
+    r[2] = to_bcd(tm.tm_hour);
+    r[3] = to_bcd(tm.tm_mday);
+    r[4] = to_bcd(tm.tm_mon + 1);
+    r[5] = to_bcd(tm.tm_year % 100);
+    r[6] = to_bcd(tm.tm_wday);
+}
+
+static void tps_rtc_set(Tps65921State *s)
+{
+    const uint8_t *r = &s->regs[3][RTC_SECONDS];
+    struct tm tm = {
+        .tm_sec = from_bcd(r[0]),
+        .tm_min = from_bcd(r[1]),
+        .tm_hour = from_bcd(r[2] & 0x3f),
+        .tm_mday = from_bcd(r[3]),
+        .tm_mon = from_bcd(r[4]) - 1,
+        .tm_year = from_bcd(r[5]) + 100,
+    };
+
+    s->rtc_offset = qemu_timedate_diff(&tm);
+}
+
+static uint8_t tps_pwr_isr(Tps65921State *s)
+{
+    return s->pwr_pending & ~s->regs[3][PWR_IMR1];
+}
+
+static void tps_update_irq(Tps65921State *s)
+{
+    qemu_set_irq(s->irq, !!tps_pwr_isr(s));
+}
+
+static void tps_set_pwron(void *opaque, int n, int level)
+{
+    Tps65921State *s = opaque;
+    uint8_t edr = s->regs[3][PWR_EDR1];
+
+    if (s->pwron == !!level) {
+        return;
+    }
+    s->pwron = level;
+    /* PWRON's edge bits: falling at bit 0, rising at bit 1 */
+    if (edr & (level ? 0x02 : 0x01)) {
+        s->pwr_pending |= PWR_PWRON;
+    }
+    tps_update_irq(s);
+}
+
+static uint8_t tps_read(Tps65921State *s, int id, uint8_t reg)
+{
+    uint8_t isr;
+
+    if (id == 1 && reg == PIH_ISR_P1) {
+        return tps_pwr_isr(s) ? PIH_POWER : 0;
+    }
+    if (id == 3 && reg == PWR_ISR1) {
+        isr = tps_pwr_isr(s);
+        if (s->regs[3][PWR_SIH_CTRL] & SIH_CTRL_COR) {
+            s->pwr_pending &= ~isr;
+            tps_update_irq(s);
+        }
+        return isr;
+    }
+    if (id == 3 && reg == PM_STS_HW_CONDITIONS) {
+        return s->regs[3][reg] | (s->pwron ? STS_PWON : 0);
+    }
+    if (id == 0 && reg == USB_PHY_CLK_CTRL_STS) {
+        return USB_PHY_DPLL_CLK;
+    }
+    if (id == 3 && reg == RTC_STATUS) {
+        return (s->regs[3][RTC_CTRL] & RTC_CTRL_STOP_RTC) ? RTC_STATUS_RUN : 0;
+    }
+    return s->regs[id][reg];
+}
+
+static void tps_write(Tps65921State *s, int id, uint8_t reg, uint8_t val)
+{
+    uint8_t old = s->regs[id][reg];
+
+    if (id == 3 && reg == PWR_ISR1) {
+        if (!(s->regs[3][PWR_SIH_CTRL] & SIH_CTRL_COR)) {
+            s->pwr_pending &= ~val;
+            tps_update_irq(s);
+        }
+        return;
+    }
+    s->regs[id][reg] = val;
+    if (id == 3 && reg == PWR_IMR1) {
+        tps_update_irq(s);
+    }
+    if (id == 2 && (reg == MADC_CTRL_SW1 || reg == MADC_CTRL_SW2) &&
+        (val & MADC_SW_START)) {
+        tps_madc_convert(s, reg);
+    }
+    if (id == 3 && reg == PM_P1_SW_EVENTS && (val & PM_DEVOFF)) {
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    }
+    if (id == 3 && reg == RTC_CTRL) {
+        if (val & RTC_CTRL_GET_TIME) {
+            tps_rtc_latch(s);
+        }
+        if ((val & RTC_CTRL_STOP_RTC) && !(old & RTC_CTRL_STOP_RTC)) {
+            tps_rtc_set(s);
+        }
+    }
+}
+
+static int tps_event(Tps65921State *s, int id, enum i2c_event event)
+{
+    if (event == I2C_START_SEND) {
+        s->slave[id].addressed = false;
+    }
+    return 0;
+}
+
+static int tps_send(Tps65921State *s, int id, uint8_t data)
+{
+    Tps65921Slave *sl = &s->slave[id];
+
+    if (!sl->addressed) {
+        sl->ptr = data;
+        sl->addressed = true;
+    } else {
+        tps_write(s, id, sl->ptr++, data);
+    }
+    return 0;
+}
+
+static uint8_t tps_recv(Tps65921State *s, int id)
+{
+    return tps_read(s, id, s->slave[id].ptr++);
+}
+
+static int tps_core_event(I2CSlave *i2c, enum i2c_event event)
+{
+    return tps_event(TPS65921(i2c), 0, event);
+}
+
+static int tps_core_send(I2CSlave *i2c, uint8_t data)
+{
+    return tps_send(TPS65921(i2c), 0, data);
+}
+
+static uint8_t tps_core_recv(I2CSlave *i2c)
+{
+    return tps_recv(TPS65921(i2c), 0);
+}
+
+static int tps_sub_event(I2CSlave *i2c, enum i2c_event event)
+{
+    Tps65921SubState *sub = TPS65921_SUB(i2c);
+
+    return tps_event(sub->core, sub->id, event);
+}
+
+static int tps_sub_send(I2CSlave *i2c, uint8_t data)
+{
+    Tps65921SubState *sub = TPS65921_SUB(i2c);
+
+    return tps_send(sub->core, sub->id, data);
+}
+
+static uint8_t tps_sub_recv(I2CSlave *i2c)
+{
+    Tps65921SubState *sub = TPS65921_SUB(i2c);
+
+    return tps_recv(sub->core, sub->id);
+}
+
+static void tps_reset(DeviceState *dev)
+{
+    Tps65921State *s = TPS65921(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->slave, 0, sizeof(s->slave));
+    s->regs[3][RTC_CTRL] = RTC_CTRL_STOP_RTC;   /* running from power-on */
+    s->regs[3][PWR_IMR1] = 0xff;
+    s->pwr_pending = 0;
+    tps_update_irq(s);
+}
+
+static void tps_realize(DeviceState *dev, Error **errp)
+{
+    Tps65921State *s = TPS65921(dev);
+    I2CBus *bus = I2C_BUS(qdev_get_parent_bus(dev));
+
+    for (int i = 1; i < TPS65921_NUM_ID; i++) {
+        DeviceState *sub = qdev_new(TYPE_TPS65921_SUB);
+
+        qdev_prop_set_uint8(sub, "address", TPS65921_ADDR + i);
+        s->sub[i - 1] = TPS65921_SUB(sub);
+        s->sub[i - 1]->core = s;
+        s->sub[i - 1]->id = i;
+        if (!qdev_realize_and_unref(sub, BUS(bus), errp)) {
+            return;
+        }
+    }
+}
+
+static bool tps_get_pwron(Object *obj, Error **errp)
+{
+    return TPS65921(obj)->pwron;
+}
+
+static void tps_prop_set_pwron(Object *obj, bool value, Error **errp)
+{
+    tps_set_pwron(obj, 0, value);
+}
+
+static void tps_init(Object *obj)
+{
+    Tps65921State *s = TPS65921(obj);
+
+    qdev_init_gpio_out(DEVICE(obj), &s->irq, 1);
+    qdev_init_gpio_in(DEVICE(obj), tps_set_pwron, 1);
+    for (int i = 0; i < 16; i++) {
+        g_autofree char *name = g_strdup_printf("adcin%d-mv", i);
+
+        object_property_add_uint32_ptr(obj, name, &s->adcin_mv[i],
+                                       OBJ_PROP_FLAG_READWRITE);
+    }
+    object_property_add_bool(obj, "pwron", tps_get_pwron, tps_prop_set_pwron);
+    s->adcin_mv[9] = 3000;              /* VBKB: backup battery */
+    s->adcin_mv[12] = 3900;             /* VBAT */
+}
+
+static const VMStateDescription tps_vmstate = {
+    .name = TYPE_TPS65921,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, Tps65921State),
+        VMSTATE_UINT8_2DARRAY(regs, Tps65921State, TPS65921_NUM_ID, 256),
+        VMSTATE_INT64(rtc_offset, Tps65921State),
+        VMSTATE_UINT32_ARRAY(adcin_mv, Tps65921State, 16),
+        VMSTATE_BOOL(pwron, Tps65921State),
+        VMSTATE_UINT8(pwr_pending, Tps65921State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void tps_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->realize = tps_realize;
+    device_class_set_legacy_reset(dc, tps_reset);
+    dc->vmsd = &tps_vmstate;
+    dc->desc = "TPS65921 power management companion";
+    k->event = tps_core_event;
+    k->send = tps_core_send;
+    k->recv = tps_core_recv;
+}
+
+static void tps_sub_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->desc = "TPS65921 I2C ID 1-3";
+    dc->user_creatable = false;
+    k->event = tps_sub_event;
+    k->send = tps_sub_send;
+    k->recv = tps_sub_recv;
+}
+
+static const TypeInfo tps_types[] = {
+    {
+        .name = TYPE_TPS65921,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(Tps65921State),
+        .instance_init = tps_init,
+        .class_init = tps_class_init,
+    }, {
+        .name = TYPE_TPS65921_SUB,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(Tps65921SubState),
+        .class_init = tps_sub_class_init,
+    },
+};
+
+DEFINE_TYPES(tps_types)

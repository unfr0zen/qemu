+
+struct Imx6AdcState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    /* Hardware registers */
+    uint32_t hc[2];     /* HC0/HC1: channel + AIEN */
+    uint32_t hs;        /* COCO flags */

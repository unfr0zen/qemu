From d72e202bb78cb346d11cb4087e3a7d04bb6238e2 Mon Sep 17 00:00:00 2001
From: will <will-tm@users.noreply.github.com>
Date: Mon, 28 Sep 2026 20:19:46 -0400
Subject: [PATCH 34/36] hw/net: bcm43341: the channel answers brcmfmac needs

Firmware 6.4-8 drives the chip with brcmfmac (backported from Linux 4.12)
instead of bcmdhd, and warned at every boot on the model's answers:

- "chanspec" read 0, an invalid chanspec, so every nl80211 interface
  notification and cfg80211's regulatory check warned, and the latter
  made cfg80211 leave the network about once a minute. It now reports
  20 MHz on the current channel, as WLC_GET_CHANNEL does.
- "chanspecs" ignored the chanspec it is given: brcmfmac enables 40 MHz
  in 2.4 GHz with "bw_cap" and then asks for the 40 MHz ones only, and
  warned on each 20 MHz entry. It now filters by band and bandwidth, and
  lists 40 MHz channels only once the host has enabled 40 MHz.
- "bw_cap" (20 MHz, 40 MHz once set; none in 5 GHz), "rxchain" (1, a
  1x1 chip: at 0 brcmfmac advertised HT without rates) and "country"
  (stored and read back; 1-11 for US, 1-13 elsewhere, and
  WLC_GET_VALID_CHANNELS follows) answer like the chip.

bcmdhd reads mimo_bw_cap and never sets bw_cap, so it still sees the
20 MHz list.
---
 hw/net/bcm43341.c | 116 +++++++++++++++++++++++++++++++++++++---------
 1 file changed, 94 insertions(+), 22 deletions(-)

diff --git a/hw/net/bcm43341.c b/hw/net/bcm43341.c
index 75f5e0b..5272e17 100644
--- a/hw/net/bcm43341.c
+++ b/hw/net/bcm43341.c
@@ -20,7 +20,8 @@
  *           (BDC + a bcm_event_t), 2 data (BDC + an Ethernet frame). The
  *           host reads frames from F2 until it gets a zero frame tag.
  *
- *   wl      enough ioctls/iovars for dhd_preinit_ioctls and wl_cfg80211,
+ *   wl      enough ioctls/iovars for dhd_preinit_ioctls and wl_cfg80211
+ *           (and for brcmfmac, which the 6.4 firmware loads instead),
  *           an escan that finds one open access point, a join to it, and a
  *           data path to a QEMU NIC (-nic user,model=bcm43341) once joined.
  *
@@ -195,6 +196,8 @@ static const struct {
 #define WLC_IOCTL_VERSION       2
 #define WLC_BAND_AUTO           0
 #define WLC_BAND_2G             2
+#define WLC_BW_20MHZ_BIT        (1 << 0)
+#define WLC_BW_40MHZ_BIT        (1 << 1)
 #define WLC_PHY_TYPE_N          4
 
 /* events */
@@ -216,8 +219,13 @@ static const struct {
 #define WL_BSS_FLAGS_RSSI_ONCHANNEL 0x04
 #define WL_SCAN_ACTION_ABORT    3
 #define WL_SCAN_PARAMS_FIXED_SIZE 64    /* up to channel_list */
-#define WL_CHANSPEC_BW_20       0x1000  /* 2G band is 0 */
-#define BCM_NUM_CHANNELS        11
+/* Chanspecs in the 802.11ac layout (ioctl version 2) */
+#define WL_CHANSPEC_BW_MASK     0x3800
+#define WL_CHANSPEC_BW_20       0x1000
+#define WL_CHANSPEC_BW_40       0x1800
+#define WL_CHANSPEC_SB_UPPER    0x0100  /* 40 MHz: control is the upper half */
+#define WL_CHANSPEC_BAND_MASK   0xc000  /* 2G band is 0 */
+#define BCM_MAX_CHANSPECS       (13 + 2 * 9)
 
 #define BCM_RXQ_MAX             256
 
@@ -271,6 +279,8 @@ struct BCM43341State {
     bool associated;
     bool join_ok;
     uint32_t infra, auth, wsec, wpa_auth, pm;
+    uint8_t country[12];        /* wl_country_t: abbrev[4], rev, ccode[4] */
+    uint32_t bw_cap_2g;
     uint16_t scan_sync_id;
     bool scan_legacy;
     QEMUTimer *scan_timer;
@@ -552,17 +562,60 @@ static void put_str(uint8_t *out, size_t olen, const char *str)
     }
 }
 
-/* wl_country_t: abbrev[4], rev, ccode[4] */
-static void put_country(uint8_t *out, size_t olen)
+static void put_country(BCM43341State *s, uint8_t *out, size_t olen)
 {
-    if (olen >= 12) {
-        memcpy(out, "US", 3);
-        stl_le_p(out + 4, 0);
-        memcpy(out + 8, "US", 3);
+    if (olen >= sizeof(s->country)) {
+        memcpy(out, s->country, sizeof(s->country));
+    }
+}
+
+/* 2.4 GHz channels the country allows: 1-11 in the US, 1-13 elsewhere. */
+static unsigned bcm_num_channels(BCM43341State *s)
+{
+    return !strncmp((const char *)s->country + 8, "US", 4) ? 11 : 13;
+}
+
+/*
+ * "chanspecs": the valid chanspecs that match the one passed in, where a
+ * zero bandwidth means any. 20 MHz first, then 40 MHz upper and then lower
+ * sidebands, the order brcmfmac and bcmdhd both rely on. 40 MHz only once
+ * the host has enabled it through "bw_cap": out of reset it is off in 2G.
+ */
+static void bcm_get_chanspecs(BCM43341State *s, uint16_t match,
+                              uint8_t *out, size_t olen)
+{
+    uint16_t bw = match & WL_CHANSPEC_BW_MASK;
+    unsigned nch = bcm_num_channels(s), n = 0;
+    uint32_t list[BCM_MAX_CHANSPECS];
+
+    if (match & WL_CHANSPEC_BAND_MASK) {
+        return;                                 /* no 5 GHz band: none */
+    }
+    if (!bw || bw == WL_CHANSPEC_BW_20) {
+        for (unsigned ch = 1; ch <= nch; ch++) {
+            list[n++] = WL_CHANSPEC_BW_20 | ch;
+        }
+    }
+    if ((!bw || bw == WL_CHANSPEC_BW_40) &&
+        (s->bw_cap_2g & WLC_BW_40MHZ_BIT)) {
+        /* by centre channel, the control channel 2 above or below it */
+        for (unsigned c = 3; c + 2 <= nch; c++) {
+            list[n++] = WL_CHANSPEC_BW_40 | WL_CHANSPEC_SB_UPPER | c;
+        }
+        for (unsigned c = 3; c + 2 <= nch; c++) {
+            list[n++] = WL_CHANSPEC_BW_40 | c;
+        }
+    }
+    if (olen >= 4 * (1 + n)) {
+        stl_le_p(out, n);
+        for (unsigned i = 0; i < n; i++) {
+            stl_le_p(out + 4 + 4 * i, list[i]);
+        }
     }
 }
 
 static int bcm_get_var(BCM43341State *s, const char *name,
+                       const uint8_t *val, size_t vlen,
                        uint8_t *out, size_t olen)
 {
     if (!strcmp(name, "cur_etheraddr")) {
@@ -581,14 +634,18 @@ static int bcm_get_var(BCM43341State *s, const char *name,
     } else if (!strcmp(name, "nmode")) {
         put32(out, olen, 1);
     } else if (!strcmp(name, "chanspecs")) {
-        if (olen >= 4 * (1 + BCM_NUM_CHANNELS)) {
-            put32(out, olen, BCM_NUM_CHANNELS);
-            for (int i = 0; i < BCM_NUM_CHANNELS; i++) {
-                stl_le_p(out + 4 + 4 * i, WL_CHANSPEC_BW_20 | (i + 1));
-            }
-        }
+        bcm_get_chanspecs(s, vlen >= 2 ? lduw_le_p(val) : 0, out, olen);
+    } else if (!strcmp(name, "chanspec")) {
+        /* the channel the radio sits on, as WLC_GET_CHANNEL has it */
+        put32(out, olen, WL_CHANSPEC_BW_20 | s->channel);
+    } else if (!strcmp(name, "bw_cap")) {
+        /* per band, in WLC_BW_*_BIT; there is no 5 GHz band */
+        put32(out, olen, vlen >= 4 && ldl_le_p(val) == WLC_BAND_2G ?
+                         s->bw_cap_2g : 0);
+    } else if (!strcmp(name, "rxchain")) {
+        put32(out, olen, 1);                    /* one antenna, 1x1 */
     } else if (!strcmp(name, "country")) {
-        put_country(out, olen);
+        put_country(s, out, olen);
     } else if (!strcmp(name, "wlfc_mode") || !strcmp(name, "tlv") ||
                !strcmp(name, "bus:txglom_auto_control")) {
         return BCME_UNSUPPORTED;
@@ -612,6 +669,16 @@ static int bcm_set_var(BCM43341State *s, const char *name,
         }
     } else if (!strcmp(name, "event_msgs")) {
         memcpy(s->eventmask, val, MIN(vlen, sizeof(s->eventmask)));
+    } else if (!strcmp(name, "country")) {
+        if (vlen >= sizeof(s->country)) {
+            memcpy(s->country, val, sizeof(s->country));
+        }
+    } else if (!strcmp(name, "bw_cap")) {
+        /* {band, bw_cap}: 2G does 20 MHz, and 40 MHz when asked to */
+        if (vlen >= 8 && ldl_le_p(val) == WLC_BAND_2G) {
+            s->bw_cap_2g = WLC_BW_20MHZ_BIT |
+                           (ldl_le_p(val + 4) & WLC_BW_40MHZ_BIT);
+        }
     } else if (!strcmp(name, "escan")) {
         /* wl_escan_params_t: version, action, sync_id, params */
         if (vlen >= 8 && lduw_le_p(val + 4) == WL_SCAN_ACTION_ABORT) {
@@ -645,7 +712,7 @@ static int bcm_ioctl(BCM43341State *s, uint32_t cmd, bool set,
         put32(out, olen, WLC_IOCTL_MAGIC);
         break;
     case WLC_GET_VERSION:
-        put32(out, olen, WLC_IOCTL_VERSION);
+        put32(out, olen, WLC_IOCTL_VERSION);    /* 802.11ac chanspecs */
         break;
     case WLC_UP:
         s->up = true;
@@ -754,7 +821,7 @@ static int bcm_ioctl(BCM43341State *s, uint32_t cmd, bool set,
         put32(out, olen, 1);
         break;
     case WLC_GET_COUNTRY:
-        put_country(out, olen);
+        put_country(s, out, olen);
         break;
     case WLC_GET_RSSI:
         put32(out, olen, (uint32_t)-40);        /* scb_val_t.val */
@@ -781,9 +848,10 @@ static int bcm_ioctl(BCM43341State *s, uint32_t cmd, bool set,
         put32(out, olen, 0);
         break;
     case WLC_GET_VALID_CHANNELS:
-        if (olen >= 4 * (1 + BCM_NUM_CHANNELS)) {
-            stl_le_p(out, BCM_NUM_CHANNELS);
-            for (int i = 0; i < BCM_NUM_CHANNELS; i++) {
+        len = bcm_num_channels(s);
+        if (olen >= 4 * (1 + len)) {
+            stl_le_p(out, len);
+            for (int i = 0; i < len; i++) {
                 stl_le_p(out + 4 + 4 * i, i + 1);
             }
         }
@@ -807,7 +875,7 @@ static int bcm_ioctl(BCM43341State *s, uint32_t cmd, bool set,
         }
         if (cmd == WLC_GET_VAR) {
             memset(out, 0, olen);
-            ret = bcm_get_var(s, name, out, olen);
+            ret = bcm_get_var(s, name, val, vlen, out, olen);
         } else {
             ret = bcm_set_var(s, name, val, vlen);
         }
@@ -1379,6 +1447,10 @@ static void bcm_chip_reset(BCM43341State *s)
     memset(s->eventmask, 0, sizeof(s->eventmask));
     s->infra = 1;
     s->auth = s->wsec = s->wpa_auth = s->pm = 0;
+    memset(s->country, 0, sizeof(s->country));
+    memcpy(s->country, "US", 2);
+    memcpy(s->country + 8, "US", 2);
+    s->bw_cap_2g = WLC_BW_20MHZ_BIT;
     bcm_update_irq(s);
 }
 

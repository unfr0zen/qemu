+#define FSL_IMX6SX_QSPI1_MEM_ADDR   0x60000000
+#define FSL_IMX6SX_QSPI1_MEM_SIZE   0x10000000
+#define FSL_IMX6SX_QSPI2_ADDR       0x021E4000
+#define FSL_IMX6SX_QSPI2_MEM_ADDR   0x70000000
+#define FSL_IMX6SX_QSPI2_MEM_SIZE   0x10000000
+#define FSL_IMX6SX_UART2_ADDR       0x021E8000
+#define FSL_IMX6SX_UART2_IRQ        27
+#define FSL_IMX6SX_UART3_ADDR       0x021EC000
+#define FSL_IMX6SX_UART3_IRQ        28
+#define FSL_IMX6SX_UART4_ADDR       0x021F0000
+#define FSL_IMX6SX_UART4_IRQ        29
+#define FSL_IMX6SX_UART5_ADDR       0x021F4000
+#define FSL_IMX6SX_UART5_IRQ        30
+#define FSL_IMX6SX_I2C4_ADDR        0x021F8000
+#define FSL_IMX6SX_I2C4_IRQ         35
+#define FSL_IMX6SX_QOSC_ADDR        0x021FC000
+
+/* AIPS3 (the 6SX-only third bus) */
+#define FSL_IMX6SX_ADC1_ADDR        0x02280000
+#define FSL_IMX6SX_ADC2_ADDR        0x02284000
+#define FSL_IMX6SX_WDOG3_ADDR       0x02288000
+#define FSL_IMX6SX_WDOG3_IRQ        11
+#define FSL_IMX6SX_ECSPI4_ADDR      0x0228C000
+#define FSL_IMX6SX_SEMA4_ADDR       0x02290000
+#define FSL_IMX6SX_MU_ADDR          0x02294000
+#define FSL_IMX6SX_UART6_ADDR       0x022A0000
+#define FSL_IMX6SX_UART6_IRQ        17
+
+/* 2 GiB DRAM window, board ships with 512 MiB (DTB: 0x80000000 + 0x20000000) */
+#define FSL_IMX6SX_DRAM_ADDR        0x80000000
+#define FSL_IMX6SX_DRAM_MAX_SIZE    (2 * 1024 * 1024 * 1024ULL)
+
+struct FslIMX6SXState {
+    DeviceState parent_obj;
+
+    ARMCPU cpu;
+    A9MPPrivState a9mpcore;
+
+    IMX6CCMState ccm;
+    IMX6SRCState src;
+    IMX7SNVSState snvs;
+
+    IMXSerialState uart[FSL_IMX6SX_NUM_UARTS];
+    IMXGPTState gpt;
+    IMXEPITState epit[FSL_IMX6SX_NUM_EPITS];
+    IMXI2CState i2c[FSL_IMX6SX_NUM_I2CS];
+    IMXSPIState spi[FSL_IMX6SX_NUM_ECSPIS];
+    IMXGPIOState gpio[FSL_IMX6SX_NUM_GPIOS];
+    SDHCIState usdhc[FSL_IMX6SX_NUM_USDHCS];
+
+    IMXUSBPHYState usbphy[FSL_IMX6SX_NUM_USB_PHYS];
+    ChipideaState usb[FSL_IMX6SX_NUM_USBS];
+
+    IMXFECState eth[FSL_IMX6SX_NUM_ETHS];
+    IMX2WdtState wdt[FSL_IMX6SX_NUM_WDTS];
+
+    MemoryRegion rom;
+    MemoryRegion caam;
+    MemoryRegion ocram;
+    MemoryRegion gpu;
+    uint32_t gpu_clock_ctrl;
+
+    uint32_t phy_num;
+};
+
+#endif /* FSL_IMX6SX_H */
-- 

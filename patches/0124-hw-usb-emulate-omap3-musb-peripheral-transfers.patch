+/* Both the indexed and flat endpoint windows access the same registers. */
+static uint8_t *musb_ep_reg(Omap3MusbState *s, hwaddr addr, unsigned *ep,
+                            unsigned *reg)
+{
+    if (addr >= 0x10 && addr < 0x20) {
+        *ep = s->core[INDEX] & 15;
+        *reg = addr - 0x10;
+    } else if (addr >= 0x100 && addr < 0x200) {
+        *ep = (addr - 0x100) / 16;
+        *reg = addr & 15;
+    } else {
+        return NULL;
+    }
+    return &s->ep[*ep][*reg];
+}
+
+static uint8_t musb_read_byte(Omap3MusbState *s, hwaddr addr)
+{
+    unsigned ep, reg;
+    uint8_t *p = musb_ep_reg(s, addr, &ep, &reg);
+    uint8_t value;
+
+    if (p) {
+        if (!ep && reg == 15) {
+            return 0xde; /* dynamic FIFOs, soft connect, multi-packet */
+        }
+        if (reg == RXCOUNT || reg == RXCOUNT + 1) {
+            return s->rx_len[ep] >> (8 * (reg - RXCOUNT));
+        }
+        return *p;
+    }
+    if (addr >= 0x62 && addr <= 0x67) {
+        return s->fifo_config[s->core[INDEX] & 15][addr - 0x62];
+    }
+    switch (addr) {
+    case DEVCTL:
+        return (s->core[addr] & 1) | BIT(7) | (s->vbus ? 0x18 : 0);
+    case 0x6c:
+        return 0x90;
+    case 0x6d:
+        return 0x01;
+    case 0x78:
+        return 0xff;
+    case 0x79:
+        return 12;
+    }
+    value = s->core[addr];
+    if ((addr >= INTRTX && addr < INTRTX + 2) ||
+        (addr >= INTRRX && addr < INTRRX + 2) || addr == INTRUSB) {
+        s->core[addr] = 0;
+    }
+    return value;
+}
+
+static uint64_t musb_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Omap3MusbState *s = opaque;
+    uint64_t value = 0;
+
+    if (addr >= 0x20 && addr < 0x60) {
+        unsigned ep = (addr - 0x20) / 4;
+
+        for (unsigned i = 0; i < size; i++) {
+            if (s->rx_pos[ep] < s->rx_len[ep]) {
+                value |= (uint64_t)s->rx[ep][s->rx_pos[ep]++] << (8 * i);
+            }
+        }
+        return value;
+    }
+    if (addr < sizeof(s->core)) {
+        for (unsigned i = 0; i < size && addr + i < sizeof(s->core); i++) {
+            value |= (uint64_t)musb_read_byte(s, addr + i) << (8 * i);
+        }
+        musb_irq(s);
+        return value;
+    }
+    switch (addr) {
+    case 0x400:
+        return 0x33;
+    case 0x404:
+        return s->sysconfig;
+    case 0x408:
+        return 1;
+    case 0x40c:
+        return s->interfsel;
+    case 0x410:
+        return s->simenable;
+    case 0x414:
+        return s->forcestdby;
+    }
+    return 0;
+}
+
+static void musb_csr(Omap3MusbState *s, unsigned ep, unsigned reg,
+                     uint16_t value)
+{
+    uint16_t old = lduw_le_p(s->ep[ep] + reg);
+
+    if (!ep && reg == TXCSR) {
+        uint16_t csr = old & (CSR0_RXREADY | CSR0_TXREADY | CSR0_DATAEND |
+                              CSR0_SETUPEND | CSR0_SENTSTALL);
+
+        csr &= value | ~CSR0_SENTSTALL;
+        if (value & CSR0_SVDRX) {
+            csr &= ~CSR0_RXREADY;
+            s->rx_len[0] = s->rx_pos[0] = 0;
+        }
+        if (value & CSR0_SVDSETUP) {
+            csr &= ~CSR0_SETUPEND;
+        }
+        if (value & CSR0_FLUSH) {
+            csr &= ~(CSR0_TXREADY | CSR0_RXREADY);
+            s->tx_len[0] = s->tx_pos[0] = 0;
+            s->rx_len[0] = s->rx_pos[0] = 0;
+        }
+        csr |= value & (CSR0_TXREADY | CSR0_SENDSTALL | CSR0_DATAEND);
+        if (value & CSR0_DATAEND) {
+            s->status_ready = true;
+        }
+        stw_le_p(s->ep[0] + TXCSR, csr);
+    } else if (reg == TXCSR) {
+        const uint16_t wzc = BIT(7) | TX_SENTSTALL | BIT(2);
+
+        value = (value & ~wzc) | (old & value & wzc);
+        if (value & TX_FLUSH) {
+            s->tx_len[ep] = s->tx_pos[ep] = 0;
+            value &= ~TX_READY;
+        }
+        value &= ~(TX_FLUSH | BIT(6) | TX_NONEMPTY);
+        if (s->tx_len[ep]) {
+            value |= TX_NONEMPTY;
+        }
+        stw_le_p(s->ep[ep] + reg, value);
+    } else if (reg == RXCSR) {
+        const uint16_t wzc = RX_SENTSTALL | BIT(2) | RX_READY;
+
+        value = (value & ~wzc) | (old & value & wzc);
+        if (!(value & RX_READY) || (value & RX_FLUSH)) {
+            s->rx_len[ep] = s->rx_pos[ep] = 0;
+            value &= ~RX_READY;
+        }
+        stw_le_p(s->ep[ep] + reg, value & ~(RX_FLUSH | BIT(7)));
+    }
+}
+
+static void musb_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    Omap3MusbState *s = opaque;
+    unsigned ep, reg;
+    uint8_t *p;
+
+    if (addr >= 0x20 && addr < 0x60) {
+        ep = (addr - 0x20) / 4;
+        for (unsigned i = 0; i < size; i++) {
+            if (s->tx_len[ep] < FIFO_SIZE) {
+                s->tx[ep][s->tx_len[ep]++] = value >> (8 * i);
+            }
         }
         return;
     }
+    p = musb_ep_reg(s, addr, &ep, &reg);
+    if (p && (reg == TXCSR || reg == RXCSR) && size <= 2) {
+        uint16_t csr = lduw_le_p(s->ep[ep] + reg);
+
+        musb_csr(s, ep, reg, size == 2 ? value : (csr & 0xff00) | value);
+        return;
+    }
+    if (addr < sizeof(s->core)) {
+        for (unsigned i = 0; i < size && addr + i < sizeof(s->core); i++) {
+            hwaddr at = addr + i;
+            uint8_t byte = value >> (8 * i);
+
+            p = musb_ep_reg(s, at, &ep, &reg);
+            if (p) {
+                *p = byte;
+            } else if (at >= 0x62 && at <= 0x67) {
+                s->fifo_config[s->core[INDEX] & 15][at - 0x62] = byte;
+            } else if (at != INTRUSB && !(at >= INTRTX && at < INTRRX + 2)) {
+                if (at == POWER) {
+                    byte = (byte & ~BIT(4)) | (s->core[POWER] & BIT(4));
+                }
+                s->core[at] = byte;
+            }
+        }
+        musb_connect(s);
+        musb_irq(s);
+        return;
+    }
     switch (addr) {
-    case OTG_SYSCONFIG:
-        if (val & 2) {                  /* SOFTRESET */
+    case 0x404:
+        if (value & 2) {
             musb_reset(DEVICE(s));
+        } else {
+            s->sysconfig = value;
+        }
+        break;
+    case 0x40c:
+        s->interfsel = value;
+        break;
+    case 0x410:
+        s->simenable = value;
+        break;
+    case 0x414:
+        s->forcestdby = value;
+        break;
+    }
+}
+
+static bool musb_unhex(const char *hex, uint8_t *data, unsigned *length)
+{
+    size_t len = strlen(hex);
+
+    if (len % 2 || len > FIFO_SIZE * 2) {
+        return false;
+    }
+    for (size_t i = 0; i < len / 2; i++) {
+        int a = g_ascii_xdigit_value(hex[2 * i]);
+        int b = g_ascii_xdigit_value(hex[2 * i + 1]);
+
+        if (a < 0 || b < 0) {
+            return false;
+        }
+        data[i] = a * 16 + b;
+    }
+    *length = len / 2;
+    return true;
+}
+
+static void musb_token(Omap3MusbState *s, unsigned ep, bool in, uint8_t *data,
+                       unsigned length)
+{
+    g_autoptr(GString) reply = g_string_new(NULL);
+    unsigned reg = in || !ep ? TXCSR : RXCSR;
+    uint16_t csr = lduw_le_p(s->ep[ep] + reg);
+    unsigned ready =
+        ep ? (in ? TX_READY : RX_READY) : (in ? CSR0_TXREADY : CSR0_RXREADY);
+    unsigned stall = ep ? (in ? TX_STALL : RX_STALL) : CSR0_SENDSTALL;
+    const char *direction = in ? "IN" : "OUT";
+
+    g_string_append_printf(reply, "TOKEN %u %s ", ep, direction);
+    if (!s->connected || s->resetting) {
+        g_string_append(reply, "NAK");
+    } else if (csr & stall) {
+        csr |= ep ? (in ? TX_SENTSTALL : RX_SENTSTALL) : CSR0_SENTSTALL;
+        stw_le_p(s->ep[ep] + reg, csr);
+        musb_ep_irq(s, ep, in);
+        g_string_append(reply, "STALL");
+    } else if (!ep && s->status_ready && !length && (in != s->control_in)) {
+        stw_le_p(s->ep[0] + TXCSR, 0);
+        s->status_ready = false;
+        s->tx_len[0] = s->tx_pos[0] = 0;
+        musb_ep_irq(s, 0, true);
+        g_string_append(reply, in ? "ACK " : "ACK 0");
+    } else if (in) {
+        if (!(csr & ready)) {
+            g_string_append(reply, "NAK");
+        } else {
+            unsigned maxp = ep ? lduw_le_p(s->ep[ep]) & 0x7ff : 64;
+            unsigned count = MIN(length, s->tx_len[ep] - s->tx_pos[ep]);
+
+            count = MIN(count, maxp ? maxp : 64);
+
+            g_string_append(reply, "ACK ");
+            for (unsigned i = 0; i < count; i++) {
+                g_string_append_printf(reply, "%02x",
+                                       s->tx[ep][s->tx_pos[ep]++]);
+            }
+            if (s->tx_pos[ep] == s->tx_len[ep]) {
+                s->tx_len[ep] = s->tx_pos[ep] = 0;
+                stw_le_p(s->ep[ep] + reg,
+                         csr & ~(ready | (ep ? TX_NONEMPTY : 0)));
+                musb_ep_irq(s, ep, true);
+            }
+        }
+    } else if (csr & ready) {
+        g_string_append(reply, "NAK");
+    } else {
+        unsigned maxp = ep ? lduw_le_p(s->ep[ep] + 4) & 0x7ff : 64;
+        unsigned count = MIN(length, maxp ? maxp : 64);
+
+        memcpy(s->rx[ep], data, count);
+        s->rx_len[ep] = count;
+        s->rx_pos[ep] = 0;
+        stw_le_p(s->ep[ep] + reg, csr | ready);
+        musb_ep_irq(s, ep, false);
+        g_string_append_printf(reply, "ACK %u", count);
+    }
+    g_string_append_c(reply, '\n');
+    musb_send(s, reply->str);
+}
+
+static void musb_command(Omap3MusbState *s, const char *line)
+{
+    g_auto(GStrv) args = g_strsplit(line, " ", 3);
+    unsigned argc = g_strv_length(args), ep, length;
+    uint8_t data[FIFO_SIZE];
+
+    if (argc == 1 && !strcmp(args[0], "RESET") && s->connected) {
+        musb_clear_endpoints(s);
+        s->core[0] = 0;
+        s->core[INTRTX] = s->core[INTRTX + 1] = 0;
+        s->core[INTRRX] = s->core[INTRRX + 1] = 0;
+        s->core[POWER] &= ~BIT(4);
+        s->core[POWER] |= BIT(3);
+        if (s->high_speed && (s->core[POWER] & BIT(5))) {
+            s->core[POWER] |= BIT(4);
+        }
+        s->resetting = true;
+        s->core[INTRUSB] |= BIT(2);
+        musb_irq(s);
+        timer_mod(s->reset_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 10 * SCALE_MS);
+    } else if (argc == 2 && !strcmp(args[0], "SPEED") &&
+               (!strcmp(args[1], "hs") || !strcmp(args[1], "fs"))) {
+        s->high_speed = !strcmp(args[1], "hs");
+    } else if (argc == 2 && !strcmp(args[0], "SETUP") && s->connected &&
+               !s->resetting && strlen(args[1]) == 16 &&
+               musb_unhex(args[1], data, &length)) {
+        s->tx_len[0] = s->tx_pos[0] = 0;
+        memcpy(s->rx[0], data, 8);
+        s->rx_len[0] = 8;
+        s->rx_pos[0] = 0;
+        s->control_in = data[0] & 0x80;
+        s->status_ready = false;
+        uint16_t old = lduw_le_p(s->ep[0] + TXCSR);
+
+        stw_le_p(
+            s->ep[0] + TXCSR,
+            CSR0_RXREADY |
+                ((old & (CSR0_TXREADY | CSR0_DATAEND)) ? CSR0_SETUPEND : 0));
+        musb_ep_irq(s, 0, true);
+        musb_send(s, "SETUPACK\n");
+    } else if (argc == 3 && !qemu_strtoui(args[1], NULL, 10, &ep) &&
+               ep < EP_COUNT && !strcmp(args[0], "TOKENIN") &&
+               !qemu_strtoui(args[2], NULL, 10, &length) &&

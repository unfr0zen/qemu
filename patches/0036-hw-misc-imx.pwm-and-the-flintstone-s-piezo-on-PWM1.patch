diff --git a/include/hw/misc/imx_pwm.h b/include/hw/misc/imx_pwm.h
new file mode 100644
index 0000000..8459c06
--- /dev/null
+++ b/include/hw/misc/imx_pwm.h
@@ -0,0 +1,29 @@
+/*
+ * i.MX PWM (the i.MX27-style block of the i.MX6), see imx_pwm.c.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_IMX_PWM_H
+#define HW_MISC_IMX_PWM_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_IMX_PWM "imx.pwm"
+OBJECT_DECLARE_SIMPLE_TYPE(IMXPWMState, IMX_PWM)
+
+struct IMXPWMState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq tone;              /* the output's frequency in Hz, 0 = still */
+    int32_t hz;
+
+    uint32_t cr, ir, sar, pr;
+    uint32_t sr;                /* the W1C status flags */
+
+    uint32_t clock_frequency;   /* the rate of the clock it counts */
+};
+
+#endif /* HW_MISC_IMX_PWM_H */

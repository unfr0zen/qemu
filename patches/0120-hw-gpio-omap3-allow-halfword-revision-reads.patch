From: Will <will@localhost>
Subject: [PATCH] hw/gpio: omap3: allow halfword revision reads

Allow the halfword revision access used by mainline gpio-omap probing.
Keep other accesses word-sized.

--- a/hw/gpio/omap3_gpio.c
+++ b/hw/gpio/omap3_gpio.c
@@ -264,11 +264,19 @@
     gpio_update(s);
 }
 
+static bool gpio_access_valid(void *opaque, hwaddr addr, unsigned size,
+                              bool is_write, MemTxAttrs attrs)
+{
+    return size == 4 ||
+           (size == 2 && addr == GPIO_REVISION && !is_write);
+}
+
 static const MemoryRegionOps gpio_ops = {
     .read = gpio_read,
     .write = gpio_write,
     .endianness = DEVICE_LITTLE_ENDIAN,
-    .valid.min_access_size = 4,
+    .valid.min_access_size = 2,
+    .valid.accepts = gpio_access_valid,
     .valid.max_access_size = 4,
 };
 

From: Will
Subject: [PATCH] hw/display: vivante: normalize sign-extend vertex attributes

--- a/hw/display/vivante_3d.c
+++ b/hw/display/vivante_3d.c
@@ -1368,7 +1368,7 @@
         unsigned n = VE_NUM(cfg) ? VE_NUM(cfg) : 4;
         unsigned size = MIN(VE_END(cfg) - VE_START(cfg), 16u);
         uint32_t type = VE_TYPE(cfg);
-        bool norm = VE_NORMALIZE(cfg) == 2;
+        bool norm = VE_NORMALIZE(cfg) != 0;
         uint8_t buf[16] = {};
         VivVec *t = &temps[d->vs_in_reg[i] & (VIV_TEMPS - 1)];
 
--- a/hw/display/vivante_host_gl.inc.c
+++ b/hw/display/vivante_host_gl.inc.c
@@ -864,7 +864,7 @@
         glBindBuffer(GL_ARRAY_BUFFER, h->streams[stream]);
         glEnableVertexAttribArray(i);
         glVertexAttribPointer(i, VE_NUM(cfg) ? VE_NUM(cfg) : 4,
-                               types[VE_TYPE(cfg)], VE_NORMALIZE(cfg) == 2,
+                               types[VE_TYPE(cfg)], VE_NORMALIZE(cfg) != 0,
                                stride[stream],
                                (void *)(uintptr_t)VE_START(cfg));
     }
@@ -1042,7 +1042,7 @@
         glBindBuffer(GL_ARRAY_BUFFER, h->streams[stream]);
         glEnableVertexAttribArray(i);
         glVertexAttribPointer(i, VE_NUM(cfg) ? VE_NUM(cfg) : 4,
-                               types[VE_TYPE(cfg)], VE_NORMALIZE(cfg) == 2,
+                               types[VE_TYPE(cfg)], VE_NORMALIZE(cfg) != 0,
                                stride[stream],
                                (void *)(uintptr_t)VE_START(cfg));
     }

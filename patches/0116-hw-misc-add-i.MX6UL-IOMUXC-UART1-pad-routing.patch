From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: will <will-tm@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:30:00 -0500
Subject: [PATCH] hw/misc: add i.MX6UL IOMUXC UART1 pad routing

Store the IOMUXC mux, pad-control and input-select registers and route
UART1 DCE through its TX/RX pads and receive daisy selector. Redrive pad
connections on reset and after migration.

Give the i.MX UART external TX/RX connection inputs. Disconnecting TX
discards host output without stalling transmission; disconnected RX
discards input and break events instead of buffering them for reconnect.
Boards without mux wiring retain their directly connected UARTs.
---
diff --git a/MAINTAINERS b/MAINTAINERS
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -904,8 +904,10 @@
 F: hw/arm/mcimx6ul-evk.c
 F: hw/arm/fsl-imx6ul.c
 F: hw/misc/imx6ul_ccm.c
+F: hw/misc/imx6ul_iomuxc.c
 F: include/hw/arm/fsl-imx6ul.h
 F: include/hw/misc/imx6ul_ccm.h
+F: include/hw/misc/imx6ul_iomuxc.h
 F: docs/system/arm/mcimx6ul-evk.rst
 
 MCIMX7D SABRE / i.MX7
diff --git a/hw/char/imx_serial.c b/hw/char/imx_serial.c
--- a/hw/char/imx_serial.c
+++ b/hw/char/imx_serial.c
@@ -288,7 +288,9 @@
         if (s->ucr2 & UCR2_TXEN) {
             /* XXX this blocks entire thread. Rewrite to use
              * qemu_chr_fe_write and background I/O callbacks */
-            qemu_chr_fe_write_all(&s->chr, &ch, 1);
+            if (s->tx_connected) {
+                qemu_chr_fe_write_all(&s->chr, &ch, 1);
+            }
             s->usr1 &= ~USR1_TRDY;
             s->usr2 &= ~USR2_TXDC;
             imx_update(s);
@@ -387,6 +389,10 @@
 {
     IMXSerialState *s = (IMXSerialState *)opaque;
 
+    /* Host bytes on a disconnected RX pad are lost, not buffered. */
+    if (!s->rx_connected) {
+        return FIFO_SIZE;
+    }
     return s->ucr2 & UCR2_RXEN ? fifo32_num_free(&s->rx_fifo) : 0;
 }
 
@@ -417,6 +423,9 @@
 {
     IMXSerialState *s = (IMXSerialState *)opaque;
 
+    if (!s->rx_connected) {
+        return;
+    }
     s->usr2 |= USR2_WAKE;
 
     for (int i = 0; i < size; i++) {
@@ -426,7 +435,9 @@
 
 static void imx_event(void *opaque, QEMUChrEvent event)
 {
-    if (event == CHR_EVENT_BREAK) {
+    IMXSerialState *s = IMX_SERIAL(opaque);
+
+    if (event == CHR_EVENT_BREAK && s->rx_connected) {
         imx_put_data(opaque, URXD_BRK | URXD_FRMERR | URXD_ERR);
     }
 }
@@ -452,6 +463,19 @@
                              imx_event, NULL, s, NULL, true);
 }
 
+static void imx_serial_tx_connected(void *opaque, int n, int level)
+{
+    IMX_SERIAL(opaque)->tx_connected = level;
+}
+
+static void imx_serial_rx_connected(void *opaque, int n, int level)
+{
+    IMXSerialState *s = IMX_SERIAL(opaque);
+
+    s->rx_connected = level;
+    qemu_chr_fe_accept_input(&s->chr);
+}
+
 static void imx_serial_init(Object *obj)
 {
     SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
@@ -461,6 +485,13 @@
                           TYPE_IMX_SERIAL, 0x1000);
     sysbus_init_mmio(sbd, &s->iomem);
     sysbus_init_irq(sbd, &s->irq);
+    /* Boards without pin-mux wiring retain the directly connected UART. */
+    s->tx_connected = true;
+    s->rx_connected = true;
+    qdev_init_gpio_in_named(DEVICE(obj), imx_serial_tx_connected,
+                            "tx-connected", 1);
+    qdev_init_gpio_in_named(DEVICE(obj), imx_serial_rx_connected,
+                            "rx-connected", 1);
 }
 
 static const Property imx_serial_properties[] = {

diff --git a/hw/misc/imx6ul_iomuxc.c b/hw/misc/imx6ul_iomuxc.c
new file mode 100644
--- /dev/null
+++ b/hw/misc/imx6ul_iomuxc.c
@@ -0,0 +1,116 @@
+/*
+ * i.MX6UL IOMUXC register storage and UART1 DCE pad routing.
+ *
+ * Other peripheral routes and electrical pad characteristics are not modelled.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/misc/imx6ul_iomuxc.h"
+#include "hw/core/irq.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+
+#define UART1_TX_MUX  0x084
+#define UART1_RX_MUX  0x088
+#define UART1_RX_SEL  0x624
+#define MUX_MODE_MASK 0xf
+
+static void imx6ul_iomuxc_update(IMX6ULIOMUXCState *s)
+{
+    qemu_set_irq(s->uart1_tx,
+                 (s->regs[UART1_TX_MUX / 4] & MUX_MODE_MASK) == 0);
+    qemu_set_irq(s->uart1_rx,
+                 (s->regs[UART1_RX_MUX / 4] & MUX_MODE_MASK) == 0 &&
+                 (s->regs[UART1_RX_SEL / 4] & 7) == 3);
+}
+
+static uint64_t imx6ul_iomuxc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX6ULIOMUXCState *s = IMX6UL_IOMUXC(opaque);
+
+    return s->regs[offset / 4];
+}
+
+static void imx6ul_iomuxc_write(void *opaque, hwaddr offset, uint64_t value,
+                               unsigned size)
+{
+    IMX6ULIOMUXCState *s = IMX6UL_IOMUXC(opaque);
+
+    s->regs[offset / 4] = value;
+    if (offset == UART1_TX_MUX || offset == UART1_RX_MUX ||
+        offset == UART1_RX_SEL) {
+        imx6ul_iomuxc_update(s);
+    }
+}
+
+static const MemoryRegionOps imx6ul_iomuxc_ops = {
+    .read = imx6ul_iomuxc_read,
+    .write = imx6ul_iomuxc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void imx6ul_iomuxc_reset_hold(Object *obj, ResetType type)
+{
+    IMX6ULIOMUXCState *s = IMX6UL_IOMUXC(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    imx6ul_iomuxc_update(s);
+}
+
+static int imx6ul_iomuxc_post_load(void *opaque, int version_id)
+{
+    imx6ul_iomuxc_update(IMX6UL_IOMUXC(opaque));
+    return 0;
+}
+
+static const VMStateDescription vmstate_imx6ul_iomuxc = {
+    .name = TYPE_IMX6UL_IOMUXC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = imx6ul_iomuxc_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, IMX6ULIOMUXCState, IMX6UL_IOMUXC_SIZE / 4),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx6ul_iomuxc_init(Object *obj)
+{
+    IMX6ULIOMUXCState *s = IMX6UL_IOMUXC(obj);
+
+    memory_region_init_io(&s->iomem, obj, &imx6ul_iomuxc_ops, s,
+                          TYPE_IMX6UL_IOMUXC, IMX6UL_IOMUXC_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->uart1_tx,
+                             "uart1-tx-connected", 1);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->uart1_rx,
+                             "uart1-rx-connected", 1);
+}
+
+static void imx6ul_iomuxc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->vmsd = &vmstate_imx6ul_iomuxc;
+    dc->desc = "i.MX6UL IOMUXC (UART1 DCE routing)";
+    dc->user_creatable = false;
+    rc->phases.hold = imx6ul_iomuxc_reset_hold;
+}
+
+static const TypeInfo imx6ul_iomuxc_info = {
+    .name = TYPE_IMX6UL_IOMUXC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX6ULIOMUXCState),
+    .instance_init = imx6ul_iomuxc_init,
+    .class_init = imx6ul_iomuxc_class_init,
+};
+
+static void imx6ul_iomuxc_register_types(void)
+{
+    type_register_static(&imx6ul_iomuxc_info);
+}
+
+type_init(imx6ul_iomuxc_register_types)
diff --git a/include/hw/misc/imx6ul_iomuxc.h b/include/hw/misc/imx6ul_iomuxc.h
new file mode 100644
--- /dev/null
+++ b/include/hw/misc/imx6ul_iomuxc.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef IMX6UL_IOMUXC_H
+#define IMX6UL_IOMUXC_H
+
+#include "hw/core/sysbus.h"
+
+#define TYPE_IMX6UL_IOMUXC "imx6ul-iomuxc"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX6ULIOMUXCState, IMX6UL_IOMUXC)
+
+#define IMX6UL_IOMUXC_SIZE 0x700
+
+struct IMX6ULIOMUXCState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t regs[IMX6UL_IOMUXC_SIZE / 4];
+    qemu_irq uart1_tx;
+    qemu_irq uart1_rx;
+};
+
+#endif

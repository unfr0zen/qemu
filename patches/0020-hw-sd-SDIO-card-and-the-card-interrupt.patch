 hw/sd/sd.c            | 439 +++++++++++++++++++++++++++++++++++++++++-
 hw/sd/sdhci.c         |  21 ++
 include/hw/sd/sd.h    |  26 +++
 include/hw/sd/sdhci.h |   2 +
 5 files changed, 497 insertions(+), 1 deletion(-)


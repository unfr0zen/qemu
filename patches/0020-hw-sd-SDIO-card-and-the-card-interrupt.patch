diff --git a/hw/sd/sdhci.c b/hw/sd/sdhci.c
index c86dfa2..c52b4b4 100644
--- a/hw/sd/sdhci.c
+++ b/hw/sd/sdhci.c
@@ -270,6 +270,22 @@ static void sdhci_set_inserted(DeviceState *dev, bool level)
     }
 }
 
+static void sdhci_set_card_int(DeviceState *dev, bool level)
+{
+    SDHCIState *s = (SDHCIState *)dev;
+
+    /*
+     * The card interrupt is level-sensitive: as long as the card holds the
+     * line, clearing the status bit re-latches it (see sdhci_write), so
+     * remember the line state rather than just pulsing the bit.
+     */
+    s->card_int_level = level;
+    if (level && (s->norintstsen & SDHC_NISEN_CARDINT)) {
+        s->norintsts |= SDHC_NIS_CARDINT;
+    }
+    sdhci_update_irq(s);
+}
+
 static void sdhci_set_readonly(DeviceState *dev, bool level)
 {

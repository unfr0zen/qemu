+
+/* ------------------------------------------------------------------ SDIO */
+
+/*
+ * A minimal SDIO card, enough for Linux's mmc core to enumerate one I/O
+ * function and bind a driver to it by class. QEMU has no SDIO card model at
+ * all otherwise — CMD5/52/53 are declared optional and answered "illegal",
+ * which is deliberate so Linux concludes there is no SDIO card here.
+ *
+ * There is no storage. The card is a byte-addressed I/O space:
+ *
+ *   0x0000..0x00ff  CCCR   card capability, function enable/ready, CIS ptr
+ *   0x0100*n        FBR    per-function: interface class, CIS ptr, blksize
+ *   CIS areas       tuple chains the core parses for blksize and IDs
+ *
+ * Enumeration is CMD5 (OCR), CMD3 (RCA), CMD7 (select), then CMD52 byte
+ * reads/writes; CMD53 moves blocks once a driver is bound.
+ */
+
+#define SDIO_CCCR_REV           0x00
+#define SDIO_CCCR_SD_REV        0x01
+#define SDIO_CCCR_IOEN          0x02    /* function enable, written by core */
+#define SDIO_CCCR_IORDY         0x03    /* function ready, polled after IOEN */
+#define SDIO_CCCR_IENX          0x04
+#define SDIO_CCCR_INTX          0x05
+#define SDIO_CCCR_BUS_IF        0x07
+#define SDIO_CCCR_CAPS          0x08
+#define SDIO_CCCR_CIS_PTR       0x09    /* 24-bit, function 0's CIS */
+#define SDIO_CCCR_HIGH_SPEED    0x13
+
+#define SDIO_FBR(fn)            (0x100 * (fn))
+#define SDIO_FBR_STD_IF         0x00
+#define SDIO_FBR_CIS_PTR        0x09
+#define SDIO_FBR_BLKSIZE        0x10
+
+#define SDIO_CIS_F0             0x1000
+#define SDIO_CIS_FN(fn)         (0x1000 + 0x1000 * (fn))
+#define SDIO_NUM_FUNCS          2
+#define SDIO_IO_SIZE            0x4000
+/* Big enough for the largest multi-block CMD53 the aic8800 driver issues. */
+#define SDIO_BLK_SIZE           0x2000
+
+/* Tuples the core understands; anything else it skips. */
+#define CISTPL_MANFID           0x20
+#define CISTPL_FUNCID           0x21
+#define CISTPL_FUNCE            0x22
+#define CISTPL_END              0xff
+
+static void sdio_put(SDState *sd, uint32_t addr, uint8_t val)
+{
+    if (addr < sd->sdio_io_size) {
+        sd->sdio_io[addr] = val;
+    }
+}
+
+static void sdio_put_ptr(SDState *sd, uint32_t addr, uint32_t val)
+{
+    sdio_put(sd, addr, val & 0xff);
+    sdio_put(sd, addr + 1, (val >> 8) & 0xff);
+    sdio_put(sd, addr + 2, (val >> 16) & 0xff);
+}
+
+static void sdio_build_io(SDState *sd)
+{
+    uint32_t p;
+
+    memset(sd->sdio_io, 0, sd->sdio_io_size);
+
+    /* CCCR/FBR format 2.00, SD spec 2.00. */
+    sdio_put(sd, SDIO_CCCR_REV, 0x22);
+    sdio_put(sd, SDIO_CCCR_SD_REV, 0x02);
+    /* 4-bit bus support (S4MI) and low-speed card = no. */
+    sdio_put(sd, SDIO_CCCR_CAPS, 0x17);
+    sdio_put_ptr(sd, SDIO_CCCR_CIS_PTR, SDIO_CIS_F0);
+    sdio_put(sd, SDIO_CCCR_HIGH_SPEED, 0x01);
+
+    /*
+     * The aic8800 chips expose two I/O functions and their driver is picky
+     * about both: it matches SDIO_CLASS_WLAN, checks the MANFID of each
+     * function, and only latches on when probed for function *2*. So every
+     * function gets the WLAN class and its own CIS with its own device ID.
+     */
+    for (unsigned fn = 1; fn <= SDIO_NUM_FUNCS; fn++) {
+        sdio_put(sd, SDIO_FBR(fn) + SDIO_FBR_STD_IF, sd->sdio_class);
+        sdio_put_ptr(sd, SDIO_FBR(fn) + SDIO_FBR_CIS_PTR, SDIO_CIS_FN(fn));
+        sdio_put(sd, SDIO_FBR(fn) + SDIO_FBR_BLKSIZE, 0x00);
+        sdio_put(sd, SDIO_FBR(fn) + SDIO_FBR_BLKSIZE + 1, 0x02);   /* 512 */
+    }
+
+    /* Function 0 CIS: manufacturer, then the common function extension. */
+    p = SDIO_CIS_F0;
+    sdio_put(sd, p++, CISTPL_MANFID);
+    sdio_put(sd, p++, 4);
+    sdio_put(sd, p++, sd->sdio_vendor & 0xff);
+    sdio_put(sd, p++, sd->sdio_vendor >> 8);
+    sdio_put(sd, p++, sd->sdio_device & 0xff);
+    sdio_put(sd, p++, sd->sdio_device >> 8);
+
+    sdio_put(sd, p++, CISTPL_FUNCE);
+    sdio_put(sd, p++, 4);
+    sdio_put(sd, p++, 0x00);            /* common extension */
+    sdio_put(sd, p++, 0x00);            /* max block size 512 */
+    sdio_put(sd, p++, 0x02);
+    sdio_put(sd, p++, 0x32);            /* max transfer rate code */
+    sdio_put(sd, p++, CISTPL_END);
+
+    /*
+     * Per-function CIS. The function extension has to be long enough for
+     * the core to accept it (42 bytes covers every CCCR revision) and it
+     * carries the maximum block size at offset 12.
+     */
+    for (unsigned fn = 1; fn <= SDIO_NUM_FUNCS; fn++) {
+        uint16_t device = fn == 2 ? sd->sdio_device_f2 : sd->sdio_device;
+
+        p = SDIO_CIS_FN(fn);
+        sdio_put(sd, p++, CISTPL_MANFID);
+        sdio_put(sd, p++, 4);
+        sdio_put(sd, p++, sd->sdio_vendor & 0xff);
+        sdio_put(sd, p++, sd->sdio_vendor >> 8);
+        sdio_put(sd, p++, device & 0xff);
+        sdio_put(sd, p++, device >> 8);
+
+        sdio_put(sd, p++, CISTPL_FUNCID);
+        sdio_put(sd, p++, 2);
+        sdio_put(sd, p++, 0x0c);            /* generic function */
+        sdio_put(sd, p++, 0x00);
+
+        sdio_put(sd, p++, CISTPL_FUNCE);
+        sdio_put(sd, p++, 0x2a);
+        sdio_put(sd, p, 0x01);              /* per-function extension */
+        sdio_put(sd, p + 12, 0x00);         /* max block size 512 */
+        sdio_put(sd, p + 13, 0x02);
+        p += 0x2a;
+        sdio_put(sd, p++, CISTPL_END);
+    }
+}
+
+static uint8_t sdio_io_read(SDState *sd, uint32_t addr)
+{
+    return addr < sd->sdio_io_size ? sd->sdio_io[addr] : 0;
+}
+
+static void sdio_io_write(SDState *sd, uint32_t addr, uint8_t val)
+{
+    if (addr >= sd->sdio_io_size) {
+        return;
+    }
+    sd->sdio_io[addr] = val;
+
+    /*
+     * Enabling a function must make it report ready, or the core times out
+     * waiting and tears the card down again.
+     */
+    if (addr == SDIO_CCCR_IOEN) {
+        sd->sdio_io[SDIO_CCCR_IORDY] = val;
+    }
+}
+
+/* CMD5 */
+static sd_rsp_type_t sdio_cmd_IO_SEND_OP_COND(SDState *sd, SDRequest req)
+{
+    /*
+     * R4: number of I/O functions, memory-present flag and the OCR. The
+     * first probe passes a zero OCR to ask what the card supports; the
+     * second passes the voltage and expects the card to be ready.
+     */
+    sd->ocr = (1 << 31)                     /* card ready */
+            | (SDIO_NUM_FUNCS << 28)        /* number of I/O functions */
+            | 0x00ff8000;                   /* the usual 2.0-3.6 V window */
+    if (sd->state == sd_inactive_state) {
+        sd->state = sd_idle_state;
+    }
+    if (req.arg & 0x00ffffff) {
+        /*
+         * SDIO has no CMD2: once powered, the host goes straight to CMD3,
+         * which only answers in identification state.
+         */
+        sd->state = sd_identification_state;
+    }
+    return sd_r4;
+}
+
+/* CMD52 */
+static SDIOFunctionClass *sdio_fn_class(SDState *sd)
+{
+    if (!sd->sdio_fn_dev) {
+        return NULL;
+    }
+    return SDIO_FUNCTION_GET_CLASS(sd->sdio_fn_dev);
+}
+
+static sd_rsp_type_t sdio_cmd_IO_RW_DIRECT(SDState *sd, SDRequest req)
+{
+    bool write = req.arg & (1u << 31);
+    unsigned fn = (req.arg >> 28) & 0x7;
+    bool raw = req.arg & (1u << 27);
+    uint32_t addr = (req.arg >> 9) & 0x1ffff;
+    uint8_t data = req.arg & 0xff;
+    SDIOFunctionClass *fc = fn ? sdio_fn_class(sd) : NULL;
+
+    if (fc && fc->rw) {
+        data = fc->rw(sd->sdio_fn_dev, fn, addr, data, write);
+    } else if (write) {
+        sdio_io_write(sd, addr, data);
+        /* RAW ("read after write") wants the resulting value back. */
+        data = raw ? sdio_io_read(sd, addr) : data;
+    } else {
+        data = sdio_io_read(sd, addr);
+    }
+    sd->sdio_r5_data = data;
+    return sd_r5;
+}
+
+/* CMD53 */
+static sd_rsp_type_t sdio_cmd_IO_RW_EXTENDED(SDState *sd, SDRequest req)
+{
+    bool write = req.arg & (1u << 31);
+    unsigned fn = (req.arg >> 28) & 0x7;
+    uint32_t addr = (req.arg >> 9) & 0x1ffff;
+    bool block_mode = req.arg & (1u << 27);
+    bool incr = req.arg & (1u << 26);
+    uint32_t count = req.arg & 0x1ff;
+    SDIOFunctionClass *fc = fn ? sdio_fn_class(sd) : NULL;
+    uint32_t len;
+
+    if (block_mode) {
+        len = (count ? count : 512) * sd->blk_len;
+    } else {
+        len = count ? count : 512;
+    }
+    len = MIN(len, SDIO_BLK_SIZE);
+
+    sd->data_start = addr;
+    sd->data_offset = 0;
+    sd->data_size = len;
+    sd->sdio_blk_fn = fn;
+    sd->sdio_blk_write = write;
+    sd->sdio_blk_incr = incr;
+    sd->state = write ? sd_receivingdata_state : sd_sendingdata_state;
+    sd->sdio_r5_data = 0;
+
+    if (!write) {
+        if (fc && fc->read_block) {
+            fc->read_block(sd->sdio_fn_dev, fn, addr, sd->sdio_blk, len, incr);
+        } else {
+            for (uint32_t i = 0; i < len; i++) {
+                sd->sdio_blk[i] = sdio_io_read(sd, incr ? addr + i : addr);
+            }
+        }
+    }
+    return sd_r5;
+}
+
+static void sdio_write_byte(SDState *sd, uint8_t value)
+{
+    SDIOFunctionClass *fc;
+
+    if (sd->state != sd_receivingdata_state) {
+        return;
+    }
+    sd->sdio_blk[sd->data_offset] = value;
+    if (++sd->data_offset >= sd->data_size) {
+        sd->state = sd_transfer_state;
+        fc = sd->sdio_blk_fn ? sdio_fn_class(sd) : NULL;
+        if (fc && fc->write_block) {
+            fc->write_block(sd->sdio_fn_dev, sd->sdio_blk_fn, sd->data_start,
+                            sd->sdio_blk, sd->data_size, sd->sdio_blk_incr);
+        } else {
+            for (uint32_t i = 0; i < sd->data_size; i++) {
+                sdio_io_write(sd, sd->sdio_blk_incr ? sd->data_start + i
+                                                    : sd->data_start,
+                              sd->sdio_blk[i]);
+            }
+        }
+    }
+}
+
+static uint8_t sdio_read_byte(SDState *sd)
+{
+    uint8_t value;
+
+    if (sd->state != sd_sendingdata_state) {
+        return 0;
+    }
+    value = sd->sdio_blk[sd->data_offset];
+    if (++sd->data_offset >= sd->data_size) {
+        sd->state = sd_transfer_state;
+    }
+    return value;
+}
+
+static const SDProto sd_proto_sdio = {
+    .name = "SDIO",
+    .cmd = {
+        [0]  = {0,  sd_bc,   "GO_IDLE_STATE", sd_cmd_GO_IDLE_STATE},
+        [3]  = {0,  sd_bcr,  "SEND_RELATIVE_ADDR", sd_cmd_SEND_RELATIVE_ADDR},
+        [5]  = {9,  sd_bcr,  "IO_SEND_OP_COND", sdio_cmd_IO_SEND_OP_COND},
+        [7]  = {0,  sd_ac,   "(DE)SELECT_CARD", sd_cmd_DE_SELECT_CARD},
+        [15] = {0,  sd_ac,   "GO_INACTIVE_STATE", sd_cmd_GO_INACTIVE_STATE},
+        [52] = {9,  sd_bc,   "IO_RW_DIRECT", sdio_cmd_IO_RW_DIRECT},
+        [53] = {9,  sd_bc,   "IO_RW_EXTENDED", sdio_cmd_IO_RW_EXTENDED},
+    },
+};
+
+static void sdio_card_int_handler(void *opaque, int n, int level)
+{
+    SDState *sd = opaque;
+
+    sdbus_set_card_int(SD_BUS(qdev_get_parent_bus(DEVICE(sd))), level);
+}
+
+static void sdio_card_realize(DeviceState *dev, Error **errp)
+{
+    SDState *sd = SDMMC_COMMON(dev);
+
+    sd->sdio_io_size = SDIO_IO_SIZE;
+    sd->sdio_io = g_malloc0(sd->sdio_io_size);
+    sd->sdio_blk = g_malloc0(SDIO_BLK_SIZE);
+    sdio_build_io(sd);
+    sd->state = sd_idle_state;
+    sd->blk_len = 512;
+    qdev_init_gpio_in_named(dev, sdio_card_int_handler, "card-int", 1);
+}
+
+static void sdio_card_reset(DeviceState *dev)
+{
+    SDState *sd = SDMMC_COMMON(dev);
+
+    sdio_build_io(sd);
+    sd->state = sd_idle_state;
+    sd->blk_len = 512;
+}
+
+/* An I/O-only card has no CID or CSD; CMD0 resets it all the same. */
+static void sdio_set_cid(SDState *sd)
+{
+}
+
+static void sdio_set_csd(SDState *sd, uint64_t size)
+{
+}
+
+static bool sdio_get_inserted(SDState *sd)
+{
+    return true;
+}
+
+static bool sdio_get_readonly(SDState *sd)
+{
+    return false;
+}
+
+/* The defaults are an AIC8800D80, the chip every Lumyo board carries. */
+static const Property sdio_card_props[] = {
+    DEFINE_PROP_UINT8("class", SDState, sdio_class, 0x07),   /* WLAN */
+    DEFINE_PROP_UINT16("vendor-id", SDState, sdio_vendor, 0xc8a1),
+    DEFINE_PROP_UINT16("device-id", SDState, sdio_device, 0x0082),
+    DEFINE_PROP_UINT16("device-id-f2", SDState, sdio_device_f2, 0x0182),
+    DEFINE_PROP_LINK("function-device", SDState, sdio_fn_dev,
+                     TYPE_SDIO_FUNCTION, DeviceState *),
+};
+
+static void sdio_card_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SDCardClass *sc = SDMMC_COMMON_CLASS(klass);
+
+    dc->desc = "SDIO card";
+    dc->realize = sdio_card_realize;
+    device_class_set_props(dc, sdio_card_props);
+    device_class_set_legacy_reset(dc, sdio_card_reset);
+    sc->proto = &sd_proto_sdio;
+    sc->set_cid = sdio_set_cid;
+    sc->set_csd = sdio_set_csd;
+    sc->read_byte = sdio_read_byte;
+    sc->write_byte = sdio_write_byte;
+    sc->get_inserted = sdio_get_inserted;
+    sc->get_readonly = sdio_get_readonly;
+}
+
 static const TypeInfo sd_types[] = {

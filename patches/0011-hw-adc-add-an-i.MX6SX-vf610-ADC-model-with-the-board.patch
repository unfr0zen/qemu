diff --git a/include/hw/adc/imx6_adc.h b/include/hw/adc/imx6_adc.h
new file mode 100644
index 0000000..23a353e
--- /dev/null
+++ b/include/hw/adc/imx6_adc.h
@@ -0,0 +1,45 @@
+/*
+ * i.MX6SX / vf610 ADC — see imx6_adc.c.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_ADC_IMX6_ADC_H
+#define HW_ADC_IMX6_ADC_H
+
+#include "system/memory.h"
+#include "hw/core/sysbus.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_IMX6_ADC "imx6.adc"
+OBJECT_DECLARE_SIMPLE_TYPE(Imx6AdcState, IMX6_ADC)
+
+#define IMX6_ADC_REG_SIZE   0x4000
+
+struct Imx6AdcState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    /* Hardware registers */
+    uint32_t hc[2];     /* HC0/HC1: channel + AIEN */
+    uint32_t hs;        /* COCO flags */
+    uint32_t r[2];      /* R0/R1: last results */
+    uint32_t cfg, gc, gs, cv, ofs, cal, pctl;
+
+    /* The outside world */
+    bool gate;              /* level of the gate line */
+    bool gate_active_low;   /* hall-enable: low = powered */
+
+    /* The wheel (adc@02280000) */
+    uint64_t wheel_position; /* detents, set from the UI via QMP */
+    uint32_t wheel_steps;   /* detents per revolution */
+    uint32_t amplitude;     /* Hall swing around the midpoints, LSB */
+    uint32_t mid1, mid2;    /* DT: adc-channel-midpoints, channels 1/2 */
+    uint32_t ch0_sample;    /* battery divider reading while enabled */
+
+    QEMUTimer *convert;     /* completes the pending conversion */
+};
+
+#endif /* HW_ADC_IMX6_ADC_H */

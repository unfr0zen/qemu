From 895609c800087ed161d000cfd7dceb92355bc1cd Mon Sep 17 00:00:00 2001
From: will <will-tm@users.noreply.github.com>
Date: Mon, 28 Sep 2026 21:17:01 -0400
Subject: [PATCH 35/36] hw/display: vivante: a pixel on a shared edge is drawn
 once

The rasteriser evaluated each triangle's edge functions from that
triangle's own vertex, so the two triangles on either side of an edge
rounded differently. A pixel centre on the edge could then fail both
tests, and the pixel was never drawn: a dotted line of whatever lay
beneath, e.g. black along the diagonal of the disc behind "SOFTWARE" in
the settings menu (x == y, 241..282).

Evaluate every edge from its endpoints in a fixed order, and negate for
the triangle that walks it the other way: the two values are then equal
and opposite bit for bit, and the top-left rule gives such a pixel to
exactly one of them, as the hardware's fixed-point rasteriser does.
---
 hw/display/vivante_3d.c | 30 ++++++++++++++++++++++++------
 1 file changed, 24 insertions(+), 6 deletions(-)

diff --git a/hw/display/vivante_3d.c b/hw/display/vivante_3d.c
index 4938c90..5afe787 100644
--- a/hw/display/vivante_3d.c
+++ b/hw/display/vivante_3d.c
@@ -1714,7 +1714,7 @@ static void viv_raster_triangle(VivDraw *d, VivExec *e, const VivWin *a,
     float area = (b->x - a->x) * (c->y - a->y) - (c->x - a->x) * (b->y - a->y);
     const VivWin *v[3] = { a, b, c };
     bool front, tl[3];
-    float ex[3], ey[3], e0[3];
+    float ox[3], oy[3], dx[3], dy[3], sg[3];
     int x0, y0, x1, y1;
     uint32_t flat_mask = 0;
 
@@ -1733,11 +1733,28 @@ static void viv_raster_triangle(VivDraw *d, VivExec *e, const VivWin *a,
     }
     for (int i = 0; i < 3; i++) {
         const VivWin *p = v[(i + 1) % 3], *q = v[(i + 2) % 3];
-        /* edge function of p->q, positive inside */
-        ex[i] = -(q->y - p->y);
-        ey[i] = q->x - p->x;
-        e0[i] = -(ex[i] * p->x + ey[i] * p->y);
+
+        /*
+         * Edge function of p->q, positive inside. It is evaluated from the
+         * edge's endpoints in a fixed order, whichever way this triangle
+         * walks it, so the triangle on the other side of a shared edge gets
+         * the same value negated, bit for bit: a pixel centre on the edge
+         * then goes to exactly one of them (the top-left rule), and never
+         * to neither, as rounding from each triangle's own vertex allowed.
+         */
         tl[i] = viv_top_left(p->x, p->y, q->x, q->y);
+        sg[i] = 1.0f;
+        if (p->x > q->x || (p->x == q->x && p->y > q->y)) {
+            const VivWin *t = p;
+
+            p = q;
+            q = t;
+            sg[i] = -1.0f;
+        }
+        ox[i] = p->x;
+        oy[i] = p->y;
+        dx[i] = q->x - p->x;
+        dy[i] = q->y - p->y;
     }
     x0 = MAX((int)floorf(MIN(MIN(a->x, b->x), c->x)), d->xmin) & ~1;
     y0 = MAX((int)floorf(MIN(MIN(a->y, b->y), c->y)), d->ymin) & ~1;
@@ -1764,7 +1781,8 @@ static void viv_raster_triangle(VivDraw *d, VivExec *e, const VivWin *a,
                           px < d->xmax && py < d->ymax;
 
                 for (int i = 0; i < 3; i++) {
-                    w[l][i] = ex[i] * fx + ey[i] * fy + e0[i];
+                    w[l][i] = sg[i] * (dx[i] * (fy - oy[i]) -
+                                       dy[i] * (fx - ox[i]));
                     if (w[l][i] < 0.0f || (w[l][i] == 0.0f && !tl[i])) {
                         in = false;
                     }

From 5863ca93b38bfbce7f677c84bc053a2596e7cf49 Mon Sep 17 00:00:00 2001
From: will <will-tm@users.noreply.github.com>
Date: Thu, 15 Oct 2026 10:50:38 -0400
Subject: [PATCH 97/97] hw/arm: flintstone: the backplate detect line on the
 board chardev

BP-DETACHED drives GPIO5_IO13, the DT's sensor-mcu-gpios detect#,
low from reset; 'set BP-DETACHED 1' lifts the display off its base.
---
 hw/arm/flintstone.c               |  6 +++++-
 hw/arm/flintstone_board.c         | 28 ++++++++++++++++++++++++++++
 include/hw/arm/flintstone_board.h |  3 +++
 3 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/hw/arm/flintstone.c b/hw/arm/flintstone.c
index 59af276..100376e 100644
--- a/hw/arm/flintstone.c
+++ b/hw/arm/flintstone.c
@@ -392,7 +392,7 @@ static void flintstone_init(MachineState *machine)
 
     /*
      * The board around the SoC: the front button drives GPIO2_IO18 (the
-     * gpio-keys "HU Button"), and the firmware's own driven lines are
+     * gpio-keys "HU Button"), the backplate detect line GPIO5_IO13, and the firmware's own driven lines are
      * reported back — poweroff on GPIO1_IO11, the wifi module reset on
      * GPIO1_IO04, the wheel's Hall power on GPIO7_IO02 and the battery
      * divider enable on GPIO6_IO16. The chardev is attached with
@@ -426,6 +426,10 @@ static void flintstone_init(MachineState *machine)
     qdev_connect_gpio_out(board, 0,
                           qdev_get_gpio_in(DEVICE(object_resolve_path_component(
                               OBJECT(soc), "gpio2")), 18));
+    qdev_connect_gpio_out_named(board, FLINTSTONE_BOARD_DETECT, 0,
+                                qdev_get_gpio_in(DEVICE(
+                                    object_resolve_path_component(
+                                        OBJECT(soc), "gpio5")), 13));
     qdev_connect_gpio_out(gpio1, 11,
                           qdev_get_gpio_in(board,
                                            FLINTSTONE_BOARD_IN_POWEROFF));
diff --git a/hw/arm/flintstone_board.c b/hw/arm/flintstone_board.c
index 2000e97..a80dd50 100644
--- a/hw/arm/flintstone_board.c
+++ b/hw/arm/flintstone_board.c
@@ -10,6 +10,9 @@
  *
  *   HU-BUTTON   (out of this device, into GPIO2_IO18) the front button,
  *               gpio-keys "HU Button", active high, KEY_ENTER.
+ *   BP-DETACHED (out of this device, into GPIO5_IO13) the backplate detect
+ *               line, the DT's sensor-mcu-gpios "detect#": low while the
+ *               display sits on its base, as it does from reset.
  *   POWEROFF    (GPIO1_IO11) gpio-poweroff: the firmware raises it to cut
  *               the board's power.
  *   WIFI-RESET  (GPIO1_IO04) the Broadcom wifi module's reset line.
@@ -32,6 +35,8 @@
  *   set HU-BUTTON 1             press the button (0 = release)
  *   hold HU-BUTTON 1 3000       press it for exactly 3000 ms of guest
  *                               time, then release
+ *   set BP-DETACHED 1           lift the display off its base (0 = put
+ *                               it back)
  *   dump                        report every line again
  *
  * SPDX-License-Identifier: GPL-2.0-or-later
@@ -70,6 +75,8 @@ struct FlintstoneBoardState {
 
     qemu_irq button;            /* into GPIO2_IO18 */
     bool button_level;
+    qemu_irq detect;            /* into GPIO5_IO13, low while attached */
+    bool detached;
 
     bool lines[FLINTSTONE_BOARD_IN];
     int beeper_hz;
@@ -100,6 +107,16 @@ static void board_set_button(FlintstoneBoardState *s, bool level)
     board_emit(s, "HU-BUTTON", 'i', level ? 1000 : 0);
 }
 
+static void board_set_detached(FlintstoneBoardState *s, bool detached)
+{
+    if (detached == s->detached) {
+        return;
+    }
+    s->detached = detached;
+    qemu_set_irq(s->detect, detached);
+    board_emit(s, "BP-DETACHED", 'i', detached ? 1000 : 0);
+}
+
 static void board_set_line(FlintstoneBoardState *s, int line, bool level)
 {
     assert(line >= 0 && line < FLINTSTONE_BOARD_IN);
@@ -141,6 +158,13 @@ static void board_command(FlintstoneBoardState *s, const char *line)
                        s->lines[i] ? 1000 : 0);
         }
         board_emit(s, "BEEPER", 'o', s->beeper_hz);
+        board_emit(s, "BP-DETACHED", 'i', s->detached ? 1000 : 0);
+        return;
+    }
+    if (!strcmp(argv[0], "set") && argv[1] && argv[2] && !argv[3] &&
+        !strcmp(argv[1], "BP-DETACHED") &&
+        (!strcmp(argv[2], "0") || !strcmp(argv[2], "1"))) {
+        board_set_detached(s, argv[2][0] == '1');
         return;
     }
     if ((!strcmp(argv[0], "set") || !strcmp(argv[0], "hold")) &&
@@ -226,6 +250,9 @@ static void flintstone_board_reset(DeviceState *dev)
     /* The button rests unpressed: active high, idle low. */
     s->button_level = false;
     qemu_set_irq(s->button, 0);
+    /* The display sits on its base. */
+    s->detached = false;
+    qemu_set_irq(s->detect, 0);
 }
 
 static void flintstone_board_realize(DeviceState *dev, Error **errp)
@@ -233,6 +260,7 @@ static void flintstone_board_realize(DeviceState *dev, Error **errp)
     FlintstoneBoardState *s = FLINTSTONE_BOARD(dev);
 
     qdev_init_gpio_out(dev, &s->button, 1);
+    qdev_init_gpio_out_named(dev, &s->detect, FLINTSTONE_BOARD_DETECT, 1);
     qdev_init_gpio_in(dev, flintstone_board_gpio_in, FLINTSTONE_BOARD_IN);
     qdev_init_gpio_in_named(dev, flintstone_board_beeper,
                             FLINTSTONE_BOARD_BEEPER, 1);
diff --git a/include/hw/arm/flintstone_board.h b/include/hw/arm/flintstone_board.h
index 7abd336..46a285e 100644
--- a/include/hw/arm/flintstone_board.h
+++ b/include/hw/arm/flintstone_board.h
@@ -28,4 +28,7 @@ enum {
 /* The piezo's drive: PWM1's frequency in Hz (0 = still), a named input. */
 #define FLINTSTONE_BOARD_BEEPER "beeper"
 
+/* The backplate detect line, a named output: high with the base off. */
+#define FLINTSTONE_BOARD_DETECT "detect"
+
 #endif /* HW_ARM_FLINTSTONE_BOARD_H */
-- 
2.56.0


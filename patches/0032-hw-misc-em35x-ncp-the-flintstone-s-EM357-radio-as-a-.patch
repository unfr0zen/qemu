+system_ss.add(when: 'CONFIG_EM35X_NCP', if_true: files('em35x_ncp.c'))
diff --git a/include/hw/misc/em35x_ncp.h b/include/hw/misc/em35x_ncp.h
new file mode 100644
index 0000000..755e7f4
--- /dev/null
+++ b/include/hw/misc/em35x_ncp.h
@@ -0,0 +1,18 @@
+/*
+ * Silicon Labs EM35x network co-processor, as a chardev (SPI and its lines).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_EM35X_NCP_H
+#define HW_MISC_EM35X_NCP_H
+
+#define TYPE_EM35X_NCP "em35x-ncp"
+
+/* Named GPIO inputs (driven by the host SoC) and output (to it). */
+#define EM35X_NCP_NSSEL     "nssel"
+#define EM35X_NCP_NRESET    "nreset"
+#define EM35X_NCP_NWAKE     "nwake"
+#define EM35X_NCP_NHOST_INT "nhost-int"
+
+#endif

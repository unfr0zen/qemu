diff --git a/include/hw/misc/imx_gpmi_nand.h b/include/hw/misc/imx_gpmi_nand.h
new file mode 100644
index 0000000..273e4a5
--- /dev/null
+++ b/include/hw/misc/imx_gpmi_nand.h
@@ -0,0 +1,108 @@
+/*
+ * i.MX6 GPMI NAND flash controller emulation (with APBH DMA and BCH ECC)
+ *
+ * Modelled against the register-level behavior the stock software depends
+ * on: U-Boot 2014.04 `mxs_nand` + `apbh_dma`, and (for the later kernel
+ * boot) the 4.1.15 `gpmi-nand`/`mxs-dma` drivers. The NAND backend is a
+ * flat, de-ECC'd page image: page N is at offset N * 2048, with BCH parity
+ * already stripped, so the model treats every transfer as error-free.
+ *
+ *  This program is free software; you can redistribute it and/or modify it
+ *  under the terms of the GNU General Public License as published by the
+ *  Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+#ifndef HW_MISC_IMX_GPMI_NAND_H
+#define HW_MISC_IMX_GPMI_NAND_H
+
+#include "hw/core/sysbus.h"
+#include "system/block-backend.h"
+
+#define TYPE_IMX_GPMI_NAND "imx-gpmi-nand"
+OBJECT_DECLARE_SIMPLE_TYPE(ImxGpmiNandState, IMX_GPMI_NAND)
+
+/* The whole subsystem is one contiguous block: APBH, GPMI, BCH. */
+#define IMX_GPMI_NAND_APBH_OFF   0x0000
+#define IMX_GPMI_NAND_GPMI_OFF   0x2000
+#define IMX_GPMI_NAND_BCH_OFF    0x4000
+#define IMX_GPMI_NAND_SIZE       0xC000
+
+#define IMX_GPMI_NAND_NUM_CHANNELS 4
+
+typedef struct ImxGpmiNandChannel {
+    uint32_t curcmdar;
+    uint32_t nxtcmdar;
+    uint32_t bar;
+    uint32_t sema;
+} ImxGpmiNandChannel;
+
+/* NAND geometry of the gen3 part (MT29F4G08-class, 512 MiB) */
+#define IMX_GPMI_NAND_PAGE_SIZE   2048
+#define IMX_GPMI_NAND_OOB_SIZE    64
+#define IMX_GPMI_NAND_BLOCK_PAGES 64
+#define IMX_GPMI_NAND_META_SIZE   10
+
+enum imx_gpmi_stream {
+    GPMI_STREAM_NONE,
+    GPMI_STREAM_ID,
+    GPMI_STREAM_STATUS,
+    GPMI_STREAM_PARAM,
+};
+
+struct ImxGpmiNandState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion container;
+    MemoryRegion apbh_mr;
+    MemoryRegion gpmi_mr;
+    MemoryRegion bch_mr;
+    qemu_irq irq_bch;
+    qemu_irq irq_apbh;
+    BlockBackend *blk;
+
+    /* APBH DMA */
+    uint32_t apbh_ctrl0;
+    uint32_t apbh_ctrl1;
+    uint32_t apbh_ctrl2;
+    uint32_t apbh_channel_ctrl;
+    ImxGpmiNandChannel ch[IMX_GPMI_NAND_NUM_CHANNELS];
+
+    /* GPMI */
+    uint32_t g_ctrl0;
+    uint32_t g_compare;
+    uint32_t g_eccctrl;
+    uint32_t g_ecccount;
+    uint32_t g_payload;
+    uint32_t g_auxiliary;
+    uint32_t g_ctrl1;
+    uint32_t g_timing0;
+    uint32_t g_timing1;
+    uint32_t g_timing2;
+
+    /* BCH */
+    uint32_t bch_ctrl;
+    uint32_t bch_status0;
+    uint32_t bch_mode;
+    uint32_t bch_encodeptr;
+    uint32_t bch_dataptr;
+    uint32_t bch_metaptr;

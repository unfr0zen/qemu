+/*
+ * Broadcom BCM43341 SDIO wifi chip, as the bcmdhd driver sees it.
+ * See hw/net/bcm43341.c.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_NET_BCM43341_H
+#define HW_NET_BCM43341_H
+
+#include "qom/object.h"
+
+#define TYPE_BCM43341 "bcm43341"
+
+/*
+ * GPIO lines:
+ *   in  "power"      WL_REG_ON; low holds the chip in reset
+ *   out "host-wake"  the out-of-band interrupt (active high)
+ *   out "card-int"   the in-band SDIO interrupt, to the sdio-card
+ */
+
+#endif /* HW_NET_BCM43341_H */

+/* Upload vertex streams without expanding indexed vertices on the CPU. */
+static bool viv_gl_vertices(VivHostGL *h, VivDraw *d, uint32_t start,
+                             unsigned n, bool indexed, uint32_t index_offset)
+{
+    static const GLenum types[16] = {
+        GL_BYTE, GL_UNSIGNED_BYTE, GL_SHORT, GL_UNSIGNED_SHORT,
+        GL_INT, GL_UNSIGNED_INT, GL_INT_2_10_10_10_REV,
+        GL_UNSIGNED_INT_2_10_10_10_REV, GL_FLOAT, GL_HALF_FLOAT,
+    };
+    unsigned stride[8] = {}, end[8] = {};
+    uint32_t base[8] = {};
+    uint32_t first = UINT32_MAX, last = 0;
+    g_autofree uint32_t *indices = g_new(uint32_t, n);
+
+    for (unsigned i = 0; i < n; i++) {
+        indices[i] = viv_index(d, indexed, start, i, index_offset);
+        first = MIN(first, indices[i]);
+        last = MAX(last, indices[i]);
+    }
+    if (last - first >= VIV_MAX_VERTICES) {
+        return false;
+    }
+    for (unsigned i = 0; i < d->vs_inputs; i++) {
+        uint32_t cfg = d->st[ST_FE_VERTEX_ELEMENT_CONFIG + i];
+        unsigned stream = VE_STREAM(cfg) & 7;
+        if (!types[VE_TYPE(cfg)]) {
+            return false;
+        }
+        base[stream] = d->st[stream ?
+            ST_FE_VERTEX_STREAMS_BASE_ADDR + stream :
+            ST_FE_VERTEX_STREAM_BASE_ADDR];
+        stride[stream] = d->st[stream ?
+            ST_FE_VERTEX_STREAMS_CONTROL + stream :
+            ST_FE_VERTEX_STREAM_CONTROL] & 255;
+        end[stream] = MAX(end[stream], VE_END(cfg));
+    }
+    for (unsigned stream = 0; stream < 8; stream++) {
+        if (!end[stream]) {
+            continue;
+        }
+        unsigned size = (last - first) * stride[stream] + end[stream];
+        g_autofree uint8_t *data = g_malloc(size);
+        viv_dma(d->s, base[stream] + first * stride[stream], data, size, false);
+        glBindBuffer(GL_ARRAY_BUFFER, h->streams[stream]);
+        glBufferData(GL_ARRAY_BUFFER, size, data, GL_STREAM_DRAW);
+    }
+    for (unsigned i = 0; i < d->vs_inputs; i++) {
+        uint32_t cfg = d->st[ST_FE_VERTEX_ELEMENT_CONFIG + i];
+        unsigned stream = VE_STREAM(cfg) & 7;
+        if (!stride[stream]) {
+            VivVec values[VIV_TEMPS] = {};
+            viv_fetch_vertex(d, first, values);
+            glDisableVertexAttribArray(i);
+            glVertexAttrib4fv(i, values[d->vs_in_reg[i] & 63].f);
+            continue;
+        }
+        glBindBuffer(GL_ARRAY_BUFFER, h->streams[stream]);
+        glEnableVertexAttribArray(i);
+        glVertexAttribPointer(i, VE_NUM(cfg) ? VE_NUM(cfg) : 4,
+                               types[VE_TYPE(cfg)], VE_NORMALIZE(cfg) == 2,
+                               stride[stream],
+                               (void *)(uintptr_t)VE_START(cfg));
+    }
+    for (unsigned i = 0; i < n; i++) {
+        indices[i] -= first;
+    }
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, h->indices);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, n * sizeof(*indices), indices,
+                  GL_STREAM_DRAW);
+    return true;
+}

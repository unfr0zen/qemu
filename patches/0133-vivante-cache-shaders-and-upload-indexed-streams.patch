+static GBytes *viv_gl_program_key(VivDraw *d)
+{
+    uint32_t header[] = {
+        d->vs.start, d->vs.end, d->vs.ubase,
+        d->ps.start, d->ps.end, d->ps.ubase,
+        d->vs_inputs, d->vs_outputs, d->ps_inputs, d->ps_out_reg,
+        PA_SHADE_MODEL(d->st[ST_PA_CONFIG]), d->st[ST_PE_ALPHA_OP],
+    };
+    GByteArray *key = g_byte_array_new();
+
+    g_byte_array_append(key, (uint8_t *)header, sizeof(header));
+    g_byte_array_append(key, d->vs_in_reg, sizeof(d->vs_in_reg));
+    g_byte_array_append(key, d->vs_out_reg, sizeof(d->vs_out_reg));
+    g_byte_array_append(key, (uint8_t *)&d->st[ST_PA_SHADER_ATTRIBUTES], 40);
+    g_byte_array_append(key,
+        (uint8_t *)&d->st[ST_VS_INST_MEM + d->vs.start * 4],
+        (d->vs.end - d->vs.start) * 16);
+    g_byte_array_append(key,
+        (uint8_t *)&d->st[ST_PS_INST_MEM + d->ps.start * 4],
+        (d->ps.end - d->ps.start) * 16);
+    return g_byte_array_free_to_bytes(key);
+}

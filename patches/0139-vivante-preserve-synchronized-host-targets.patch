         depth = g_malloc0(width * height * d->z_bpp);
     }
-    for (unsigned y = 0; y < height; y++) {
-        for (unsigned x = 0; x < width; x++) {
-            unsigned i = y * width + x;
-            float c[4] = {};
-            uint8_t *p = viv_surf_ptr(&d->rt, viv_pixel_offset(d->rt_layout,
-                                     d->rt_stride, d->rt_bpp, x, y));
-            if (p) {
-                viv_rt_read(d, p, c);
+    bool packed = d->rt_fmt == 5 || d->rt_fmt == 6;
+    if (packed) {
+        viv_gl_surface_rows(&d->rt, d->rt_layout, d->rt_stride, 4,
+                             width, height, color, false);
+        if (d->rt_fmt == 5) {
+            for (unsigned i = 0; i < width * height; i++) {
+                ((uint32_t *)color)[i] |= 0xff000000;
             }
-            for (unsigned j = 0; j < 4; j++) {

-                                 d->z_stride, d->z_bpp, x, y));
+        }
+    } else {
+        for (unsigned y = 0; y < height; y++) {
+            for (unsigned x = 0; x < width; x++) {
+                unsigned i = y * width + x;
+                float c[4] = {};
+                uint8_t *p = viv_surf_ptr(&d->rt, viv_pixel_offset(
+                    d->rt_layout, d->rt_stride, d->rt_bpp, x, y));
                 if (p) {
-                    memcpy(depth + i * d->z_bpp, p, d->z_bpp);

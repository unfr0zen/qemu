     glBindFramebuffer(GL_FRAMEBUFFER, h->fbo);
     glActiveTexture(GL_TEXTURE0);
     glBindTexture(GL_TEXTURE_2D, h->color);
     glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0,
-                 GL_RGBA, GL_UNSIGNED_BYTE, color);
+                 packed ? GL_BGRA : GL_RGBA, GL_UNSIGNED_BYTE, color);
     glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
                            GL_TEXTURE_2D, h->color, 0);
     glBindTexture(GL_TEXTURE_2D, h->depth);
@@ -967,7 +1070,7 @@
     glDepthMask(d->zs && (d->z_cfg & PE_DEPTH_WRITE));
     glDisable(GL_STENCIL_TEST);
     glColorMask(d->rt_mask & 1, d->rt_mask & 2,
-                 d->rt_mask & 4, d->rt_mask & 8);

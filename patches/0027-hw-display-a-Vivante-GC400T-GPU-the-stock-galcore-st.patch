+/*
+ * Vivante GC400T GPU model: what the front end / resolve side
+ * (vivante_gc.c) and the 3D pipeline (vivante_3d.c) share.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_DISPLAY_VIVANTE_GC_INT_H
+#define HW_DISPLAY_VIVANTE_GC_INT_H
+
+#include "qemu/atomic.h"
+#include "qemu/log.h"
+#include "exec/hwaddr.h"
+#include "hw/core/sysbus.h"
+#include "hw/display/vivante_gc.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(VivGCState, VIVANTE_GC)
+
+#define VIV_REGS_SIZE           0x4000
+#define VIV_NUM_STATES          0x10000
+
+struct VivGCState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    QEMUTimer *fe_timer;
+    bool trace;
+
+    uint32_t regs[VIV_REGS_SIZE / 4];
+    uint32_t *states;
+    uint32_t intr_pending;
+
+    bool fe_running;
+    uint32_t fe_addr;           /* next command, GPU address */
+    uint32_t fe_ret;            /* CALL's return address */
+    uint64_t draws;
+    uint64_t unimp_seen;        /* LOG_UNIMP messages already given */
+    struct VivPool *pool;       /* rasteriser threads (vivante_3d.c) */
+};
+
+#define VIV_TRACE(s, fmt, ...)                                              \
+    do {                                                                    \
+        if ((s)->trace) {                                                   \
+            qemu_log("vivante-gc: " fmt "\n", ## __VA_ARGS__);              \
+        }                                                                   \
+    } while (0)
+
+/* Log something unimplemented once per kind (bit 0..63). */
+#define VIV_UNIMP(s, bit, fmt, ...)                                         \
+    do {                                                                    \
+        if (!((s)->unimp_seen & (1ull << (bit)))) {                         \
+            (s)->unimp_seen |= 1ull << (bit);                               \
+            qemu_log_mask(LOG_UNIMP, "vivante-gc: " fmt "\n",               \
+                          ## __VA_ARGS__);                                  \
+        }                                                                   \
+    } while (0)
+
+/* States (register byte address / 4) shared by both halves */
+#define ST_TS_MEM_CONFIG            0x0595
+#define   TS_DEPTH_FAST_CLEAR       (1u << 0)
+#define   TS_COLOR_FAST_CLEAR       (1u << 1)
+#define ST_TS_COLOR_STATUS_BASE     0x0596
+#define ST_TS_COLOR_SURFACE_BASE    0x0597
+#define ST_TS_COLOR_CLEAR_VALUE     0x0598
+#define ST_TS_DEPTH_STATUS_BASE     0x0599
+#define ST_TS_DEPTH_SURFACE_BASE    0x059a
+#define ST_TS_DEPTH_CLEAR_VALUE     0x059b
+
+/* Surface layouts: rows, 4x4 tiles, or 64x64 supertiles of 4x4 tiles. */
+enum { VIV_LINEAR, VIV_TILED, VIV_SUPERTILED };
+
+/*
+ * Byte offset of pixel (x, y) in a surface whose pixel rows (of its
+ * aligned width) are @stride bytes apart. Tiles are 16 pixels in a row;
+ * a supertile's 16x16 tiles go in the order the blob's are seen to:
+ * pairs across, four rows down, then the next pair of columns.
+ */
+static inline uint32_t viv_pixel_offset(int layout, uint32_t stride,
+                                        unsigned bpp, uint32_t x, uint32_t y)
+{
+    uint32_t tx, ty, t;
+
+    switch (layout) {
+    case VIV_TILED:
+        return (y >> 2) * stride * 4 +
+               ((x >> 2) * 16 + (y & 3) * 4 + (x & 3)) * bpp;
+    case VIV_SUPERTILED:
+        tx = (x >> 2) & 15;
+        ty = (y >> 2) & 15;
+        t = (tx & 1) | (ty & 3) << 1 | (tx >> 1) << 3 | (ty >> 2) << 6;
+        return (y >> 6) * stride * 64 + (x >> 6) * 64 * 64 * bpp +
+               (t * 16 + (y & 3) * 4 + (x & 3)) * bpp;
+    default:
+        return y * stride + x * bpp;
+    }
+}
+
+/*
+ * A window onto GPU memory for pixel work: pages are mapped as they are
+ * first touched, from any thread, and released (and, when written, marked
+ * dirty) together.
+ */
+typedef struct VivSurf {
+    VivGCState *s;
+    uint32_t base;              /* first byte, GPU (or physical) address */
+    uint32_t size;
+    bool phys;                  /* base is a physical address (TS) */
+    bool write;
+    uint32_t first_page;
+    uint32_t npages;
+    uint8_t **page;             /* host pointer per page, NULL = unmapped */
+    uint8_t *bad;               /* pages that could not be mapped */
+} VivSurf;
+
+hwaddr viv_translate(VivGCState *s, uint32_t addr);
+void viv_dma(VivGCState *s, uint32_t addr, void *buf, uint32_t len,
+             bool is_write);
+void viv_surf_init(VivSurf *m, VivGCState *s, uint32_t base, uint32_t size,
+                   bool phys, bool write);
+uint8_t *viv_surf_page(VivSurf *m, uint32_t idx);
+void viv_surf_release(VivSurf *m);
+
+/* Host pointer to byte @off of the surface, NULL if out of it or unmapped. */
+static inline uint8_t *viv_surf_ptr(VivSurf *m, uint32_t off)
+{
+    uint32_t a, idx;
+    uint8_t *page;
+
+    if (off >= m->size) {
+        return NULL;
+    }
+    a = m->base + off;
+    idx = (a >> 12) - m->first_page;
+    page = qatomic_read(&m->page[idx]);
+    if (!page) {
+        page = viv_surf_page(m, idx);
+    }
+    return page ? page + (a & 0xfff) : NULL;
+}
+
+void viv_ts_resolve(VivGCState *s, uint32_t surf, uint32_t size, bool depth);
+void viv3d_draw(VivGCState *s, uint32_t prim, uint32_t start, uint32_t count,
+                bool indexed, uint32_t index_offset);
+
+#endif /* HW_DISPLAY_VIVANTE_GC_INT_H */

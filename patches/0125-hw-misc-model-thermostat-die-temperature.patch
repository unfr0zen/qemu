diff --git a/hw/misc/imx6sx_tempmon.c b/hw/misc/imx6sx_tempmon.c
new file mode 100644
--- /dev/null
+++ b/hw/misc/imx6sx_tempmon.c
@@ -0,0 +1,195 @@
+/*
+ * i.MX6SX temperature monitor and read-only calibration shadow.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+#include "qapi/visitor.h"
+
+#define TYPE_IMX6SX_TEMPMON "imx6sx-tempmon"
+OBJECT_DECLARE_SIMPLE_TYPE(Imx6sxTempmonState, IMX6SX_TEMPMON)
+
+/* Synthetic ANA1 calibration count for the i.MX6SX transfer function. */
+#define CALIBRATION_COUNT 1500
+#define CALIBRATION_MILLIC 28581
+
+struct Imx6sxTempmonState {
+    SysBusDevice parent_obj;
+    MemoryRegion sensor0, sensor2, otp;
+    uint32_t regs[3];
+    int32_t temperature;
+};
+
+static uint32_t sensor_read(Imx6sxTempmonState *s, hwaddr addr)
+{
+    uint32_t value = s->regs[addr / 16];
+
+    if (addr / 16 == 0) {
+        int64_t slope = 10000000000LL /
+                        (15423 * CALIBRATION_COUNT - 4148468);
+        int64_t count = CALIBRATION_COUNT +
+                        ((int64_t)CALIBRATION_MILLIC - s->temperature) / slope;
+
+        value &= ~((0xfff << 8) | BIT(2));
+        if ((value & 3) == 2) {
+            value |= (CLAMP(count, 0, 4095) << 8) | BIT(2);
+        }
+    }
+    return value;
+}
+
+static void sensor_write(Imx6sxTempmonState *s, hwaddr addr, uint32_t value)
+{
+    uint32_t *reg = &s->regs[addr / 16];
+
+    switch (addr & 15) {
+    case 0:
+        *reg = value;
+        break;
+    case 4:
+        *reg |= value;
+        break;
+    case 8:
+        *reg &= ~value;
+        break;
+    case 12:
+        *reg ^= value;
+        break;
+    }
+}
+
+static uint64_t sensor0_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return sensor_read(opaque, addr);
+}
+
+static void sensor0_write(void *opaque, hwaddr addr, uint64_t value,
+                          unsigned size)
+{
+    sensor_write(opaque, addr, value);
+}
+
+static uint64_t sensor2_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return sensor_read(opaque, addr + 0x20);
+}
+
+static void sensor2_write(void *opaque, hwaddr addr, uint64_t value,
+                          unsigned size)
+{
+    sensor_write(opaque, addr + 0x20, value);
+}
+
+static uint64_t otp_read(void *opaque, hwaddr addr, unsigned size)
+{
+    /* Fuse word 14, exposed as the nvmem cell at byte offset 0x38. */
+    return addr == 0x4e0 ? CALIBRATION_COUNT << 20 : 0;
+}
+
+static void otp_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    /* Programming physical fuses is not part of the calibration shadow. */
+}
+
+static const MemoryRegionOps sensor0_ops = {
+    .read = sensor0_read,
+    .write = sensor0_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static const MemoryRegionOps sensor2_ops = {
+    .read = sensor2_read,
+    .write = sensor2_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static const MemoryRegionOps otp_ops = {
+    .read = otp_read,
+    .write = otp_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void tempmon_reset(DeviceState *dev)
+{
+    Imx6sxTempmonState *s = IMX6SX_TEMPMON(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0] = 1; /* POWER_DOWN */
+}
+
+static void tempmon_get_temperature(Object *obj, Visitor *v,
+                                    const char *name, void *opaque,
+                                    Error **errp)
+{
+    Imx6sxTempmonState *s = IMX6SX_TEMPMON(obj);
+
+    visit_type_int32(v, name, &s->temperature, errp);
+}
+
+static void tempmon_set_temperature(Object *obj, Visitor *v,
+                                    const char *name, void *opaque,
+                                    Error **errp)
+{
+    Imx6sxTempmonState *s = IMX6SX_TEMPMON(obj);
+
+    visit_type_int32(v, name, &s->temperature, errp);
+}
+
+static void tempmon_init(Object *obj)
+{
+    Imx6sxTempmonState *s = IMX6SX_TEMPMON(obj);
+
+    s->temperature = 45000;
+    object_property_add(obj, "die-temperature-millicelsius", "int",
+                        tempmon_get_temperature, tempmon_set_temperature,
+                        NULL, NULL);
+    memory_region_init_io(&s->sensor0, obj, &sensor0_ops, s,
+                           "imx6sx-tempsense01", 0x20);
+    memory_region_init_io(&s->sensor2, obj, &sensor2_ops, s,
+                           "imx6sx-tempsense2", 0x10);
+    memory_region_init_io(&s->otp, obj, &otp_ops, s,
+                           "imx6sx-calibration-shadow", 0x4000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->sensor0);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->sensor2);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->otp);
+}
+
+static const VMStateDescription tempmon_vmstate = {
+    .name = TYPE_IMX6SX_TEMPMON,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, Imx6sxTempmonState, 3),
+        VMSTATE_INT32(temperature, Imx6sxTempmonState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void tempmon_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, tempmon_reset);
+    dc->vmsd = &tempmon_vmstate;
+    dc->desc = "i.MX6SX temperature sampling and calibration shadow";
+}
+
+static const TypeInfo tempmon_info = {
+    .name = TYPE_IMX6SX_TEMPMON,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Imx6sxTempmonState),
+    .instance_init = tempmon_init,
+    .class_init = tempmon_class_init,
+};
+
+static void tempmon_register_types(void)
+{
+    type_register_static(&tempmon_info);
+}
+
+type_init(tempmon_register_types)

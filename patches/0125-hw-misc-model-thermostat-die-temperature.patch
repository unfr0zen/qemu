                                     FSL_IMX6SX_ANATOP_ADDR + 0x1C0,
                                     &usb_analog_mr);
     }
+    /* Temperature sampling overlays the ANATOP register bank. */
+    {
+        DeviceState *tempmon = qdev_new("imx6sx-tempmon");
+        SysBusDevice *sbd = SYS_BUS_DEVICE(tempmon);

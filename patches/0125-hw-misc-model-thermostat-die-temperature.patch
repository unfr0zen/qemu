@@ -29,6 +29,7 @@
 #include "system/runstate.h"
 #include "qemu/log.h"
 #include "qemu/module.h"
+#include "qapi/visitor.h"
 
 /* CM: one block per domain */
 #define CM_IVA2         0x0000
@@ -427,12 +428,47 @@
 #define START_PADCONF_SAVE      (1 << 1)
 #define PADCONF_SAVE_DONE       (1 << 0)
 
+/* OMAP36xx bandgap transfer table, TI's GPL-2.0 kernel thermal driver. */
+static const int omap36xx_adc_to_temp[128] = {
+    -40000, -40000, -40000, -40000, -40000, -40000, -40000, -40000,
+    -40000, -40000, -40000,    -40000, -40000, -38000, -35000, -34000,
+    -32000, -30000, -28000, -26000, -24000, -22000,    -20000, -18500,
+    -17000, -15000, -13500, -12000, -10000, -8000, -6500, -5000, -3500,
+    -1500, 0, 2000, 3500, 5000, 6500, 8500, 10000, 12000, 13500,
+    15000, 17000, 19000, 21000, 23000, 25000, 27000, 28500, 30000,
+    32000, 33500, 35000, 37000, 38500, 40000, 42000, 43500, 45000,
+    47000, 48500, 50000, 52000, 53500, 55000, 57000, 58500, 60000,
+    62000, 64000, 66000, 68000, 70000, 71500, 73500, 75000, 77000,
+    78500, 80000, 82000, 83500, 85000, 87000, 88500, 90000, 92000,
+    93500, 95000, 97000, 98500, 100000, 102000, 103500, 105000, 107000,
+    109000, 111000, 113000, 115000, 117000, 118500, 120000, 122000,
+    123500, 125000, 125000, 125000, 125000, 125000, 125000, 125000,
+    125000, 125000, 125000, 125000, 125000, 125000, 125000, 125000,
+    125000, 125000, 125000, 125000, 125000, 125000,    125000
+};
+
+static unsigned scm_temperature_count(Omap3ScmState *s)
+{
+    unsigned best = 0;
+
+    for (unsigned i = 1; i < ARRAY_SIZE(omap36xx_adc_to_temp); i++) {
+        if (llabs((int64_t)omap36xx_adc_to_temp[i] - s->temperature) <
+            llabs((int64_t)omap36xx_adc_to_temp[best] - s->temperature)) {
+            best = i;
+        }
+    }
+    return best;
+}
+
 static uint64_t scm_read(void *opaque, hwaddr addr, unsigned size)
 {
     Omap3ScmState *s = opaque;
     uint32_t word;
 
     switch (addr & ~3) {
+    case 0x524:
+        word = (s->regs[addr / 4] & ~0xffU) | scm_temperature_count(s);
+        break;
     case CONTROL_STATUS:
         word = CONTROL_STATUS_GP | s->sys_boot;
         break;
@@ -451,6 +487,12 @@
 
     s->regs[addr / 4] = deposit32(s->regs[addr / 4], (addr & 3) * 8, size * 8,
                                   val);
+    if ((addr & ~3) == 0x524) {
+        uint32_t *sensor = &s->regs[0x524 / 4];
+
+        *sensor = (*sensor & ~0x1ffU) | scm_temperature_count(s) |
+                  ((*sensor & BIT(9)) ? BIT(8) : 0);
+    }
     /*
      * The pad configuration save (before the core domain goes off)
      * completes at once: the kernel polls for it.
@@ -503,12 +545,35 @@
     Omap3ScmState *s = OMAP3_SCM(dev);
 
     memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0x524 / 4] = scm_temperature_count(s);
+}
+
+static void scm_get_temperature(Object *obj, Visitor *v,
+                                    const char *name, void *opaque,
+                                    Error **errp)
+{
+    Omap3ScmState *s = OMAP3_SCM(obj);
+
+    visit_type_int32(v, name, &s->temperature, errp);
+}
+
+static void scm_set_temperature(Object *obj, Visitor *v,
+                                    const char *name, void *opaque,
+                                    Error **errp)
+{
+    Omap3ScmState *s = OMAP3_SCM(obj);
+
+    visit_type_int32(v, name, &s->temperature, errp);
 }
 
 static void scm_init(Object *obj)
 {
     Omap3ScmState *s = OMAP3_SCM(obj);
 
+    s->temperature = 45000;
+    object_property_add(obj, "die-temperature-millicelsius", "int",
+                        scm_get_temperature, scm_set_temperature,
+                        NULL, NULL);
     memory_region_init_io(&s->iomem, obj, &scm_ops, s, "omap3-scm", 0x1000);
     memory_region_init_io(&s->tap, obj, &tap_ops, s, "omap3-tap", 0x1000);
     sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
@@ -529,10 +594,11 @@
 
 static const VMStateDescription scm_vmstate = {
     .name = TYPE_OMAP3_SCM,
-    .version_id = 1,
+    .version_id = 2,
     .minimum_version_id = 1,
     .fields = (const VMStateField[]) {
         VMSTATE_UINT32_ARRAY(regs, Omap3ScmState, 0x1000 / 4),
+        VMSTATE_INT32_V(temperature, Omap3ScmState, 2),
         VMSTATE_END_OF_LIST()
     },
 };

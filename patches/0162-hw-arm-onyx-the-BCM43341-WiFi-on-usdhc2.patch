From 8efad921580bc50b1419598804685b02e310167a Mon Sep 17 00:00:00 2001
From: will <will-tm@users.noreply.github.com>
Date: Sat, 21 Nov 2026 02:22:54 -0500
Subject: [PATCH] hw/arm: onyx: the BCM43341 WiFi on usdhc2

The stock Onyx firmware found no wlan0 (brcmfmac probed usdhc2 and got
no card) and its network settings showed error W5. Its WiFi is the
diamond3's chip: the image ships brcmfmac43340-sdio, the firmware
brcmfmac loads for the 43341, and the BCM43341B0 Bluetooth patch.

Put the BCM43341 SDIO model on usdhc2, as the diamond3 does on its
usdhc2: WL_REG_ON is GPIO2_IO16 (the brcm_wifi exporter's "reset",
still reported to the board), the host wake GPIO2_IO17 (the DT's
brcm-fmac interrupt). The chip takes the machine's -nic
model=bcm43341, so the unit joins "QEMU" on QEMU's user network.
---
 hw/arm/onyx.c | 52 ++++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 49 insertions(+), 3 deletions(-)

diff --git a/hw/arm/onyx.c b/hw/arm/onyx.c
index 5ea81a8..700d1ee 100644
--- a/hw/arm/onyx.c
+++ b/hw/arm/onyx.c
@@ -16,6 +16,10 @@
 #include "hw/arm/machines-qom.h"
 #include "hw/core/boards.h"
 #include "hw/core/qdev-properties.h"
+#include "hw/core/split-irq.h"
+#include "hw/net/bcm43341.h"
+#include "hw/sd/sd.h"
+#include "net/net.h"
 #include "qapi/visitor.h"
 #include "system/block-backend-global-state.h"
 #include "system/block-backend-io.h"
@@ -131,6 +135,50 @@ static void onyx_set_wheel(Object *obj, Visitor *v, const char *name,
     visit_type_int64(v, name, opaque, errp);
 }
 
+/*
+ * WiFi: the BCM43341 (brcmfmac, brcmfmac43340-sdio) on usdhc2. Its
+ * WL_REG_ON is GPIO2_IO16 (the brcm_wifi exporter's "reset"), which also
+ * goes to the board report; its host wake is GPIO2_IO17.
+ */
+static void onyx_init_wifi(FslIMX6ULState *soc, DeviceState *board)
+{
+    DeviceState *card = qdev_new(TYPE_SDIO_CARD);
+    DeviceState *chip = qdev_new(TYPE_BCM43341);
+    DeviceState *reg_on = qdev_new(TYPE_SPLIT_IRQ);
+
+    qemu_configure_nic_device(chip, true, NULL);
+    qdev_realize_and_unref(chip, NULL, &error_fatal);
+
+    /* Broadcom's IDs, and no standard class: the driver matches either. */
+    qdev_prop_set_uint8(card, "class", 0);
+    qdev_prop_set_uint16(card, "vendor-id", 0x02d0);
+    qdev_prop_set_uint16(card, "device-id", 0xa94d);
+    qdev_prop_set_uint16(card, "device-id-f2", 0xa94d);
+    object_property_set_link(OBJECT(card), "function-device", OBJECT(chip),
+                             &error_fatal);
+    qdev_realize_and_unref(card,
+                           qdev_get_child_bus(DEVICE(&soc->usdhc[1]),
+                                              "sd-bus"),
+                           &error_fatal);
+
+    qdev_prop_set_uint32(reg_on, "num-lines", 3);
+    qdev_realize_and_unref(reg_on, NULL, &error_fatal);
+    qdev_connect_gpio_out(DEVICE(&soc->gpio[1]), 16,
+                          qdev_get_gpio_in(reg_on, 0));
+    qdev_connect_gpio_out(reg_on, 0,
+                          qdev_get_gpio_in(board,
+                                           FLINTSTONE_BOARD_IN_WIFI_RESET));
+    qdev_connect_gpio_out(reg_on, 1,
+                          qdev_get_gpio_in_named(card, "power", 0));
+    qdev_connect_gpio_out(reg_on, 2,
+                          qdev_get_gpio_in_named(chip, "power", 0));
+
+    qdev_connect_gpio_out_named(chip, "card-int", 0,
+                                qdev_get_gpio_in_named(card, "card-int", 0));
+    qdev_connect_gpio_out_named(chip, "host-wake", 0,
+                                qdev_get_gpio_in(DEVICE(&soc->gpio[1]), 17));
+}
+
 static void onyx_init(MachineState *machine)
 {
     DeviceState *soc, *board, *adc;
@@ -169,9 +217,7 @@ static void onyx_init(MachineState *machine)
     qdev_connect_gpio_out_named(board, FLINTSTONE_BOARD_DETECT, 0,
                                 qdev_get_gpio_in(
                                     DEVICE(&FSL_IMX6UL(soc)->gpio[3]), 28));
-    qdev_connect_gpio_out(DEVICE(&FSL_IMX6UL(soc)->gpio[1]), 16,
-                          qdev_get_gpio_in(board,
-                                           FLINTSTONE_BOARD_IN_WIFI_RESET));
+    onyx_init_wifi(FSL_IMX6UL(soc), board);
     qdev_connect_gpio_out(DEVICE(&FSL_IMX6UL(soc)->gpio[1]), 21,
                           qdev_get_gpio_in(board,
                                            FLINTSTONE_BOARD_IN_HALL_ENABLE));
-- 

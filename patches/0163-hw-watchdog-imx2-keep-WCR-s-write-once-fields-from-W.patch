From 8dc3bb9d6d152daa28725c0cc8df495fe4b72eb9 Mon Sep 17 00:00:00 2001
From: will <will-tm@users.noreply.github.com>
Date: Sat, 21 Nov 2026 03:25:56 -0500
Subject: [PATCH] hw/watchdog: imx2: keep WCR's write-once fields from WCR

Writes to the write-once WCR fields took their old value from WICR
rather than WCR, and for WDE and WDT through the inverted mask, so a
write OR'd in WICR's other bits: its default WICT (0x04) is WCR's WDE.
WDT's lock also survived a reset. After Linux had set WDT and rebooted
the Onyx, U-Boot's own WCR write (0x39, WDE clear) became WDE set with
WT 0, an immediate timeout, and every boot reset itself at U-Boot.

Restore the locked fields from WCR with their own masks, and clear the
WDT lock on reset as the other locks are.
---
 hw/watchdog/wdt_imx2.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/hw/watchdog/wdt_imx2.c b/hw/watchdog/wdt_imx2.c
index 2e69c10..31f254d 100644
--- a/hw/watchdog/wdt_imx2.c
+++ b/hw/watchdog/wdt_imx2.c
@@ -93,6 +93,7 @@ static void imx2_wdt_reset(DeviceState *dev)
     s->wicr_locked = false;
     s->wcr_locked = false;
     s->wcr_wde_locked = false;
+    s->wcr_wdt_locked = false;
 
     s->wcr = IMX2_WDT_WCR_WDA | IMX2_WDT_WCR_SRS;
     s->wsr = 0;
@@ -188,20 +189,21 @@ static void imx2_wdt_write(void *opaque, hwaddr addr,
 
     switch (addr) {
     case IMX2_WDT_WCR:
+        /* Write-once fields keep what WCR holds, not WICR. */
         if (s->wcr_locked) {
             value &= ~IMX2_WDT_WCR_LOCK_MASK;
-            value |= (s->wicr & IMX2_WDT_WCR_LOCK_MASK);
+            value |= (s->wcr & IMX2_WDT_WCR_LOCK_MASK);
         }
         s->wcr_locked = true;
         if (s->wcr_wde_locked) {
             value &= ~IMX2_WDT_WCR_WDE;
-            value |= (s->wicr & ~IMX2_WDT_WCR_WDE);
+            value |= (s->wcr & IMX2_WDT_WCR_WDE);
         } else if (value & IMX2_WDT_WCR_WDE) {
             s->wcr_wde_locked = true;
         }
         if (s->wcr_wdt_locked) {
             value &= ~IMX2_WDT_WCR_WDT;
-            value |= (s->wicr & ~IMX2_WDT_WCR_WDT);
+            value |= (s->wcr & IMX2_WDT_WCR_WDT);
         } else if (value & IMX2_WDT_WCR_WDT) {
             s->wcr_wdt_locked = true;
         }

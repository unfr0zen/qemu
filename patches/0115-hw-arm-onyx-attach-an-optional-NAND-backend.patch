From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: will <will-tm@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:00:00 -0500
Subject: [PATCH] hw/arm: onyx: attach an optional NAND backend

Bind the named nand backend to GPMI before realizing the SoC, allowing
user-supplied logical NAND images while retaining erased NAND without
a backend.
---
diff --git a/hw/arm/onyx.c b/hw/arm/onyx.c
--- a/hw/arm/onyx.c
+++ b/hw/arm/onyx.c
@@ -11,6 +11,8 @@
 #include "hw/arm/fsl-imx6ul.h"
 #include "hw/arm/machines-qom.h"
 #include "hw/core/boards.h"
+#include "hw/core/qdev-properties.h"
+#include "system/block-backend-global-state.h"
 #include "system/reset.h"
 #include "system/qtest.h"
 
@@ -59,6 +61,7 @@
 static void onyx_init(MachineState *machine)
 {
     DeviceState *soc;
+    BlockBackend *nand = blk_by_name("nand");
     uint8_t *fuses;
 
     if (machine->ram_size != ONYX_RAM_SIZE) {
@@ -67,6 +70,10 @@
     }
     soc = qdev_new(TYPE_FSL_IMX6UL);
     object_property_add_child(OBJECT(machine), "soc", OBJECT(soc));
+    if (nand) {
+        qdev_prop_set_drive_err(DEVICE(&FSL_IMX6UL(soc)->gpmi), "drive", nand,
+                                &error_fatal);
+    }
     qdev_realize_and_unref(soc, NULL, &error_fatal);
     /* Synthetic identity, closed security configuration and thermal trim. */
     fuses = memory_region_get_ram_ptr(&FSL_IMX6UL(soc)->ocotp);
